#!/usr/bin/env bash
# This Mac's hardware as JSON for the launcher's Hardware pane (Super+Ctrl+H): model, board identifiers, serial, kernel,
# boot chain and firmware, CPU cluster clocks, GPU load, USB-C ports and the USB devices behind them, sensors, SEP /
# Touch ID, Wi-Fi chip, sleep statistics. What other panes own stays out (power rails: Battery, fans: Temperatures,
# SSD: Storage, OS / chip / memory: Dashboard); the kernel is the one wanted overlap (it heads the boot chain here).
# sysfs / procfs / device tree only, as the user (no root).
#
#   asahi-hardware            everything (the pane, once per open)
#   asahi-hardware --live     CPU clocks, GPU, ports, sensors (the pane, every 2 s)
#
# ASAHI_SYS_ROOT: fake / for tests.

set -uo pipefail
R=${ASAHI_SYS_ROOT:-}

rd() { local v; [ -r "$R$1" ] && v=$(tr -d '\0' <"$R$1") && printf '%s' "${v%"${v##*[![:space:]]}"}"; }

usb_scan() {   # every USB device that is no hub: [{ctl, name, mbps}], ctl = the controller it hangs on ("702280000.usb")
  local d cls name speed ctl i=0 devs=() paths=()
  for d in "$R"/sys/bus/usb/devices/[0-9]*-[0-9]*; do
    case ${d##*/} in *:*) continue ;; esac
    cls=""
    read -r cls 2>/dev/null <"$d/bDeviceClass" || continue
    if [ "$cls" != 09 ]; then devs+=("$d"); fi
  done
  if [ ${#devs[@]} -gt 0 ]; then mapfile -t paths < <(readlink -f "${devs[@]}"); fi   # one fork for all
  for d in "${devs[@]}"; do
    ctl=${paths[i]%%.usb/*} name="" speed=""
    if [ "$ctl" != "${paths[i]}" ]; then
      read -r name 2>/dev/null <"$d/product" || name="$(rd "${d#"$R"}/idVendor"):$(rd "${d#"$R"}/idProduct")"
      read -r speed 2>/dev/null <"$d/speed" || true
      printf '%s\t%s\t%s\n' "${ctl##*/}.usb" "$name" "$speed"
    fi
    i=$((i + 1))
  done | jq -Rsc 'split("\n") | map(select(. != "") | split("\t") | {ctl: .[0], name: .[1], mbps: (.[2] | tonumber? // null)})'
}

ports() {
  local p n label partner vendor dp=false a id ctl s usb
  usb=$(usb_scan)
  for p in "$R"/sys/class/typec/port[0-9]; do
    [ -e "$p" ] || continue
    n=${p##*/}
    label=$(rd "/sys/class/typec/$n/device/of_node/connector/label")   # none: MagSafe (DT hpm5 usb-pd@3a)
    partner="" vendor="" dp=false ctl=""
    # The port's USB controller (a device link on the port): its devices are what hangs off this port.
    for s in "$p"/supplier:platform:*.usb; do
      if [ -e "$s" ]; then ctl=${s##*:}; fi
    done
    if [ -d "$R/sys/class/typec/$n-partner" ]; then
      partner=yes
      id=$(rd "/sys/class/typec/$n-partner/identity/id_header")
      [ -n "$id" ] && vendor=$(printf '%04x' $((id & 0xffff)))
      for a in "$R/sys/class/typec/$n-partner/$n-partner".*; do
        [ "$(rd "${a#"$R"}/svid")" = ff01 ] && [ "$(rd "${a#"$R"}/active")" = yes ] && dp=true
      done
    fi
    jq -nc --arg port "$n" --arg name "${label:-MagSafe}" --arg power "$(rd "/sys/class/typec/$n/power_role")" \
      --arg partner "$partner" --arg vendor "$vendor" \
      --arg vname "$([ -n "$vendor" ] && sed -n "s/^$vendor  //p" /usr/share/hwdata/usb.ids 2>/dev/null | head -n 1)" \
      --arg mode "$(rd "/sys/class/typec/$n/power_operation_mode")" --arg data "$(rd "/sys/class/typec/$n/data_role")" \
      --arg ctl "$ctl" --argjson usb "$usb" --argjson dp "$dp" '
      def picked: capture("\\[(?<r>[a-z]+)\\]").r // .;
      {port: $port, name: $name, power: ($power | picked),
        partner: ($partner == "yes"), vendor: $vendor, vendor_name: $vname, dp: $dp,
        pd: ($mode == "usb_power_delivery"), data: (if $ctl == "" then "" else ($data | picked) end),
        devices: ($usb | map(select(.ctl == $ctl and $ctl != "") | del(.ctl)))}'
  done | jq -sc .
}

gpu() {
  local s; s=$(cat "$R"/sys/class/drm/card*/device/agx_stats 2>/dev/null)
  jq -nc --arg s "$s" '($s | split("\n") | map(split(" ") | select(length == 2) | {(.[0]): (.[1] | tonumber? // .)}) | add // {})
    | {util: .util1, mhz: ((.requested_frequency_hz // 0) / 1e6 | floor), mw: .power_mw}'
}

iio() {   # IIO device by name: the index is not stable across boots
  local d
  for d in "$R"/sys/bus/iio/devices/iio:device*; do
    [ "$(rd "${d#"$R"}/name")" = "$1" ] && echo "${d#"$R"}" && return
  done
}

live() {
  local cur=() f als las khz
  # One clock per cpufreq policy, in cpus()' order (kHz -> MHz; null keeps the two lists aligned).
  for f in "$R"/sys/devices/system/cpu/cpufreq/policy*; do
    [ -e "$f" ] || continue
    if read -r khz 2>/dev/null <"$f/scaling_cur_freq"; then cur+=("$((khz / 1000))"); else cur+=(null); fi
  done
  als=$(iio aop-sensors-als) las=$(iio aop-sensors-las)
  jq -nc --arg lux "$(rd "$als/in_illuminance_input")" --arg kelvin "$(rd "$als/in_colortemp_input")" \
    --arg lid "$(rd "$las/in_angl_raw")" --arg panel "$(rd /sys/class/backlight/apple-panel-bl/brightness)" \
    --arg panelmax "$(rd /sys/class/backlight/apple-panel-bl/max_brightness)" --arg kbd "$(rd /sys/class/leds/kbd_backlight/brightness)" \
    --arg kbdmax "$(rd /sys/class/leds/kbd_backlight/max_brightness)" --arg cur "${cur[*]:-}" \
    --argjson gpu "$(gpu)" --argjson ports "$(ports)" '
    def num: tonumber? // null;
    def pct(a; b): if (a | num) != null and ((b | num) // 0) > 0 then ((a | num) * 100 / (b | num) | round) else null end;
    {cpu_mhz: ($cur | split(" ") | map(select(. != "") | num)), gpu: $gpu, ports: $ports,
     sensors: {lux: ($lux | num | if . then round else null end), kelvin: ($kelvin | num | if . then round else null end),
               lid_deg: ($lid | num), panel: pct($panel; $panelmax), kbd: pct($kbd; $kbdmax)}}'
}

if [ "${1:-}" = --live ]; then live; exit; fi

cpus() {   # cpufreq policies → clusters: [{cores, max_mhz}]
  local p
  for p in "$R"/sys/devices/system/cpu/cpufreq/policy*; do
    [ -e "$p" ] || continue
    jq -nc --arg cpus "$(rd "${p#"$R"}/related_cpus")" --arg max "$(rd "${p#"$R"}/cpuinfo_max_freq")" \
      '{cores: ($cpus | split(" ") | length), max_mhz: (($max | tonumber? // 0) / 1000 | floor)}'
  done | jq -sc .
}
# GPU core count: only the kernel log says it (asahi/aurora drm), once per boot.
gcache="${XDG_RUNTIME_DIR:-/tmp}/asahi-hardware-gpu-cores"
[ -s "$gcache" ] || journalctl -k -b -g 'Active cores' --no-pager -o cat 2>/dev/null | sed -n 's/.*Active cores: \([0-9]*\).*/\1/p' |
  head -n 1 >"$gcache"
# The kernel's suspend counters (since boot) and the last sleep asahi-idle logged:
# "<date> <time> slept 2h8m[ on AC], used 3.81 Wh (1.78 W)" | "…, gained 0.42 Wh".
sleep_stats() {
  local line
  line=$(grep ' slept ' "$R${XDG_STATE_HOME:-$HOME/.local/state}/asahi/idle.log" 2>/dev/null | tail -n 1)
  jq -nc --arg ok "$(rd /sys/power/suspend_stats/success)" --arg failed "$(rd /sys/power/suspend_stats/fail)" \
    --arg errno "$(rd /sys/power/suspend_stats/last_failed_errno)" --arg line "$line" '
    def num: tonumber? // null;
    {ok: ($ok | num), failed: ($failed | num), last_errno: ($errno | num),
     last: (($line | capture("^(?<at>\\S+ \\S+) slept (?<h>[0-9]+)h(?<m>[0-9]+)m(?<ac> on AC)?, (used (?<wh>[0-9.]+) Wh \\((?<w>[0-9.]+) W\\)|gained (?<gain>-?[0-9.]+) Wh)")) // null
       | if . == null then null else {at, minutes: ((.h | tonumber) * 60 + (.m | tonumber)), ac: (.ac != null),
           used_wh: (.wh | num), w: (.w | num), gained_wh: (.gain | num)} end)}'
}
sep=/sys/devices/platform/soc/396400000.sep/diag
for d in "$R"/sys/devices/platform/soc/*.sep/diag; do [ -d "$d" ] && sep=${d#"$R"}; done
fingers=$(fprintd-list "${USER:-$(id -un)}" 2>/dev/null | grep -c ' - #')
pci() { local d; for d in "$R"/sys/bus/pci/devices/*; do [ "$(rd "${d#"$R"}/vendor"):$(rd "${d#"$R"}/device")" = "$1" ] && echo yes && return; done; }
wifi=""   # one chip for Wi-Fi and Bluetooth
[ "$(pci 0x14e4:0x4434)" = yes ] && wifi="BCM4388"
[ "$(pci 0x14e4:0x4433)" = yes ] && wifi="BCM4387"
wfw=$(ethtool -i wld0 2>/dev/null | sed -n 's/^firmware-version: //p')

jq -nc --argjson live "$(live)" --argjson clusters "$(cpus)" --arg model "$(rd /proc/device-tree/model)" \
  --arg sku "$(rd /sys/class/dmi/id/product_sku)" --arg board "$(rd /sys/class/dmi/id/board_name)" \
  --arg serial "$(rd /proc/device-tree/serial-number)" --argjson sleep "$(sleep_stats)" \
  --arg governor "$(rd /sys/devices/system/cpu/cpufreq/policy0/scaling_governor)" \
  --arg part "$(rd /sys/class/dmi/id/product_version)" --arg gcores "$(cat "$gcache" 2>/dev/null)" \
  --arg page "$(getconf PAGESIZE)" --arg kernel "$(uname -r)" \
  --arg s1 "$(rd /proc/device-tree/chosen/asahi,m1n1-stage1-version)" --arg s2 "$(rd /proc/device-tree/chosen/asahi,m1n1-stage2-version)" \
  --arg uboot "$(rd /proc/device-tree/chosen/u-boot,version)" --arg sysfw "$(rd /proc/device-tree/chosen/asahi,system-fw-version)" \
  --arg osfw "$(rd /proc/device-tree/chosen/asahi,os-fw-version)" --arg touchid "$(rd "$sep/touchid")" \
  --arg sensor "$(rd "$sep/sensor")" --arg keystore "$(rd "$sep/keystore")" --arg guard "$(rd "$sep/xart_guard")" \
  --arg refusals "$(rd "$sep/xart_guard_refusals")" --arg fingers "$fingers" --arg wifi "$wifi" --arg wfw "$wfw" \
  --arg cam "$(for v in "$R"/sys/class/video4linux/video*; do rd "${v#"$R"}/name"; echo; done | grep -m1 isp)" '
  def num: tonumber? // null;
  $live + {
    model: $model, sku: $sku, board: $board, part: $part, serial: $serial,
    cpu: {clusters: $clusters, governor: $governor}, gpu: ($live.gpu + {cores: ($gcores | num)}),
    sleep: $sleep, kernel: $kernel, page_kb: (($page | num // 4096) / 1024),
    boot: {stage1: $s1, stage2: $s2, uboot: $uboot, system_fw: $sysfw, os_fw: $osfw},
    sep: {touchid: $touchid, sensor: $sensor, keystore: $keystore, xart_guard: ($guard | num), refusals: ($refusals | num),
          fingers: ($fingers | num)},
    radios: {wifi: $wifi, wifi_fw: $wfw}, camera: $cam}'
