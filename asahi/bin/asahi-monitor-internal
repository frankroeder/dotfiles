#!/usr/bin/env bash
# Enable, disable, toggle, or reconcile the internal laptop panel.
# clamshell: lid closed + external → disable eDP-1 so workspaces leave the
# black panel. Lid closed without an external → DPMS + idle-brightness (no lock).
# Lid open, or last external unplugged while closed → restore the panel.
#
# lid / external are probes (exit 0/1) used by clamshell and tests.

set -euo pipefail

bin="$(cd "$(dirname "$0")" && pwd)"
state_dir="${ASAHI_CLAMSHELL_DIR:-${XDG_RUNTIME_DIR:-/tmp}/asahi-clamshell}"
spec_file="$state_dir/edp-spec"
action="${1:-}"

usage() {
  echo "usage: $0 <clamshell|on|off|toggle|status|lid|external>" >&2
  exit 2
}

lid_closed() {
  if [ -n "${ASAHI_LID_CLOSED:-}" ]; then
    case "${ASAHI_LID_CLOSED}" in
    1 | true | yes) return 0 ;;
    *) return 1 ;;
    esac
  fi
  if [ -n "${ASAHI_LID_BUSCTL:-}" ]; then
    case "${ASAHI_LID_BUSCTL}" in
    "b true") return 0 ;;
    "b false") return 1 ;;
    esac
    return 1
  fi
  if command -v busctl >/dev/null 2>&1; then
    local lid_state
    lid_state="$(busctl get-property org.freedesktop.login1 \
      /org/freedesktop/login1 org.freedesktop.login1.Manager LidClosed 2>/dev/null || true)"
    case "$lid_state" in
    "b true") return 0 ;;
    "b false") return 1 ;;
    esac
  fi
  return 1
}

external_connected() {
  local drm_path status
  drm_path="${ASAHI_DRM_PATH:-/sys/class/drm}"
  for status in "$drm_path"/card*-*/status; do
    [ -e "$status" ] || continue
    case "$status" in
    *-eDP-*/status | *-LVDS-*/status | *-DSI-*/status) continue ;;
    esac
    [ "$(tr -d '[:space:]' <"$status")" = "connected" ] && return 0
  done
  return 1
}

internal_name() {
  local name
  name="$(hyprctl monitors all -j 2>/dev/null | jq -r '[.[] | select(.name | test("^eDP"))][0].name // empty')"
  if [ -n "$name" ]; then
    printf '%s\n' "$name"
    return 0
  fi
  printf 'eDP-1\n'
}

safe_name() {
  [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]]
}

current_spec() {
  local name="$1"
  hyprctl monitors all -j 2>/dev/null | jq -r --arg n "$name" '
    .[] | select(.name == $n) |
    "\(.name),\(.width)x\(.height)@\(.refreshRate),\(.x)x\(.y),\(.scale)"
  ' | head -1
}

is_disabled() {
  local name="$1"
  hyprctl monitors all -j 2>/dev/null | jq -e --arg n "$name" \
    '.[] | select(.name == $n and .disabled == true)' >/dev/null
}

has_external_active() {
  hyprctl monitors -j 2>/dev/null | jq -e \
    '[.[] | select((.name | test("^eDP") | not) and .disabled != true)] | length > 0' >/dev/null
}

save_spec() {
  local name="$1" spec
  spec="$(current_spec "$name")"
  [ -n "$spec" ] || spec="${ASAHI_INTERNAL_MONITOR_SPEC:-eDP-1,3024x1890@120.000,0x0,1.5}"
  mkdir -p "$state_dir"
  printf '%s\n' "$spec" >"$spec_file"
}

enable_internal() {
  local name="$1" spec
  if [ -s "$spec_file" ]; then
    spec="$(tr -d '\n' <"$spec_file")"
  else
    spec="$(current_spec "$name")"
    [ -n "$spec" ] || spec="${ASAHI_INTERNAL_MONITOR_SPEC:-eDP-1,3024x1890@120.000,0x0,1.5}"
  fi
  hyprctl keyword monitor "$spec" >/dev/null 2>&1 || true
  rm -f "$spec_file"
}

disable_internal() {
  local name="$1"
  if ! has_external_active && ! external_connected; then
    echo "refusing to disable the only display" >&2
    return 1
  fi
  if ! is_disabled "$name"; then
    save_spec "$name"
  fi
  hyprctl keyword monitor "${name},disable" >/dev/null 2>&1 || true
}

dpms_internal() {
  hyprctl dispatch dpms "$1" "$2" >/dev/null 2>&1 || true
}

apply_clamshell() {
  local name="$1"
  if lid_closed && external_connected; then
    disable_internal "$name" || true
    "$bin/asahi-idle-brightness" off || true
    return 0
  fi

  if lid_closed; then
    if is_disabled "$name"; then
      enable_internal "$name"
    fi
    "$bin/asahi-idle-brightness" off || true
    dpms_internal off "$name"
    return 0
  fi

  if is_disabled "$name" || [ -s "$spec_file" ]; then
    enable_internal "$name"
  fi
  dpms_internal on "$name"
  "$bin/asahi-idle-brightness" restore || true
}

case "$action" in
lid | lid-closed)
  lid_closed
  ;;
external)
  external_connected
  ;;
clamshell | on | off | toggle | status)
  name="$(internal_name)"
  if ! safe_name "$name"; then
    echo "refusing unsafe internal monitor name: $name" >&2
    exit 1
  fi
  case "$action" in
  clamshell) apply_clamshell "$name" ;;
  on)
    enable_internal "$name"
    dpms_internal on "$name"
    "$bin/asahi-idle-brightness" restore || true
    ;;
  off) disable_internal "$name" ;;
  toggle)
    if is_disabled "$name"; then
      enable_internal "$name"
      dpms_internal on "$name"
      "$bin/asahi-idle-brightness" restore || true
    else
      disable_internal "$name"
    fi
    ;;
  status)
    if is_disabled "$name"; then
      echo "disabled $name"
    else
      echo "enabled $name"
    fi
    ;;
  esac
  ;;
*)
  usage
  ;;
esac
