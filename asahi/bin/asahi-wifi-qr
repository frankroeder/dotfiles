#!/usr/bin/env bash
# Render a join-this-network QR for the active Wi-Fi and print the PNG path.
# Payload: WIFI:T:<WPA|WEP|nopass>;S:<ssid>;P:<psk>;;

set -euo pipefail

# UUID, not NAME: -t escapes ':' in names, so splitting on ':' broke on "Cafe: 5G".
uuid=$(nmcli -t -f TYPE,UUID connection show --active | awk -F: '$1 == "802-11-wireless" { print $2; exit }' || true)
if [ -z "$uuid" ]; then
  echo "asahi-wifi-qr: no active Wi-Fi connection" >&2
  exit 1
fi
name=$(nmcli -e no -g connection.id connection show uuid "$uuid")

esc() { printf '%s' "$1" | sed 's/[\\;,":]/\\&/g'; }

# -e no: plain -g escapes ":" and backslashes itself, and esc() would escape them twice.
ssid=$(nmcli -e no -g 802-11-wireless.ssid connection show uuid "$uuid")
keymgmt=$(nmcli -g 802-11-wireless-security.key-mgmt connection show uuid "$uuid" || true)
case "$keymgmt" in
  wpa-psk | sae) auth=WPA ;;
  wpa-eap | wpa-eap-suite-b-192 | ieee8021x)
    echo "asahi-wifi-qr: $name has no shareable PSK ($keymgmt)" >&2
    exit 1
    ;;
  none) auth=WEP ;;
  *) auth=nopass ;;
esac
psk=""
if [ "$auth" = WPA ]; then
  psk=$(nmcli -s -e no -g 802-11-wireless-security.psk connection show uuid "$uuid" || true)
fi

out="${XDG_RUNTIME_DIR:-/tmp}/asahi-wifi-qr.png"
umask 077
printf '%s' "WIFI:T:$auth;S:$(esc "$ssid");P:$(esc "$psk");;" | qrencode -o "$out" -s 8 -m 2 -l M
chmod 600 "$out"
printf '%s\n' "$out"
