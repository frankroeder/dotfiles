#!/usr/bin/env bash
# Night light via hyprsunset (menu-only: Launcher > Actions). On: the last temperature (else hyprsunset.conf's),
# off = identity. warmer / cooler [n] step it by n × 250 K while on (the bar chip's wheel, one run per gesture; ideas:
# dhrruvsharma, serpantinum). One run at a time (flock): two at once read the same state and set their own
# temperature in turns — the screen flickered and each run's check saw the other's value ("Night light failed").

set -euo pipefail

HERE="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
STATE_DIR="${ASAHI_STATE_DIR:-$HOME/.local/state/asahi}"
STATE_FILE="${ASAHI_NIGHTLIGHT_STATE:-$STATE_DIR/nightlight.json}"
CONF="${ASAHI_NIGHTLIGHT_CONF:-$HOME/.config/hypr/hyprsunset.conf}"
TRIES="${ASAHI_NIGHTLIGHT_TRIES:-10}"
SETTLE="${ASAHI_NIGHTLIGHT_SETTLE:-0.2}"

mkdir -p "$STATE_DIR"
exec 9>"$STATE_DIR/nightlight.lock"
flock 9

conf_on_temp() {
  local conf="$CONF" t=""
  if [[ ! -f $conf ]]; then
    conf="$HERE/../hypr/hyprsunset.conf"
  fi
  if [[ -f $conf ]]; then
    t=$(sed -n 's/.*temperature[[:space:]]*=[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$conf")
    t=${t##*$'\n'}
  fi
  if [[ $t =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$t"
  else
    printf '%s\n' 1500
  fi
}

ON_TEMP="$(conf_on_temp)"

read_on() {
  if [[ -f $STATE_FILE ]]; then
    jq -r '.on // false' "$STATE_FILE" 2>/dev/null || echo false
  else
    echo false
  fi
}

# The temperature last set (kept while off), else the conf's.
read_temp() {
  local t=""
  if [[ -f $STATE_FILE ]]; then t=$(jq -r '.temperature // empty' "$STATE_FILE" 2>/dev/null || true); fi
  if [[ $t =~ ^[0-9]+$ ]]; then printf '%s\n' "$t"; else printf '%s\n' "$ON_TEMP"; fi
}
write_state() {
  local on=$1 temp=$2
  jq -cn --argjson on "$on" --argjson temp "$temp" '{on:$on,temperature:$temp}' >"$STATE_FILE"
}

current_temp() {
  local output
  output=$(hyprctl hyprsunset temperature 2>/dev/null) || return
  if [[ $output =~ ([0-9]+) ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
  else
    return 1
  fi
}

ensure_daemon() {
  if pgrep -x hyprsunset >/dev/null 2>&1; then
    return 0
  fi
  "$HERE/asahi-launch" hyprsunset >/dev/null 2>&1 &
}

apply_temperature() {
  local target="$1" i=0 live
  ensure_daemon || true
  # Fresh hyprsunset applies its default at the end of boot and overwrites
  # anything set before then — resend until it sticks.
  while [ "$i" -lt "$TRIES" ]; do
    i=$((i + 1))
    hyprctl hyprsunset temperature "$target" >/dev/null 2>&1 || true
    sleep "$SETTLE"
    live="$(current_temp || true)"
    if [ "$live" = "$target" ]; then
      return 0
    fi
  done
  return 1
}

set_identity() {
  ensure_daemon || true
  hyprctl hyprsunset identity >/dev/null 2>&1 || true
  write_state false "$(read_temp)"
}

set_temperature() {
  local temp=$1
  if ! apply_temperature "$temp"; then
    notify-send -a nightlight -t 2000 "Night light failed" "hyprsunset did not take the temperature" || true
    return 1
  fi
  write_state true "$temp"
}

case "${1:-toggle}" in
  toggle)
    if [[ $(read_on) == "true" ]]; then
      set_identity
    else
      set_temperature "$(read_temp)"
    fi
    ;;
  warmer | cooler)
    if [[ $(read_on) != "true" ]]; then exit 0; fi
    n=${2:-1}
    [[ $n =~ ^[1-9][0-9]{0,1}$ ]] || n=1
    was=$(read_temp)
    if [ "$1" = warmer ]; then t=$((was - 250 * n)); else t=$((was + 250 * n)); fi
    if ((t < 1000)); then t=1000; fi
    if ((t > 6000)); then t=6000; fi
    if [ "$t" = "$was" ]; then exit 0; fi   # at the limit already
    set_temperature "$t"
    ;;
  *)
    echo "usage: $0 [toggle|warmer [n]|cooler [n]]" >&2
    exit 2
    ;;
esac
