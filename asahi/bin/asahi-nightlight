#!/usr/bin/env bash
# Night light via hyprsunset. Super+Ctrl+N: temperature from hyprsunset.conf, off = identity.

set -euo pipefail

HERE="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
STATE_DIR="${ASAHI_STATE_DIR:-$HOME/.local/state/asahi}"
STATE_FILE="${ASAHI_NIGHTLIGHT_STATE:-$STATE_DIR/nightlight.json}"
CONF="${ASAHI_NIGHTLIGHT_CONF:-$HOME/.config/hypr/hyprsunset.conf}"
TRIES="${ASAHI_NIGHTLIGHT_TRIES:-10}"
SETTLE="${ASAHI_NIGHTLIGHT_SETTLE:-0.2}"

mkdir -p "$STATE_DIR"

conf_on_temp() {
  local conf="$CONF" t=""
  if [[ ! -f $conf ]]; then
    conf="$HERE/../hypr/hyprsunset.conf"
  fi
  if [[ -f $conf ]]; then
    t=$(sed -n 's/.*temperature[[:space:]]*=[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$conf")
    t=${t##*$'\n'}
  fi
  if [[ $t =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$t"
  else
    printf '%s\n' 1500
  fi
}

ON_TEMP="${ASAHI_NIGHTLIGHT_TEMP:-$(conf_on_temp)}"

read_state() {
  if [[ -f $STATE_FILE ]]; then
    jq -r '.temperature // empty' "$STATE_FILE" 2>/dev/null || true
  fi
}

read_on() {
  if [[ -f $STATE_FILE ]]; then
    jq -r '.on // false' "$STATE_FILE" 2>/dev/null || echo false
  else
    echo false
  fi
}

write_state() {
  local on=$1 temp=$2
  jq -cn --argjson on "$on" --argjson temp "$temp" '{on:$on,temperature:$temp}' >"$STATE_FILE"
}

current_temp() {
  local output
  output=$(hyprctl hyprsunset temperature 2>/dev/null) || return
  if [[ $output =~ ([0-9]+) ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
  else
    return 1
  fi
}

ensure_daemon() {
  if pgrep -x hyprsunset >/dev/null 2>&1; then
    return 0
  fi
  "$HERE/asahi-launch" hyprsunset >/dev/null 2>&1 &
}

apply_temperature() {
  local target="$1" i=0 live
  ensure_daemon || true
  # Fresh hyprsunset applies its default at the end of boot and overwrites
  # anything set before then — resend until it sticks.
  while [ "$i" -lt "$TRIES" ]; do
    i=$((i + 1))
    hyprctl hyprsunset temperature "$target" >/dev/null 2>&1 || true
    sleep "$SETTLE"
    live="$(current_temp || true)"
    if [ "$live" = "$target" ]; then
      return 0
    fi
  done
  return 1
}

set_identity() {
  ensure_daemon || true
  hyprctl hyprsunset identity >/dev/null 2>&1 || true
  write_state false "$ON_TEMP"
  notify-send -a nightlight -t 1200 "Night light off"
}

set_temperature() {
  local temp=$1
  apply_temperature "$temp" || true
  write_state true "$temp"
  notify-send -a nightlight -t 1200 "Night light ${temp}K"
}

cmd="${1:-toggle}"
arg="${2:-}"

case "$cmd" in
  toggle)
    if [[ $(read_on) == "true" ]]; then
      set_identity
    else
      set_temperature "$ON_TEMP"
    fi
    ;;
  on|warm)
    set_temperature "${arg:-$ON_TEMP}"
    ;;
  off|identity)
    set_identity
    ;;
  cooler)
    cur=$(read_state)
    if [[ -z $cur || ! $cur =~ ^[0-9]+$ ]]; then
      cur=$ON_TEMP
    fi
    set_temperature "$((cur + 500))"
    ;;
  warmer)
    cur=$(read_state)
    if [[ -z $cur || ! $cur =~ ^[0-9]+$ ]]; then
      cur=$ON_TEMP
    fi
    new=$((cur - 500))
    if [ "$new" -lt 1000 ]; then
      new=1000
    fi
    set_temperature "$new"
    ;;
  status)
    # identity does not change the reported K — state file is the on/off source.
    if [[ $(read_on) == "true" ]]; then
      live="$(current_temp || true)"
      if [[ ! $live =~ ^[0-9]+$ ]]; then
        live=$ON_TEMP
      fi
      jq -cn --argjson on true --argjson temp "$live" '{on:$on,temperature:$temp}'
    else
      jq -cn --argjson on false --argjson temp "$ON_TEMP" '{on:$on,temperature:$temp,identity:true}'
    fi
    ;;
  *)
    echo "usage: $0 [toggle|on [K]|off|warmer|cooler|status]" >&2
    exit 2
    ;;
esac
