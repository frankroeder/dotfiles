#!/usr/bin/env bash

set -euo pipefail

sound="/usr/share/sounds/freedesktop/stereo/message.oga"

[ -r "$sound" ] || exit 0

# mpv only when paplay fails (or times out).
timeout --kill-after=1s 3s paplay "$sound" >/dev/null 2>&1 && exit 0
timeout 3s mpv \
  --no-config \
  --no-video \
  --audio-display=no \
  --force-window=no \
  --keep-open=no \
  --idle=no \
  --loop-file=no \
  --length=2 \
  --really-quiet \
  --no-terminal \
  "$sound" >/dev/null 2>&1 || true
