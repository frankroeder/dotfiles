#!/usr/bin/env bash
set -euo pipefail

# Output JSON { "text": short display, "tooltip": multi-line details, "class": ..., "percentage": 0-100 }

# Prefer ethernet over wifi. Ignore tun/vpn/wireguard — those are overlay,
# not the underlay the bar icon should represent.
get_active() {
  local best_eth="" best_wifi="" line type rest state
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    rest=${line#*:}
    type=${rest%%:*}
    rest=${rest#*:}
    state=${rest%%:*}
    case "$state" in
      connected*) ;;
      *) continue ;;
    esac
    case "$type" in
      ethernet) [ -z "$best_eth" ] && best_eth=$line ;;
      wifi) [ -z "$best_wifi" ] && best_wifi=$line ;;
    esac
  done < <(nmcli -t -f DEVICE,TYPE,STATE,CONNECTION dev status 2>/dev/null || true)
  if [ -n "$best_eth" ]; then
    printf '%s\n' "$best_eth"
  elif [ -n "$best_wifi" ]; then
    printf '%s\n' "$best_wifi"
  fi
}

build_wifi_tooltip() {
  local dev="$1" conn="$2"
  local ssid sig ip gw bssid
  ssid=$(nmcli -g GENERAL.CONNECTION dev show "$dev" 2>/dev/null || echo "$conn")
  sig=$(nmcli -f IN-USE,SIGNAL dev wifi list --rescan no 2>/dev/null | awk '/^\*/ {print $2}' | head -1 || echo "0")
  [ -z "$sig" ] && sig=50
  ip=$(nmcli -g IP4.ADDRESS dev show "$dev" 2>/dev/null | head -1 || echo "")
  gw=$(nmcli -g IP4.GATEWAY dev show "$dev" 2>/dev/null | head -1 || echo "")
  bssid=$(nmcli -g 802-11-wireless.bssid dev show "$dev" 2>/dev/null || echo "")
  printf "Connected to %s\nSignal: %s%%\nInterface: %s\nIP: %s\nGateway: %s" "$ssid" "$sig" "$dev" "$ip" "$gw"
}

build_ethernet_tooltip() {
  local dev="$1" conn="$2"
  local ip gw
  ip=$(nmcli -g IP4.ADDRESS dev show "$dev" 2>/dev/null | head -1 || echo "")
  gw=$(nmcli -g IP4.GATEWAY dev show "$dev" 2>/dev/null | head -1 || echo "")
  printf "%s %s\n gw %s" "$dev" "${ip}" "${gw}"
}

vpn_name=""
vpn_kind=""
while IFS= read -r line; do
  [ -z "$line" ] && continue
  type=$(printf '%s' "$line" | awk -F: '{print $(NF-1)}')
  active=$(printf '%s' "$line" | awk -F: '{print $NF}')
  name=${line%:*}
  name=${name%:*}
  name=${name//\\:/:}
  if [ "$active" = "yes" ] && { [ "$type" = "vpn" ] || [ "$type" = "wireguard" ]; }; then
    vpn_name=$name
    vpn_kind=$type
    break
  fi
done <<EOF
$(nmcli -t -f NAME,TYPE,ACTIVE connection show 2>/dev/null || true)
EOF

if [ -z "$vpn_name" ]; then
  tun_line=$(nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device status 2>/dev/null | awk -F: '$2=="tun" && $3 ~ /^connected/ {print $1 ":" $4; exit}' || true)
  if [ -n "$tun_line" ]; then
    vpn_name=${tun_line#*:}
    [ -z "$vpn_name" ] && vpn_name=${tun_line%%:*}
    vpn_kind="external"
  fi
fi

vpn_tooltip=""
if [ -n "$vpn_name" ]; then
  if [ "$vpn_kind" = "external" ]; then
    vpn_tooltip=$(printf 'VPN: %s (external tunnel)' "$vpn_name")
  else
    vpn_tooltip=$(printf 'VPN: %s' "$vpn_name")
  fi
fi

line=$(get_active)
if [ -z "$line" ]; then
  jq -cn \
    --arg text "󰤮" \
    --arg tooltip "$( [ -n "$vpn_tooltip" ] && printf '%s' "$vpn_tooltip" || printf 'Disconnected' )" \
    --arg class "disconnected" \
    --arg device "" \
    --arg vpn "$vpn_name" \
    --arg vpnKind "$vpn_kind" \
    --argjson percentage 0 \
    --argjson vpnUp "$([ -n "$vpn_name" ] && echo true || echo false)" \
    '{text:$text, tooltip:$tooltip, class:$class, device:$device, percentage:$percentage, vpn:$vpnUp, vpnName:$vpn, vpnKind:$vpnKind}'
  exit 0
fi

IFS=: read -r dev type state conn <<<"$line"

if [ "$type" = "wifi" ]; then
  # Try to get signal strength more reliably
  sig=$(nmcli -t -f IN-USE,SIGNAL dev wifi list --rescan no 2>/dev/null | awk -F: '/^\*/ {print $2; exit}' || echo 0)
  [ -z "$sig" ] && sig=50

  if [ "$sig" -ge 75 ]; then icon="󰤨"
  elif [ "$sig" -ge 50 ]; then icon="󰤥"
  elif [ "$sig" -ge 25 ]; then icon="󰤢"
  else icon="󰤟"
  fi

  tooltip=$(build_wifi_tooltip "$dev" "$conn")
  class="connected"
  pct=$sig
  # Bar only shows the wifi symbol (no text label)
  text="$icon"
elif [ "$type" = "ethernet" ]; then
  icon="󰀂"
  tooltip=$(build_ethernet_tooltip "$dev" "$conn")
  class="connected"
  pct=100
  text="$icon"
else
  # Disconnected or no active connection → proper wifi disconnected symbol
  icon="󰤮"
  tooltip="Disconnected"
  class="disconnected"
  pct=0
  text="$icon"
fi

if [ -n "$vpn_tooltip" ]; then
  tooltip=$(printf '%s\n%s' "$tooltip" "$vpn_tooltip")
fi

jq -cn \
  --arg text "$text" \
  --arg tooltip "$tooltip" \
  --arg class "$class" \
  --arg device "$dev" \
  --arg vpn "$vpn_name" \
  --arg vpnKind "$vpn_kind" \
  --argjson percentage "${pct:-0}" \
  --argjson vpnUp "$([ -n "$vpn_name" ] && echo true || echo false)" \
  '{text:$text, tooltip:$tooltip, class:$class, device:$device, percentage:$percentage, vpn:$vpnUp, vpnName:$vpn, vpnKind:$vpnKind}'
