#!/usr/bin/env bash
set -euo pipefail

# Output JSON { "text": bar glyph, "tooltip": multi-line details, "name": connection, "vpn", "vpnName", "vpnSince", "connectivity" }
# --bar: no Wi-Fi tooltip (the bar chip shows only the icon).

fmt_age() {
  local sec="${1:-0}"
  [ "$sec" -lt 0 ] && sec=0
  local d=$((sec / 86400))
  local h=$(((sec % 86400) / 3600))
  local m=$(((sec % 3600) / 60))
  if [ "$d" -gt 0 ]; then
    printf '%dd %dh' "$d" "$h"
  elif [ "$h" -gt 0 ]; then
    printf '%dh %dm' "$h" "$m"
  else
    printf '%dm' "$m"
  fi
}

# Centre frequency (MHz) → channel, the kernel's table. 0 when it is not a 2.4 / 5 / 6 GHz channel.
wifi_channel() {
  local f="${1:-0}"
  f=${f%%.*}  # iw prints "freq: 5320.0"
  case "$f" in
    ''|*[!0-9]*) printf '0'; return ;;
  esac
  if [ "$f" -eq 2484 ]; then printf '14'
  elif [ "$f" -ge 2412 ] && [ "$f" -lt 2484 ]; then printf '%d' $(( (f - 2407) / 5 ))
  elif [ "$f" -ge 4910 ] && [ "$f" -le 4980 ]; then printf '%d' $(( (f - 4000) / 5 ))
  elif [ "$f" -ge 5000 ] && [ "$f" -lt 5925 ]; then printf '%d' $(( (f - 5000) / 5 ))
  elif [ "$f" -eq 5935 ]; then printf '2'
  elif [ "$f" -ge 5955 ] && [ "$f" -le 7115 ]; then printf '%d' $(( (f - 5950) / 5 ))
  else printf '0'
  fi
}

bar=false
if [ "${1:-}" = "--bar" ]; then bar=true; fi

if [ "${1:-}" = "--fmt-age" ]; then
  fmt_age "${2:-0}"
  printf '\n'
  exit 0
fi
if [ "${1:-}" = "--fmt-channel" ]; then
  wifi_channel "${2:-0}"
  printf '\n'
  exit 0
fi

# One `dev status` for every lookup below.
dev_status="$(nmcli -t -f DEVICE,TYPE,STATE,CONNECTION dev status 2>/dev/null || true)"

# Cached NM state (no re-check: instant, no probe traffic). Strict set: anything else is unknown.
connectivity=$(nmcli -t -f CONNECTIVITY general 2>/dev/null || echo unknown)
case "$connectivity" in full|limited|portal|none|unknown) ;; *) connectivity=unknown ;; esac

# The bar prefers ethernet over wifi; the pane (no --bar) wants the Wi-Fi card's details whenever Wi-Fi is
# up. Ignore tun/vpn/wireguard — those are overlay, not the underlay the bar icon should represent.
get_active() {
  local best_eth="" best_wifi="" line type rest state
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    rest=${line#*:}
    type=${rest%%:*}
    rest=${rest#*:}
    state=${rest%%:*}
    case "$state" in
      connected*) ;;
      *) continue ;;
    esac
    case "$type" in
      ethernet) [ -z "$best_eth" ] && best_eth=$line ;;
      wifi) [ -z "$best_wifi" ] && best_wifi=$line ;;
    esac
  done <<<"$dev_status"
  if [ -n "$best_eth" ] && { $bar || [ -z "$best_wifi" ]; }; then
    printf '%s\n' "$best_eth"
  elif [ -n "$best_wifi" ]; then
    printf '%s\n' "$best_wifi"
  fi
}

build_wifi_tooltip() {
  local dev="$1" conn="$2" sig="$3"
  local ssid ip gw link bssid="" freq="" bitrate="" dbm="" channel=""
  ssid=$(nmcli -g GENERAL.CONNECTION dev show "$dev" 2>/dev/null || echo "$conn")
  ip=$(nmcli -g IP4.ADDRESS dev show "$dev" 2>/dev/null | head -1 || echo "")
  gw=$(nmcli -g IP4.GATEWAY dev show "$dev" 2>/dev/null | head -1 || echo "")
  # One `iw link` for BSSID, freq, bitrate and dBm (NM has no bssid field on dev show).
  if command -v iw >/dev/null 2>&1; then
    link=$(iw dev "$dev" link 2>/dev/null || true)
    bssid=$(awk '/^Connected to/ { print $3; exit }' <<<"$link")
    freq=$(awk '/freq:/ { print $2; exit }' <<<"$link")
    bitrate=$(awk '/tx bitrate:/ { print $3 " " $4; exit }' <<<"$link")
    dbm=$(awk '/signal:/ { gsub(/[^0-9-].*/, "", $2); print $2; exit }' <<<"$link")
  fi
  printf "Connected to %s\nSignal: %s%%\nInterface: %s\nIP: %s\nGateway: %s" "$ssid" "$sig" "$dev" "$ip" "$gw"
  # if-blocks, not trailing &&: a false test on the last line makes the whole
  # function return 1, and `tooltip=$(build_wifi_tooltip ...)` under `set -e`
  # then kills the script before it ever prints its JSON.
  if [[ "$dbm" =~ ^-?[0-9]{1,3}$ ]]; then printf "\ndBm: %s" "$dbm"; fi
  if [ -n "$freq" ]; then printf "\nFreq: %s MHz" "$freq"; fi
  channel=$(wifi_channel "$freq")
  if [ "$channel" != 0 ]; then printf "\nChannel: %s" "$channel"; fi
  if [ -n "$bitrate" ]; then printf "\nBitrate: %s" "$bitrate"; fi
  if [ -n "$bssid" ]; then printf "\nBSSID: %s" "$bssid"; fi
}

build_ethernet_tooltip() {
  local dev="$1" conn="$2"
  local ip gw
  ip=$(nmcli -g IP4.ADDRESS dev show "$dev" 2>/dev/null | head -1 || echo "")
  gw=$(nmcli -g IP4.GATEWAY dev show "$dev" 2>/dev/null | head -1 || echo "")
  printf "%s %s\n gw %s" "$dev" "${ip}" "${gw}"
}

vpn_name=""
vpn_kind=""
while IFS= read -r line; do
  [ -z "$line" ] && continue
  # NAME:TYPE:ACTIVE — TYPE/ACTIVE never contain ':', so peel them off the end.
  active=${line##*:}
  name=${line%:*}
  type=${name##*:}
  name=${name%:*}
  name=${name//\\:/:}
  if [ "$active" = "yes" ] && { [ "$type" = "vpn" ] || [ "$type" = "wireguard" ]; }; then
    vpn_name=$name
    vpn_kind=$type
    break
  fi
done <<EOF
$(nmcli -t -f NAME,TYPE,ACTIVE connection show 2>/dev/null || true)
EOF

if [ -z "$vpn_name" ]; then
  tun_line=$(awk -F: '$2=="tun" && $3 ~ /^connected/ {print $1 ":" $4; exit}' <<<"$dev_status" || true)
  if [ -n "$tun_line" ]; then
    vpn_name=${tun_line#*:}
    [ -z "$vpn_name" ] && vpn_name=${tun_line%%:*}
    vpn_kind="external"
  fi
fi

vpn_since=0
if [ -n "$vpn_name" ] && [ "$vpn_kind" != "external" ]; then
  ts=$(nmcli -g connection.timestamp connection show "$vpn_name" 2>/dev/null || true)
  case "$ts" in
    ''|*[!0-9]*) ;;
    *) vpn_since=$ts ;;
  esac
fi
if [ "$vpn_since" = "0" ]; then
  tun_dev=$(awk -F: '$2 ~ /^(tun|wireguard|wg)$/ && $3 ~ /^connected/ {print $1; exit}' <<<"$dev_status" || true)
  if [ -n "${tun_dev:-}" ] && [ -d "/sys/class/net/$tun_dev" ]; then
    vpn_since=$(stat -c %Y "/sys/class/net/$tun_dev" 2>/dev/null || echo 0)
  fi
fi

vpn_tooltip=""
if [ -n "$vpn_name" ]; then
  now=$(date +%s)
  age=""
  if [ "$vpn_since" -gt 0 ] && [ "$vpn_since" -le "$now" ]; then
    age=$(fmt_age $((now - vpn_since)))
  fi
  if [ "$vpn_kind" = "external" ]; then
    vpn_tooltip=$(printf 'VPN: %s (external tunnel)' "$vpn_name")
  else
    vpn_tooltip=$(printf 'VPN: %s' "$vpn_name")
  fi
  [ -n "$age" ] && vpn_tooltip=$(printf '%s · up %s' "$vpn_tooltip" "$age")
fi

line=$(get_active)
if [ -z "$line" ]; then
  jq -cn \
    --arg text "󰤮" \
    --arg tooltip "$( [ -n "$vpn_tooltip" ] && printf '%s' "$vpn_tooltip" || printf 'Disconnected' )" \
    --arg vpn "$vpn_name" \
    --argjson vpnUp "$([ -n "$vpn_name" ] && echo true || echo false)" \
    --argjson vpnSince "${vpn_since:-0}" \
    --arg connectivity "none" \
    '{text:$text, tooltip:$tooltip, name:"", vpn:$vpnUp, vpnName:$vpn, vpnSince:$vpnSince, connectivity:$connectivity}'
  exit 0
fi

IFS=: read -r dev type state conn <<<"$line"

if [ "$type" = "wifi" ]; then
  # Try to get signal strength more reliably
  sig=$(nmcli -t -f IN-USE,SIGNAL dev wifi list --rescan no 2>/dev/null | awk -F: '/^\*/ {print $2; exit}' || echo 0)
  [ -z "$sig" ] && sig=50

  if [ "$sig" -ge 75 ]; then icon="󰤨"
  elif [ "$sig" -ge 50 ]; then icon="󰤥"
  elif [ "$sig" -ge 25 ]; then icon="󰤢"
  else icon="󰤟"
  fi

  tooltip=""
  if ! $bar; then tooltip=$(build_wifi_tooltip "$dev" "$conn" "$sig"); fi
else
  # get_active only returns ethernet and wifi lines.
  icon="󰈀"
  tooltip=$(build_ethernet_tooltip "$dev" "$conn")
fi

if [ -n "$vpn_tooltip" ]; then
  tooltip=$(printf '%s\n%s' "$tooltip" "$vpn_tooltip")
fi

jq -cn \
  --arg text "$icon" \
  --arg tooltip "$tooltip" \
  --arg name "$conn" \
  --arg vpn "$vpn_name" \
  --argjson vpnUp "$([ -n "$vpn_name" ] && echo true || echo false)" \
  --argjson vpnSince "${vpn_since:-0}" \
  --arg connectivity "$connectivity" \
  '{text:$text, tooltip:$tooltip, name:$name, vpn:$vpnUp, vpnName:$vpn, vpnSince:$vpnSince, connectivity:$connectivity}'
