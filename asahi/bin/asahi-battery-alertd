#!/usr/bin/env bash

set -euo pipefail
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/common.sh"

interval=30
warning_threshold=20
critical_threshold=10
critical_repeat_interval=60

psy="${ASAHI_PSY_DIR:-/sys/class/power_supply}"
battery_path=""
warning_sent=0
critical_sent=0
critical_last=0

find_power_supply() {
  local wanted="$1"
  local preferred="$2"
  local supply

  if [ -d "$psy/$preferred" ]; then
    printf '%s\n' "$psy/$preferred"
    return
  fi

  for supply in "$psy"/*; do
    if [ -r "$supply/type" ] && [ "$(cat "$supply/type")" = "$wanted" ]; then
      printf '%s\n' "$supply"
      return
    fi
  done
}

notify_battery() {
  local title="$1"
  local body="$2"
  local timeout="$3"
  local urgency="${4:-normal}"

  notify-send -a "Asahi Battery" -u "$urgency" -t "$timeout" -i battery-alert "$title" "$body"
}

while true; do
  if [ -z "$battery_path" ]; then
    battery_path="$(find_power_supply Battery macsmc-battery || true)"
  fi

  if [ -n "$battery_path" ] && [ -r "$battery_path/capacity" ] && [ -r "$battery_path/status" ]; then
    capacity="$(cat "$battery_path/capacity")"
    status="$(cat "$battery_path/status")"
    plugged=0
    if [ "$status" != "Discharging" ] || on_ac; then plugged=1; fi

    if [ "$plugged" -eq 1 ] || [ "$capacity" -gt "$warning_threshold" ]; then
      # Charger in after an alert: a short low-urgency card replaces the critical one (the shell keeps
      # one "Asahi Battery" card, and never times a critical one out).
      if [ "$plugged" -eq 1 ] && [ "$warning_sent" -eq 1 ]; then
        notify_battery "Charging · ${capacity}%" "" 4000 low || true
      fi
      warning_sent=0
      critical_sent=0
      critical_last=0
    elif [ "$capacity" -le "$critical_threshold" ]; then
      now="$(date +%s)"
      if [ "$critical_sent" -eq 0 ] || [ $((now - critical_last)) -ge "$critical_repeat_interval" ]; then
        if notify_battery "Critical battery" "Battery at ${capacity}%. Connect charger." 30000 critical; then
          warning_sent=1
          critical_sent=1
          critical_last="$now"
        fi
      fi
    elif [ "$capacity" -le "$warning_threshold" ] && [ "$warning_sent" -eq 0 ]; then
      if notify_battery "Low battery" "Battery at ${capacity}%." 10000 normal; then
        warning_sent=1
      fi
    fi
  fi

  sleep "$interval"
done
