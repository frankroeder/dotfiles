#!/usr/bin/env bash

set -euo pipefail

device="${1:-output}"

missing() {
  jq -cn --arg text "" --arg tooltip "${1:-}" --arg class "missing" '{text: $text, tooltip: $tooltip, class: $class}'
}

case "$device" in
  output)
    target="@DEFAULT_AUDIO_SINK@"
    name="Volume"
    kind="output"
    ;;
  input)
    target="@DEFAULT_AUDIO_SOURCE@"
    name="Microphone"
    kind="input"
    ;;
  *)
    echo "usage: $0 <output|input>" >&2
    exit 2
    ;;
esac

# Bounded: a stuck PipeWire must not hang the OSD.
line="$(timeout 2 wpctl get-volume "$target" 2>/dev/null || true)"
if [ -z "$line" ]; then
  missing "$name unavailable"
  exit 0
fi

volume="$(awk '{ printf "%.0f", $2 * 100 }' <<< "$line")"
state="unmuted"
case "$line" in
  *MUTED*) state="muted" ;;
esac

# Osd.qml reads class (muted) and percentage; it picks its own glyphs.
jq -cn \
  --arg class1 "$kind" \
  --arg class2 "$state" \
  --argjson percentage "$volume" \
  '{class: [$class1, $class2], percentage: $percentage}'
