#!/usr/bin/env bash
#
# asahi-metrics
#
# Disk throughput for the Storage pane: physical disks only (no partitions,
# loop, ram, zram). Rates are deltas against the previous run (state file).
#
# Tests: ASAHI_PROC_ROOT, ASAHI_SYS_ROOT, ASAHI_METRICS_STATE
#

set -euo pipefail

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  echo "usage: $0" >&2
  exit 2
fi

proc_root="${ASAHI_PROC_ROOT:-/proc}"
sys_root="${ASAHI_SYS_ROOT:-/sys}"
state_file="${ASAHI_METRICS_STATE:-${XDG_RUNTIME_DIR:-/tmp}/asahi-metrics.stat}"

now_ms="$(date +%s%3N 2>/dev/null || true)"
case "$now_ms" in
  '' | *[!0-9]*) now_ms="$(awk 'BEGIN { print int(systime() * 1000) }')" ;;
esac

# Physical disks: skip partitions, loop, ram, zram, floppy, optical.
devices=""
for block_path in "$sys_root"/class/block/*; do
  [ -e "$block_path" ] || continue
  device="${block_path##*/}"
  [ -e "$block_path/partition" ] && continue
  [ -e "$block_path/device" ] || continue
  case "$device" in
    loop*|ram*|zram*|fd*|sr*) continue ;;
  esac
  devices="$devices $device"
done
devices="${devices# }"

disk_read=0
disk_write=0
if [ -r "$proc_root/diskstats" ] && [ -n "$devices" ]; then
  disk_read="$(
    awk -v want="$devices" '
      BEGIN { n = split(want, a, / /); for (i = 1; i <= n; i++) ok[a[i]] = 1 }
      (NF >= 10 && ($3 in ok)) { r += $6 + 0; w += $10 + 0 }
      END { printf "%d %d", r * 512, w * 512 }
    ' "$proc_root/diskstats"
  )"
  disk_write="${disk_read##* }"
  disk_read="${disk_read%% *}"
fi
disk_read="${disk_read:-0}"
disk_write="${disk_write:-0}"

prev_ms=0
prev_read=0
prev_write=0
if [ -r "$state_file" ]; then
  read -r prev_ms prev_read prev_write _ < "$state_file" || true
fi
printf '%s %s %s\n' "$now_ms" "$disk_read" "$disk_write" > "$state_file"

elapsed=0
if [ "$prev_ms" -gt 0 ] && [ "$now_ms" -gt "$prev_ms" ]; then
  elapsed=$((now_ms - prev_ms))
fi

rate() {
  local now="$1" prev="$2"
  if [ "$elapsed" -le 0 ]; then
    printf "0"
    return
  fi
  awk -v n="$now" -v p="$prev" -v ms="$elapsed" 'BEGIN {
    d = n - p
    if (d < 0) d = 0
    printf "%.0f", d * 1000 / ms
  }'
}

jq -nc \
  --arg devices "$devices" \
  --argjson read_bps "$(rate "$disk_read" "$prev_read")" \
  --argjson write_bps "$(rate "$disk_write" "$prev_write")" \
  '{disk: {devices: ($devices | split(" ") | map(select(. != ""))), read_bps: $read_bps, write_bps: $write_bps}}'
