#!/usr/bin/env bash
# Start every quickshell module once. Runtime logs: `qs -c <module> log`.

set -u

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/quickshell"
log="$state_dir/asahi-start.log"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell"
modules=(
  remix
  screensaver
  expose
)

mkdir -p "$state_dir"
: > "$log"

# No `qs -d`: its fork/pipe handshake qFatal()s the daemon when the parent
# is gone before the child reports ready (8 SIGABRT coredumps in a week).
for module in "${modules[@]}"; do
  [ -f "$config_dir/$module/shell.qml" ] || continue
  printf '%s start %s\n' "$(date +%T)" "$module" >>"$log"
  setsid -f qs -n -c "$module" >/dev/null 2>&1
done
