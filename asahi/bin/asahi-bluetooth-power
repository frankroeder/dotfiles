#!/usr/bin/env bash
# Persist Bluetooth power via rfkill. bluetoothctl power off does not survive
# reboot; systemd-rfkill restores the soft block. Unblocking lets AutoEnable
# (BlueZ default) bring the adapter up — bluetoothctl power on fails while
# the block is set.
# Off powers down via BlueZ first: rfkill on a live BCM43xx radio can wedge it.

set -euo pipefail

POWER_WAIT_SECONDS="${ASAHI_BLUETOOTH_POWER_WAIT_SECONDS:-2}"

controllers() {
  timeout 2s bluetoothctl list 2>/dev/null | awk '{print $2}'
}

powered() {
  local controller
  for controller in $(controllers); do
    [ -n "$controller" ] || continue
    if timeout 2s bluetoothctl show "$controller" 2>/dev/null | grep -q 'Powered: yes'; then
      return 0
    fi
  done
  return 1
}

wait_powered() {
  local deadline=$((SECONDS + POWER_WAIT_SECONDS))
  while :; do
    powered && return 0
    ((SECONDS < deadline)) || return 1
    sleep 0.2
  done
}

# bluetoothctl returns once BlueZ confirms power-off (5 s cap); then rfkill-block so the
# soft block survives reboot.
power_off() {
  timeout 5s bluetoothctl power off >/dev/null 2>&1 || true
  rfkill block bluetooth
}

power_on() {
  rfkill unblock bluetooth
  wait_powered && return 0
  timeout 5s bluetoothctl power on >/dev/null 2>&1 || true
  wait_powered && return 0
  echo "asahi-bluetooth-power: adapter did not come up" >&2
  return 1
}

case "${1:-}" in
  on) power_on ;;
  off) power_off ;;
  toggle)
    if powered; then
      power_off
    else
      power_on
    fi
    ;;
  is-on) powered ;;
  *)
    echo "Usage: asahi-bluetooth-power <on|off|toggle|is-on>" >&2
    exit 2
    ;;
esac
