#!/usr/bin/env bash

set -u

bin="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"

for name in qs quickshell; do
  pkill -x "$name" 2>/dev/null || true
done

for _ in {1..30}; do
  if ! pgrep -x qs >/dev/null 2>&1 && ! pgrep -x quickshell >/dev/null 2>&1; then
    break
  fi
  sleep 0.1
done

"$bin/asahi-start-quickshell"
