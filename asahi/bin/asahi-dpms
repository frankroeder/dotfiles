#!/usr/bin/env bash
# DPMS only the outputs Hyprland currently has enabled.
# A global enable/disable pokes disconnected HDMI-A-1 on Asahi and the
# next plug freezes the laptop panel (shared DCP).
# Only outputs in the other state: a redundant enable (after resume, or one lit
# output beside an off one) forces a modeset and flashes the panel.

set -euo pipefail

action="${1:-}"
case "$action" in
on | off) ;;
*)
  echo "usage: $0 <on|off>" >&2
  exit 2
  ;;
esac

act=disable lit=true
[ "$action" = on ] && act=enable lit=false

enabled_names() {
  hyprctl monitors -j 2>/dev/null | jq -r --argjson lit "$lit" \
    '.[] | select(.disabled != true and .dpmsStatus == $lit) | .name'
}

while IFS= read -r name; do
  [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || continue
  hyprctl dispatch "hl.dsp.dpms({ action = \"$act\", monitor = \"$name\" })" \
    >/dev/null 2>&1 || true
done < <(enabled_names)
