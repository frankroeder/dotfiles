#!/usr/bin/env bash
#
# asahi-temperature
#
# Lists hwmon sensors by stable device name and label, not volatile hwmonN
# indices. Temperatures come from every chip; Apple Silicon also publishes
# SMC power rails and fan RPMs on macsmc_hwmon. There is no SoC die °C in
# sysfs — heatpipe watts are the dissipation estimate the fans follow.
# One pass on shell builtins (TempPane runs it every 2.5 s): --json forks one jq, the listing none.
#
# Usage: asahi-temperature [--json]
# Tests: ASAHI_HWMON_ROOT=/path/to/hwmon
#

set -euo pipefail
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/common.sh"

json=false
for arg in "$@"; do
  case "$arg" in
    --json) json=true ;;
    *)
      echo "usage: $0 [--json]" >&2
      exit 2
      ;;
  esac
done

hwmon_root="${ASAHI_HWMON_ROOT:-/sys/class/hwmon}"
json_rows=()

# raw / $2 with two decimals, rounded, into $fixed (awk's "%.2f" without the fork).
fixed2() {
  local raw=$1 div=$(($2 / 100)) sign=""
  if ((raw < 0)); then sign=- raw=$((-raw)); fi
  raw=$(((raw + div / 2) / div))
  printf -v fixed '%s%d.%02d' "$sign" $((raw / 100)) $((raw % 100))
}

sensor_desc() {
  case "$1:$2" in
    macsmc_hwmon:NAND\ Flash\ Temperature) desc="SMC storage/NAND area sensor." ;;
    macsmc_hwmon:Battery\ Hotspot) desc="SMC battery-near hotspot; useful chassis heat proxy." ;;
    macsmc_hwmon:Charge\ Regulator\ Temp) desc="SMC charge/power regulation; often the hottest system sensor." ;;
    macsmc_hwmon:WiFi/BT\ Module\ Temp) desc="SMC Wi-Fi/Bluetooth module temperature." ;;
    macsmc_hwmon:Heatpipe\ Power) desc="SMC estimate of SoC heatpipe dissipation; no die °C in sysfs." ;;
    macsmc_hwmon:Total\ System\ Power) desc="SMC whole-machine power draw." ;;
    macsmc_hwmon:AC\ Input\ Power) desc="Wall/adapter input power." ;;
    macsmc_hwmon:3.8\ V\ Rail\ Power) desc="Always-on 3.8 V rail; often idle at 0 W." ;;
    macsmc_hwmon:Fan\ *) desc="Live RPM; 0 means the SMC has stopped the fan." ;;
    macsmc_battery:*) desc="Battery pack temperature from the SMC battery driver." ;;
    nvme:Composite) desc="NVMe SSD controller composite temperature." ;;
    tas2764:*) desc="Speaker amplifier chip; rises under audio load." ;;
    *) desc="" ;;
  esac
}

# One sensor of chip $name: a listing row (+ description or fan range) or a JSON row.
# $1 bucket (temps / power / fans), $2 its *_input file.
sensor_row() {
  local bucket=$1 input=$2 raw label value unit suffix desc fixed min="" max="" extra='{}'
  read_line raw "$input"
  case "$raw" in '' | *[!0-9-]*) return ;; esac
  sensor_label label "$input"
  sensor_desc "$name" "$label"
  case "$bucket" in
    temps) fixed2 "$raw" 1000; value=$fixed unit=C suffix='°C   ' ;;
    power) fixed2 "$raw" 1000000; value=$fixed unit=W suffix=' W   ' ;;
    fans)
      value=$raw unit=RPM suffix=' RPM  '
      read_line min "${input%_input}_min"
      read_line max "${input%_input}_max"
      case "$min" in *[!0-9-]*) min="" ;; esac
      case "$max" in *[!0-9-]*) max="" ;; esac
      if [ -n "$min" ] && [ -n "$max" ]; then extra="{\"min\":$min,\"max\":$max}"; fi
      ;;
  esac
  if [ "$json" = true ]; then
    # Collected here and built by one jq at the end (not one jq fork per sensor).
    json_rows+=("$bucket" "$name" "$label" "$value" "$unit" "$input" "$desc" "$extra")
    return
  fi
  printf "  %-18s %-28s %7s%s%s\n" "$name" "$label" "$value" "$suffix" "$input"
  if [ -n "$min$max" ]; then
    printf "    %s%s%s RPM\n" "${min:-?}" $'–' "${max:-?}"
  elif [ -n "$desc" ]; then
    printf "    %s\n" "$desc"
  fi
}

# Every readable $2*_input of hwmon dir $1 as $3 rows, under a ">>> name$4 (dir)" header.
sensor_group() {
  local hwmon=$1 bucket=$3 header=0 input
  for input in "$hwmon"/"$2"*_input; do
    [ -r "$input" ] || continue
    if [ "$header" -eq 0 ] && [ "$json" != true ]; then
      printf ">>> %s%s (%s)\n" "$name" "$4" "$hwmon"
      header=1
    fi
    sensor_row "$bucket" "$input"
  done
  if [ "$header" -eq 1 ]; then echo ""; fi
}

if [ "$json" != true ]; then
  echo "============================================"
  echo "     Asahi Linux Temperature Sensors"
  echo "============================================"
  echo ""
  echo "Values are read from /sys/class/hwmon by device name and temp label."
  echo "Apple Silicon has no SoC die °C in sysfs; heatpipe watts track dissipation."
  echo ""
fi

smc=""
for hwmon in "$hwmon_root"/hwmon{0..99}; do
  [ -d "$hwmon" ] || continue
  read_line name "$hwmon/name"
  name=${name:-unknown}
  if [ "$name" = macsmc_hwmon ] && [ -z "$smc" ]; then smc=$hwmon; fi
  sensor_group "$hwmon" temp temps ""
done

# Power rails and fans: macsmc_hwmon only. Other chips (HID batteries,
# charger PSYs) publish zeros that are not useful in the overview.
if [ -n "$smc" ]; then
  name=macsmc_hwmon
  sensor_group "$smc" power power " power"
  sensor_group "$smc" fan fans " fans"
fi

if [ "$json" = true ]; then
  jq -nc '
    [$ARGS.positional as $a | range(0; $a | length; 8) | $a[.:. + 8]
      | {b: .[0], o: ({name: .[1], label: .[2], value: (.[3] | tonumber), unit: .[4], path: .[5], desc: .[6]} + (.[7] | fromjson))}] as $rows
    | {temps: [$rows[] | select(.b == "temps") | .o], power: [$rows[] | select(.b == "power") | .o],
       fans: [$rows[] | select(.b == "fans") | .o]}' --args "${json_rows[@]}"
fi
