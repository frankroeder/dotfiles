#!/usr/bin/env bash
# Save a PNG of a picked region. Geometry comes from asahi-capture-region.
#   asahi-cmd-screenshot [mode] [--clip]
# --clip copies to the clipboard only: nothing lands in the screenshot folder
# (the notification thumbnail is one overwritten file under $XDG_RUNTIME_DIR).

set -euo pipefail
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/common.sh"

bin="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
output_dir="$HOME/screenshots"
mode="${1:-smart}"
clip=0
[ "${2:-}" = "--clip" ] && clip=1

selection="$("$bin/asahi-capture-region" "$mode" || true)"
[ -n "$selection" ] || exit 0

# grim blocks on a DPMS-off output.
shot() {
  timeout 5 grim -g "$selection" "$1" && return 0
  notify-send -a screenshot -u critical "Screenshot failed" "grim failed or timed out (display off?)" 2>/dev/null || true
  exit 1
}

if [ "$clip" -eq 1 ]; then
  file="$(runtime_dir)/asahi-screenshot-clip.png"
  shot "$file"
  wl-copy --type image/png <"$file"
  notify-send -a screenshot -t 2500 -i "$file" "Screenshot copied" "Clipboard only, not saved" 2>/dev/null || true
  exit 0
fi

mkdir -p "$output_dir"
file="$output_dir/screenshot-$(date +'%Y-%m-%d_%H-%M-%S').png"
shot "$file"
wl-copy --type image/png <"$file"
# Open / Annotate on the card: notify-send waits, detached, for a click or the card closing.
# No -t: notify-send would stop listening after it, while the card (paused on hover) still shows.
setsid -f bash -c '
  act="$(notify-send -a screenshot -i "$1" -A open=Open -A annotate=Annotate "Screenshot saved" "$1" 2>/dev/null || true)"
  case "$act" in
    open) "$2/asahi-launch" xdg-open "$1" ;;
    annotate) "$2/asahi-launch" "$2/asahi-screenshot-annotate" "$1" ;;
  esac' _ "$file" "$bin" >/dev/null 2>&1
