#!/usr/bin/env bash
# Restart a session daemon (bindings: hyprpaper, hypridle): stop it, wait until it is gone, start it
# again through asahi-launch.

set -euo pipefail

bin="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
app_name="${1:-}"

if [ -z "$app_name" ]; then
  echo "usage: $0 <app-name> [args...]" >&2
  exit 2
fi

shift

pkill -x "$app_name" 2>/dev/null || true
for _ in {1..30}; do
  pgrep -x "$app_name" >/dev/null 2>&1 || break
  sleep 0.1
done

"$bin/asahi-launch" "$app_name" "$@" >/dev/null 2>&1 &

notify-send -a asahi-restart -t 1500 "${app_name} restarted" 2>/dev/null || true
