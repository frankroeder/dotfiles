#!/usr/bin/env bash
# Native host "caelestiafox" for the CaelestiaFox extension (AMO, signed).
# Flatpak Firefox reaches it through xdg-native-messaging-proxy, so this runs on the host.
# Speaks the browser protocol: 4-byte little-endian length, then JSON.
# Sends firefox.json now, then again whenever that file is replaced.
# Firefox passes the manifest path and extension id as arguments; both are ignored.

set -euo pipefail

scheme=${XDG_STATE_HOME:-$HOME/.local/state}/asahi-theme/firefox.json

send() {
  local msg=$1
  local len=${#msg}
  local hex
  printf -v hex '%08x' "$len"
  printf "\\x${hex:6:2}\\x${hex:4:2}\\x${hex:2:2}\\x${hex:0:2}"
  printf '%s' "$msg"
}

send_file() {
  local msg
  [ -f "$scheme" ] || return 0
  msg=$(jq -c . "$scheme")
  [ -n "$msg" ] || return 0
  send "$msg"
}

send_file

dir=$(dirname "$scheme")
base=$(basename "$scheme")
mkdir -p "$dir"
inotifywait -q -m -e close_write,moved_to,create --format '%f' "$dir" | while read -r file; do
  if [ "$file" = "$base" ]; then
    send_file
  fi
done &
# pkill -P: $! is only the while-loop end of the pipeline; inotifywait would outlive Firefox.
trap 'pkill -P $$ 2>/dev/null || true' EXIT
trap 'exit 0' INT TERM HUP
# bash runs traps only after a foreground child exits; `wait` is interruptible, so TERM acts
# at once. Async jobs get /dev/null as stdin unless redirected (<&0).
cat <&0 >/dev/null &
wait $!
