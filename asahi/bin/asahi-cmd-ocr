#!/usr/bin/env bash
# OCR a screen region (slurp + grim + tesseract) and copy the text.

set -euo pipefail
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/common.sh"

# 2x capture: tesseract drops small text at native resolution.
decode_region 2 tesseract stdin stdout --oem 1 --psm 6 -l eng --dpi 300 -c preserve_interword_spaces=1
if [ -z "$decoded" ]; then
  notify-send -a screenshot -u critical "No text found" "Try a tighter region" 2>/dev/null || true
  exit 1
fi

printf '%s' "$decoded" | wl-copy
notify-send -a screenshot -t 2500 "Copied text from selection" 2>/dev/null || true
