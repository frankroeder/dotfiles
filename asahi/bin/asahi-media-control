#!/usr/bin/env bash

set -euo pipefail

target="${1:-}"
action="${2:-}"

if [ -z "$target" ] || [ -z "$action" ]; then
  echo "usage: $0 <output-volume|input-volume|brightness|keyboard-brightness|caps-lock|playerctl> <action>" >&2
  exit 2
fi

display_device() {
  local device="${ASAHI_BACKLIGHT_DEVICE:-apple-panel-bl}"

  if brightnessctl --device="$device" info >/dev/null 2>&1; then
    printf "%s\n" "$device"
    return 0
  fi

  for path in /sys/class/backlight/*; do
    [ -e "$path" ] || continue
    basename "$path"
    return 0
  done

  return 1
}

keyboard_device() {
  local device="${ASAHI_KEYBOARD_BACKLIGHT_DEVICE:-kbd_backlight}"

  if brightnessctl --device="$device" info >/dev/null 2>&1; then
    printf "%s\n" "$device"
    return 0
  fi

  for path in /sys/class/leds/*kbd_backlight*; do
    [ -e "$path" ] || continue
    basename "$path"
    return 0
  done

  return 1
}

brightness_step() {
  local current="$1" action="$2" target
  case "$action" in
    raise)
      if [ "$current" -lt 5 ]; then target=$((current + 1)); else target=$((current + 5)); fi
      [ "$target" -gt 100 ] && target=100
      printf '%s%%\n' "$target"
      ;;
    lower)
      if [ "$current" -le 5 ]; then target=$((current - 1)); else target=$((current - 5)); fi
      [ "$target" -lt 1 ] && target=1
      printf '%s%%\n' "$target"
      ;;
    +1)
      target=$((current + 1))
      [ "$target" -gt 100 ] && target=100
      printf '%s%%\n' "$target"
      ;;
    -1)
      target=$((current - 1))
      [ "$target" -lt 1 ] && target=1
      printf '%s%%\n' "$target"
      ;;
    *)
      echo "unsupported brightness action: $action" >&2
      exit 2
      ;;
  esac
}

current_percent() {
  brightnessctl --device="$1" -m 2>/dev/null | awk -F, '{ gsub("%", "", $4); print $4; found=1 } END { exit !found }'
}

focused_monitor() {
  hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true).name // empty'
}

monitor_is_internal() {
  [[ "${1:-}" =~ ^(eDP|LVDS|DSI)- ]]
}

show_osd() {
  local function="$1"
  shift || true
  qs -c remix ipc call osd "$function" "$@" >/dev/null 2>&1 || true
}

case "$target" in
  output-volume)
    case "$action" in
      raise) wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+ ;;
      lower) wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%- ;;
      mute-toggle) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
      +1) wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 1%+ ;;
      -1) wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 1%- ;;
    esac
    show_osd volume
    ;;
  input-volume)
    if [ "$action" = "mute-toggle" ]; then
      wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
      show_osd mic
      exit 0
    fi

    case "$action" in
      raise) wpctl set-volume -l 1 @DEFAULT_AUDIO_SOURCE@ 5%+ ;;
      lower) wpctl set-volume -l 1 @DEFAULT_AUDIO_SOURCE@ 5%- ;;
      +1) wpctl set-volume -l 1 @DEFAULT_AUDIO_SOURCE@ 1%+ ;;
      -1) wpctl set-volume -l 1 @DEFAULT_AUDIO_SOURCE@ 1%- ;;
    esac
    show_osd mic
    ;;
  playerctl)
    exec playerctl "$action"
    ;;
  brightness)
    exec {lock_fd}>"${XDG_RUNTIME_DIR:-/tmp}/asahi-brightness.lock"
    flock -n "$lock_fd" || exit 0

    monitor="$(focused_monitor || true)"
    if [ -n "$monitor" ] && ! monitor_is_internal "$monitor"; then
      # Asahi HDMI has no DDC I2C. Never fall through to apple-panel-bl.
      percent="$("$(dirname "$0")/asahi-brightness-soft" "$monitor" "$action")"
      show_osd brightnessSet "$percent"
      exit 0
    fi

    device="$(display_device)"
    current="$(current_percent "$device")"
    brightnessctl --quiet --device="$device" set "$(brightness_step "$current" "$action")"
    show_osd brightnessSet "$(current_percent "$device")"
    ;;
  keyboard-brightness)
    device="$(keyboard_device)"
    current="$(current_percent "$device" || echo 0)"
    brightnessctl --quiet --device="$device" set "$(brightness_step "$current" "$action")"
    show_osd keyboard
    ;;
  caps-lock)
    show_osd caps
    ;;
  *)
    echo "unknown target: $target" >&2
    exit 2
    ;;
esac
