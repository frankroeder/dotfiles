#!/usr/bin/env bash

set -euo pipefail

bin="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
. "$bin/lib/common.sh"

target="${1:-}"
action="${2:-}"

if [ -z "$target" ] || { [ "$target" != "output-switch" ] && [ -z "$action" ]; }; then
  echo "usage: $0 <output-volume|input-volume|output-switch|brightness|keyboard-brightness|caps-lock|playerctl> <action>" >&2
  exit 2
fi

# wpctl calls are bounded (timeout 2): a stuck PipeWire must not hang the keys.
# 1 % steps below 5 % (step_percent, clamped 0-100).
volume_step() {
  local node="$1" action="$2" current target
  current=$(timeout 2 wpctl get-volume "$node" | awk '{ printf "%d", $2 * 100 + 0.5 }')
  target=$(step_percent "$current" "$action")
  timeout 2 wpctl set-volume -l 1 "$node" "$target%"
}

unmute_if_muted() {
  if timeout 2 wpctl get-volume "$1" | grep -q MUTED; then
    timeout 2 wpctl set-mute "$1" 0
  fi
}

current_percent() {
  brightnessctl --device="$1" -m 2>/dev/null | awk -F, '{ gsub("%", "", $4); print $4; found=1 } END { exit !found }'
}

monitor_is_internal() {
  [[ "${1:-}" =~ ^(eDP|LVDS|DSI)- ]]
}

show_osd() {
  local function="$1"
  shift || true
  qs -c remix ipc call osd "$function" "$@" >/dev/null 2>&1 || true
}

# Idle-dimmed / idled off (asahi-idle-brightness): this press is also the wake. Take its lock and its
# saved level first, so the step starts from that level and the resume restore cannot undo it.
take_idle_level() {
  local saved="${ASAHI_IDLE_STATE_DIR:-${XDG_RUNTIME_DIR:-/tmp}/asahi-idle-brightness}/$2"
  exec {idle_fd}>"$(brightness_lock)"
  flock -w 2 "$idle_fd" || true
  if [ -s "$saved" ]; then
    brightnessctl --quiet --device="$1" set "$(<"$saved")"
    rm -f "$saved"
  fi
}

case "$target" in
  output-volume)
    case "$action" in
      raise | lower) volume_step @DEFAULT_AUDIO_SINK@ "$action" ;;
      mute-toggle) timeout 2 wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
      +1) timeout 2 wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 1%+ ;;
      -1) timeout 2 wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 1%- ;;
    esac
    # Changing the output level unmutes it (the mic stays muted: no silent unmute of a source).
    # Only when it really is muted: a set-mute on every step made the speakers click.
    case "$action" in raise | lower | +1 | -1) unmute_if_muted @DEFAULT_AUDIO_SINK@ ;; esac
    show_osd volume
    ;;
  output-switch)
    mapfile -t sinks < <(timeout 2 pactl -f json list sinks 2>/dev/null | jq -r '
      .[]
      | select((.ports | length == 0) or ([.ports[]? | .availability != "not available"] | any))
      | .name
    ')
    if [ "${#sinks[@]}" -eq 0 ]; then
      show_osd message "󰖁" "Audio output" "No devices"
      exit 1
    fi
    current="$(timeout 2 pactl get-default-sink 2>/dev/null || true)"
    next_index=0
    for i in "${!sinks[@]}"; do
      if [ "${sinks[$i]}" = "$current" ]; then
        next_index=$(( (i + 1) % ${#sinks[@]} ))
        break
      fi
    done
    next="${sinks[$next_index]}"
    timeout 2 pactl set-default-sink "$next" >/dev/null
    desc="$(timeout 2 pactl -f json list sinks 2>/dev/null | jq -r --arg n "$next" '
      [.[] | select(.name == $n) | (.description // .name)][0] // $n
    ')"
    show_osd message "󰕾" "Audio output" "$desc"
    ;;
  input-volume)
    case "$action" in
      mute-toggle) timeout 2 wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
      raise | lower) volume_step @DEFAULT_AUDIO_SOURCE@ "$action" ;;
    esac
    show_osd mic
    ;;
  playerctl)
    exec playerctl "$action"
    ;;
  brightness)
    exec {lock_fd}>"${XDG_RUNTIME_DIR:-/tmp}/asahi-brightness.lock"
    flock -n "$lock_fd" || exit 0

    monitor="$(focused_monitor || true)"
    if [ -n "$monitor" ] && ! monitor_is_internal "$monitor"; then
      # Asahi HDMI has no DDC I2C. Never fall through to apple-panel-bl.
      percent="$("$bin/asahi-brightness-soft" "$monitor" "$action")"
      show_osd brightnessSet "$percent"
      exit 0
    fi

    device="$(display_device)"
    take_idle_level "$device" "display-$device"
    current="$(current_percent "$device")"
    target=$(step_percent "$current" "$action")
    brightnessctl --quiet --device="$device" set "$target%"
    show_osd brightnessSet "$(current_percent "$device")"
    ;;
  keyboard-brightness)
    device="$(keyboard_device)"
    take_idle_level "$device" keyboard
    target=$(step_percent "$(current_percent "$device" || echo 0)" "$action")
    brightnessctl --quiet --device="$device" set "$target%"
    show_osd keyboard
    ;;
  caps-lock)
    show_osd caps
    ;;
  *)
    echo "unknown target: $target" >&2
    exit 2
    ;;
esac
