#!/usr/bin/env bash

set -euo pipefail

if [ "$#" -eq 0 ]; then
  echo "usage: $0 <command> [args...]" >&2
  exit 2
fi

app_id="org.asahi.$(basename "$1")"
# ASAHI_TUI_WAIT=1: the window stays after the command exits (asahi-pkg: dnf's result stays readable).
exec "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/asahi-launch" ghostty \
  --class="$app_id" --window-width=120 --window-height=34 \
  ${ASAHI_TUI_WAIT:+--wait-after-command=true} -e "$@"
