#!/usr/bin/env bash

set -euo pipefail

bin="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
. "$bin/lib/common.sh"

if [ "$#" -eq 0 ]; then
  echo "usage: $0 <command> [args...]" >&2
  exit 2
fi

app_id="org.asahi.$(basename "$1")"

if ! command -v "$1" >/dev/null 2>&1 && [ ! -x "$1" ]; then
  notify-send "TUI launcher" "$1 is not installed."
  exit 1
fi

if focus_client '.class == $class or .initialClass == $class' --arg class "$app_id"; then
  exit 0
fi

exec "$bin/asahi-launch-tui" "$@"
