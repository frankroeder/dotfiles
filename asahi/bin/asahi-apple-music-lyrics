#!/usr/bin/env python3
"""Native messaging host of the Apple Music app's extension (asahi/apple-music/extension/background.js).

Chromium starts it per lyrics record (sendNativeMessage): a 4-byte length (native byte order) + JSON on stdin, the
same framing for the reply on stdout. The record {trackId, title, artist, synced, lines: [{t, text}]} replaces
$XDG_RUNTIME_DIR/asahi-apple-music-lyrics.json (0600, temp + rename) for Quickshell's services/Lyrics.qml.
asahi-apple-music installs the host manifest. Test: asahi_apple_music_lyrics_test.py.
"""
import json
import os
import struct
import sys

OUT = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}", "asahi-apple-music-lyrics.json")


def read(f):
  head = f.read(4)
  if len(head) < 4:
    return None
  return json.loads(f.read(struct.unpack("=I", head)[0]))


def reply(f, msg):
  data = json.dumps(msg).encode()
  f.write(struct.pack("=I", len(data)) + data)
  f.flush()


def record(msg):
  """Only the fields the shell reads."""
  lines = [{"t": ln.get("t"), "text": str(ln.get("text", ""))} for ln in msg.get("lines") or [] if isinstance(ln, dict)]
  rec = {k: str(msg.get(k) or "") for k in ("trackId", "title", "artist")}
  return rec | {"synced": msg.get("synced") is True, "lines": lines}


def save(rec, path=OUT):
  tmp = f"{path}.{os.getpid()}.tmp"  # per process: two hosts may overlap on a quick skip
  with os.fdopen(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
    json.dump(rec, f)
  os.replace(tmp, path)


def main():
  while (msg := read(sys.stdin.buffer)) is not None:
    if isinstance(msg, dict):
      save(record(msg))
    reply(sys.stdout.buffer, {"ok": True})


if __name__ == "__main__":
  main()
