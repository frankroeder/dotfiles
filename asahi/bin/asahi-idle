#!/usr/bin/env bash
# hypridle steps shaped like macOS: dim at half the display-off time, lock with display off,
# sleep a minute later, no screensaver on battery. Battery display-off is 5 min by choice
# (macOS: 2). The step comes from the power source when a threshold fires (`asahi-idle at <s>`).
#
#   battery: dim 150 s, off 300 s     AC: saver 180 s, dim 300 s, off 600 s
#
#   saver   start the shader screensaver
#   dim     half-dim display (saver keeps running), lower keyboard backlight
#   off     stop saver, lock, display (DPMS) + keyboard backlight off,
#           s2idle a minute later unless input brings the display back
#   asahi-idle wake   hypridle on-resume / after_sleep: undo every step
#
# A step still running when wake fires (saver start takes seconds) re-runs
# wake afterwards, so nothing lands on an active session.
#
# The lock surface mapping is fake pointer motion to Hyprland: it fires
# hypridle on-resume and restarts every listener. `off` therefore ignores
# wakes while it locks, then owns the rest itself — key_press_enables_dpms
# relights the panel on real input (off watches for that and runs wake),
# otherwise it suspends. Keyboard/trackpad cannot wake s2idle here (MTP has
# no wakeup source); lid and power button can.
#
# The stay-awake chip (asahi-stay-awake) skips every step.

set -euo pipefail

bin="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
. "$bin/lib/common.sh"
cmd="${1:-}"
secs="${2:-}"
step=""
stamp="${XDG_RUNTIME_DIR:-/tmp}/asahi-idle-wake"
locking="${XDG_RUNTIME_DIR:-/tmp}/asahi-idle-locking"
log_file="${XDG_STATE_HOME:-$HOME/.local/state}/asahi/idle.log"

log() {
  mkdir -p "${log_file%/*}"
  echo "$(date '+%F %T') $*" >> "$log_file"
}

wake() {
  # Ignore wakes while off locks (the lock surface fakes motion). Only a flag <15 s old counts:
  # an off killed mid-lock leaves the flag behind and must not swallow every later wake.
  if [ -n "$(find "$locking" -newermt '-15 seconds' 2>/dev/null)" ]; then log "wake ignored: lock surface"; return 0; fi
  touch "$stamp"
  # hypridle fires on-resume for every listener at once: the first wake runs, the rest drop.
  # A step's own "raced a wake" re-run waits for the lock instead, so its undo is not lost.
  exec {wake_lock}>"${XDG_RUNTIME_DIR:-/tmp}/asahi-idle-wake.lock"
  if [ "$cmd" = wake ]; then flock -n "$wake_lock" || return 0; else flock -w 5 "$wake_lock" || true; fi
  # Lid closed, no clamshell: keep the panel dark (a refused suspend ran after_sleep and lit the
  # closed panel for an hour). asahi-clamshell open relights it on lid open.
  if lid_closed && ! "$bin/asahi-clamshell" status; then log "wake kept dark: lid closed"; return 0; fi
  log wake
  "$bin/asahi-screensaver" stop || true
  "$bin/asahi-dpms" on
  # In clamshell keep the closed panel dark; asahi-clamshell open restores it on lid open.
  "$bin/asahi-clamshell" status || "$bin/asahi-idle-brightness" restore
}

if [ "$cmd" = wake ]; then
  wake
  exit 0
fi

on_ac() {
  local p
  for p in /sys/class/power_supply/*; do
    [ "$(cat "$p/type" 2>/dev/null)" = Mains ] && [ "$(cat "$p/online" 2>/dev/null)" = 1 ] && return 0
  done
  return 1
}

if [ "$cmd" != at ] || [[ ! $secs =~ ^[0-9]+$ ]]; then
  echo "usage: $0 at <idle seconds> | $0 wake" >&2
  exit 2
fi

# t = (saver dim off) in idle seconds; saver 0 = no screensaver.
if on_ac; then source=ac; t=(180 300 600); else source=battery; t=(0 150 300); fi
if ((secs >= t[2])); then step=off
elif ((secs >= t[1])); then step=dim
elif ((t[0] > 0 && secs >= t[0])); then step=saver
else exit 0
fi

if "$bin/asahi-stay-awake" status; then log "$source $step skipped: stay-awake"; exit 0; fi
log "$source $step (${secs}s)"

started="$(mktemp)"
trap 'rm -f "$started"; [ "$step" = off ] && rm -f "$locking" || true' EXIT
woke() { [ "$stamp" -nt "$started" ]; }

locked() { pidof hyprlock >/dev/null; }
display_lit() { hyprctl monitors -j 2>/dev/null | jq -e 'any(.[]; .dpmsStatus)' >/dev/null; }

# Browser tabs keep silent streams RUNNING for hours, so RUNNING is not playback: record ~1 s of
# each running sink's monitor and look for signal (stream.capture.sink, else pw-record takes the
# mic). The monitor is pre-volume: muted playback still blocks sleep, like macOS.
playing() {
  local sink samples
  for sink in $(pactl list sinks short 2>/dev/null | awk '$NF == "RUNNING" { print $2 }'); do
    samples=$(timeout 1.2 pw-record -P '{ stream.capture.sink = true }' --target "$sink" \
      --rate 8000 --channels 1 --format s16 --raw - 2>/dev/null | od -An -v -td2 -w2) || true
    if awk '{ v = $1 < 0 ? -$1 : $1; if (v > 16) { found = 1; exit } } END { exit !found }' <<<"$samples"; then
      return 0
    fi
  done
  return 1
}

stream_apps() {
  pactl -f json list sink-inputs 2>/dev/null \
    | jq -r '[.[] | select(.corked | not) | .properties["application.name"] // empty] | unique | join(", ")' 2>/dev/null || true
}

# `can_sleep quiet` (the off loop's retries) skips the log line.
can_sleep() {
  local why=""
  # macOS holds system sleep while audio plays (power assertion).
  if playing; then why="audio ($(stream_apps))"
  # Docked / HDMI: s2idle with an external output is the DCP hang path.
  elif hyprctl monitors -j 2>/dev/null | jq -e 'any(.[]; .name != "eDP-1")' >/dev/null; then why=external
  # Last suspend refused by the kernel: retrying only churns the DCP. A good lid suspend clears it.
  elif systemctl is-failed --quiet systemd-suspend.service; then why="last suspend failed"
  fi
  [ -z "$why" ] && return 0
  [ "${1:-}" = quiet ] || log "sleep skipped: $why"
  return 1
}

case "$step" in
  saver)
    # The lock restarts hypridle's listeners; nothing to show under hyprlock.
    if locked; then log "saver skipped: locked"; exit 0; fi
    "$bin/asahi-screensaver" start
    if woke; then log "$step raced a wake"; wake; fi
    ;;
  dim)
    if locked; then log "dim skipped: locked"; exit 0; fi
    "$bin/asahi-idle-brightness" dim
    if woke; then log "$step raced a wake"; wake; fi
    ;;
  off)
    # One off loop at a time: on battery 300 and 600 s both map to off, and the lock surface's
    # fake motion restarts the listeners while the first loop still waits to sleep.
    exec {off_lock}>"${XDG_RUNTIME_DIR:-/tmp}/asahi-idle-off.lock"
    # A losing off swaps the EXIT trap: it must not delete the winner's locking flag.
    if ! flock -n "$off_lock"; then log "off already running"; trap 'rm -f "$started"' EXIT; exit 0; fi
    # Stopping the saver unmaps a surface, which also reads as pointer motion: flag first.
    touch "$locking"
    "$bin/asahi-screensaver" stop || true
    if ! locked; then
      loginctl lock-session
      for _ in $(seq 1 20); do if locked; then break; fi; sleep 0.25; done
    fi
    sleep 3
    rm -f "$locking"
    if woke; then log "$step raced a wake"; wake; exit 0; fi
    "$bin/asahi-idle-brightness" keyboard-off
    "$bin/asahi-dpms" off
    sleep 1
    # Real input relights the panel (key_press_enables_dpms); undo the rest.
    for _ in $(seq 1 60); do
      if woke; then exit 0; fi
      if display_lit; then log "input relit display"; wake; exit 0; fi
      sleep 1
    done
    if can_sleep; then log sleep; systemctl suspend; exit 0; fi
    # Not asleep yet: keep watching for input, retry sleep once a minute.
    tries=0
    while ! woke; do
      if display_lit; then log "input relit display"; wake; exit 0; fi
      tries=$((tries + 1))
      if ((tries % 30 == 0)) && can_sleep quiet; then log "sleep (retry)"; systemctl suspend; exit 0; fi
      sleep 2
    done
    ;;
esac
