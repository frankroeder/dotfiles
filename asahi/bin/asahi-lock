#!/usr/bin/env bash
# The session lock (the Quickshell lock, remix/lock.qml), restarted until the session is really unlocked.
#
# The lock exits 0 only once it released the session (or the compositor refused it). Anything else -- a crash, a
# `kill -9` -- leaves Hyprland on its crashed-lock screen ("Oopsie daisy") with the session still locked and no way in.
# misc.allow_session_lock_restore lets a fresh lock take that lock back, so restart it instead of
# hl.clear_crashed_lockscreen() (that unlocks without a password). One guard per session (flock); hypridle lock_cmd,
# Super+Escape, the launcher and asahi-clamshell all land here. Only this session's lock counts (lock_running): a
# nested preview's must not skip the lock. The lock's output goes to ~/.local/state/asahi/lock.log (Hyprland's own
# log is tmpfs and gone after the reboot that follows a wedge).
# TTY escape: pkill -f asahi-lock; pkill -f remix/lock.qml; then Hyprland's crashed-lock screen needs
# hyprctl --instance 0 eval 'hl.clear_crashed_lockscreen()' (by hand, logged in on the TTY: never from here).
# hyprlock was the fallback until 2026-11-22 (removed, his call; omarchy quattro dropped it too).

set -u
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/common.sh"
exec 9>"$(runtime_dir)/asahi-lock.flock"
flock -n 9 || exit 0
lock_running && exit 0
log="${XDG_STATE_HOME:-$HOME/.local/state}/asahi/lock.log"
mkdir -p "$(dirname "$log")"
[ "$(stat -c %s "$log" 2>/dev/null || echo 0)" -gt 1000000 ] && : >"$log"
reader_state="$(runtime_dir)/asahi-lock.reader"   # "unlocked" on the unlock line, "eof" once the reader ends
run() {
  date -Is >>"$log"
  rm -f "$reader_state"
  # The lock prints "Unlocked, exiting!" when PAM says yes (then the lift-off plays, then it releases): the intro
  # starts on that line. No -n: qs exits 0 when any instance of this path runs, a nested preview too ("done" here).
  qs -p "$HOME/.dotfiles/asahi/quickshell/remix/lock.qml" > >(while IFS= read -r l; do
    printf '%s\n' "$l"
    case $l in *"Unlocked, exiting"*) echo unlocked >>"$reader_state"; intro play >/dev/null ;; esac
  done >>"$log"; echo eof >>"$reader_state") 2>&1
  local rc=$?
  echo "lock exit $rc" >>"$log"
  # A crash past the unlock line counts as unlocked: a retry would lock again right after the password. The reader may
  # lag the exit: wait for its verdict (≤ 1 s; `$!` does not name an output process substitution after an external
  # command). If the crash came before the release, Hyprland stays locked (fails closed): Super+Escape retakes it.
  if [ $rc -ne 0 ]; then
    for _ in $(seq 20); do grep -qs -e unlocked -e eof "$reader_state" && break; sleep 0.05; done
    if grep -qs unlocked "$reader_state"; then echo "crashed after unlock: done" >>"$log"; return 0; fi
  fi
  return $rc
}
# Wallpaper intro (WallpaperIntro.qml; nothing without a clip). --any-display: Super+Escape runs us from Hyprland,
# whose env lacks the shell's QT_QPA_PLATFORM (no match).
intro() { timeout 1 qs -c remix ipc --any-display call wallpaperIntro "$@" 2>/dev/null; }   # a hung qs must not stop the lock
# Every exit plays (unlock, out of retries, the TTY escape's pkill): the held first frame has no failsafe and would
# stay over the wallpaper. A no-op once the unlock line started it (WallpaperIntro plays once per arm).
# While this guard runs the session is locked: the shell pauses its bar polling on this flag (BarData.locked); the EXIT
# trap drops it on every way out (unlock, out of retries, the TTY escape's pkill).
locked_flag="$(runtime_dir)/asahi-locked"
: >"$locked_flag"
trap 'rm -f "$locked_flag"; intro play >/dev/null' EXIT
# Locking: the intro shows its first frame before the lock comes up (nothing presents while locked, so unlock shows
# what was on screen then; ≤ ~0.4 s), and starts on unlock.
if intro arm >/dev/null; then
  for _ in $(seq 10); do [ "$(intro ready)" = false ] || break; sleep 0.01; done
fi
run && exit 0
for _ in $(seq 30); do
  sleep "${ASAHI_LOCK_RETRY_S:-2}"
  run && exit 0
done
exit 1
