#!/usr/bin/env bash
# hyprlock, restarted until the session is really unlocked.
#
# hyprlock exits 0 only when the compositor unlocked or refused the lock
# (`finished`). Anything else -- a crash on monitor churn (FALLBACK output while
# the external drops in clamshell), a `killall -9` -- leaves Hyprland on the
# lockdead screen ("Oopsie daisy") with the session still locked and no way in.
# misc.allow_session_lock_restore lets a fresh hyprlock take that lock back, so
# restart it instead of hl.clear_crashed_lockscreen() (that unlocks without a
# password). One guard per session (flock); hypridle lock_cmd and Super+Escape
# both land here. Escape hatch from a TTY: pkill -f asahi-lock; killall hyprlock.
# Only this session's hyprlock counts (hyprlock_running): a nested preview's must not skip the lock.
# hyprlock's stderr goes to ~/.local/state/asahi/hyprlock.log (Hyprland's own
# log is tmpfs and gone after the reboot that follows a wedge).

set -u
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/common.sh"
exec 9>"$(runtime_dir)/asahi-lock.flock"
flock -n 9 || exit 0
hyprlock_running && exit 0
log="${XDG_STATE_HOME:-$HOME/.local/state}/asahi/hyprlock.log"
mkdir -p "$(dirname "$log")"
[ "$(stat -c %s "$log" 2>/dev/null || echo 0)" -gt 1000000 ] && : >"$log"
# hyprlock shows nothing when Touch ID cannot be claimed, and does not know Aurora's lockout statuses: its fingerprint
# log lines become the line asahi-lock-touchid prints in place of the glyph ("<until epoch> <text>", 0 = stays).
note="$(runtime_dir)/asahi-lock-touchid.note"
fails=0
touchid_note() {
  local till=0 text="Touch ID unavailable · enter password"
  case $1 in
    *"handling status verify-no-match"*)   # hyprlock gives 3 retries per lock
      if ((++fails > 3)); then text="Too many failed attempts · enter password"; else till=$((EPOCHSECONDS + 2)) text="No match"; fi ;;
    *"handling status verify-retry-scan"* | *"handling status verify-finger-not-centered"* | \
      *"handling status verify-remove-and-retry"* | *"handling status verify-too-fast"*)
      till=$((EPOCHSECONDS + 2)) text="Not read · touch again" ;;
    *"handling status verify-lockout"*) text="Too many failed attempts · enter password" ;;
    *"handling status verify-password-required"*) text="Enter password to enable Touch ID" ;;   # SEP password clock
    *"handling status verify-disconnected"* | *"handling status verify-unknown-error"* | *"could not start verifying"*) ;;
    *"could not claim device"*)
      # fprintd left the reader open (a suspend during a sudo / polkit finger prompt): every claim fails until it
      # restarts (polkit rule 49-asahi-fprintd-restart). This hyprlock never claims again; the next lock does.
      if [[ $1 == *"already been opened"* ]]; then systemctl --no-ask-password --no-block restart fprintd.service; fi ;;
    *"started verifying"*) grep -qs '^0 ' "$note" && rm -f "$note"; return ;;
    *) return ;;
  esac
  printf '%s %s\n' "$till" "$text" >"$note"
}
run() {
  date -Is >>"$log"
  rm -f "$note"
  # The intro starts on hyprlock's unlock line, not at its exit: after a Touch ID unlock hyprlock lingers seconds
  # (its pending password PAM attempt fails and waits out the failure delay).
  hyprlock "$@" > >(while IFS= read -r l; do
    printf '%s\n' "$l"
    case $l in
      *"Unlocked, exiting"*) intro play >/dev/null ;;
      *"fprint: "*) touchid_note "$l" ;;
    esac
  done >>"$log") 2>&1
  local rc=$?
  echo "hyprlock exit $rc" >>"$log"
  return $rc
}
# Wallpaper intro (WallpaperIntro.qml; nothing without a clip). --any-display: Super+Escape runs us from Hyprland,
# whose env lacks the shell's QT_QPA_PLATFORM (no match).
intro() { timeout 1 qs -c remix ipc --any-display call wallpaperIntro "$@" 2>/dev/null; }   # a hung qs must not stop the lock
# Every exit plays (unlock, out of retries, the TTY escape's pkill): the held first frame has no failsafe and would
# stay over the wallpaper. A no-op once the unlock line started it (WallpaperIntro plays once per arm).
trap 'intro play >/dev/null' EXIT
# Locking: the intro shows its first frame before hyprlock locks (nothing presents while locked, so unlock shows
# what was on screen then; ≤ ~0.4 s), and starts on unlock.
if intro arm >/dev/null; then
  for _ in $(seq 10); do [ "$(intro ready)" = false ] || break; sleep 0.01; done
fi
run && exit 0
for _ in $(seq 30); do
  sleep "${ASAHI_LOCK_RETRY_S:-2}"
  run --no-fade-in && exit 0
done
exit 1
