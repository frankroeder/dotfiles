#!/usr/bin/env bash
# hyprlock, restarted until the session is really unlocked.
#
# hyprlock exits 0 only when the compositor unlocked or refused the lock
# (`finished`). Anything else -- a crash on monitor churn (FALLBACK output while
# the external drops in clamshell), a `killall -9` -- leaves Hyprland on the
# lockdead screen ("Oopsie daisy") with the session still locked and no way in.
# misc.allow_session_lock_restore lets a fresh hyprlock take that lock back, so
# restart it instead of hl.clear_crashed_lockscreen() (that unlocks without a
# password). One guard per session (flock); hypridle lock_cmd and Super+Escape
# both land here. Escape hatch from a TTY: pkill -f asahi-lock; killall hyprlock.
# hyprlock's stderr goes to ~/.local/state/asahi/hyprlock.log (Hyprland's own
# log is tmpfs and gone after the reboot that follows a wedge).

set -u
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/asahi-lock.flock"
flock -n 9 || exit 0
pidof hyprlock >/dev/null && exit 0
log="${XDG_STATE_HOME:-$HOME/.local/state}/asahi/hyprlock.log"
mkdir -p "$(dirname "$log")"
[ "$(stat -c %s "$log" 2>/dev/null || echo 0)" -gt 1000000 ] && : >"$log"
run() {
  date -Is >>"$log"
  hyprlock "$@" >>"$log" 2>&1
  local rc=$?
  echo "hyprlock exit $rc" >>"$log"
  return $rc
}
run && exit 0
for _ in $(seq 30); do
  sleep "${ASAHI_LOCK_RETRY_S:-2}"
  run --no-fade-in && exit 0
done
