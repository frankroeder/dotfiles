#!/usr/bin/env bash
# External outputs share card1 (DCP; card2 = GPU) with eDP. An HDMI modeset on the udev
# tick (valid_mode:0, eDP still flipping) froze the laptop. monitors.lua keeps
# HDMI-A-1 and DP-n disabled; this script enables one after a short settle.
# Each output has its own gen file, so one settle cannot cancel the other.
#
# Enable MUST set disabled = false. Omitting the field leaves the lua
# disable rule in place (hyprctl eval does not override it).

set -euo pipefail
bin="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
. "$bin/lib/common.sh"

action="${1:-}"
name="${2:-HDMI-A-1}"
settle_s="${ASAHI_HDMI_SETTLE_S:-2}"
drm_path="${ASAHI_DRM_PATH:-/sys/class/drm}"
# Positions kept from the launcher's Displays pane (drag + Keep), per sink.
layout_file="${ASAHI_LAYOUT_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/asahi/monitor-layout.json}"
clamshell="${ASAHI_CLAMSHELL:-$bin/asahi-clamshell}"
wait_s="${ASAHI_HDMI_WAIT_S:-6}"

usage() {
  echo "usage: $0 <added|removed|sync|on|off> [HDMI-A-1|DP-n]" >&2
  echo "       $0 save <name> <X>x<Y> | reset <name> | place <name>" >&2
  echo "       $0 mode <name> <extend|mirror|laptop|external> | remember <name> <mode> | recall <name>" >&2
  exit 2
}

[[ "$name" =~ ^(HDMI|DP)[A-Za-z0-9._-]*$ ]] || {
  echo "refusing monitor name: $name" >&2
  exit 1
}
gen_file="$(runtime_dir)/asahi-hdmi.gen.${name}"
# Set on the first enable after a plug, gone once the connector reads disconnected: a reload's fresh Lua state
# runs `added` again for every connected output, and that must not count as a new display.
seen_file="$(runtime_dir)/asahi-hdmi.seen.${name}"

drm_connected() {
  local f
  # Exact connector: card*-DP-1 must not match card*-DP-10, and must not read HDMI.
  for f in "$drm_path"/card*-"$name"/status; do
    [ -e "$f" ] || continue
    [ "$(tr -d '[:space:]' <"$f")" = "connected" ] && return 0
  done
  return 1
}

hypr_json() {
  hyprctl monitors all -j 2>/dev/null || printf '[]\n'
}

is_enabled() {
  hypr_json | jq -e --arg n "$name" \
    '.[] | select(.name == $n and .disabled != true)' >/dev/null
}

# Same numbers as the desc: rules in asahi/hypr/conf.d/monitors.lua.
# Both sit left of eDP. LG keeps a fixed vertical offset; the Dell's
# bottom edge meets eDP-1's. Never share one HDMI geometry.
#
# HDMI-A-1 is reused. After a cable swap the previous sink's description
# can stick (LG name + Dell 1440p modes). A 4K modeset then fails EINVAL.
# Trust the name only when its native mode is in availableModes (or the
# list is empty). Otherwise pick the stack whose native mode is present.
has_res() {
  [ -z "$2" ] && return 0
  case "$2" in *"$1"*) return 0 ;; esac
  return 1
}

# Offsets are derived, never pinned. Both sit left of eDP-1 (right edge on
# x = 0). The Dell's bottom meets eDP-1's bottom, so its y follows the
# session eDP scale (3024x1964; unset = monitors.lua's 2 → 982).
edp_logical_h() {
  awk -v s="$(edp_scale)" 'BEGIN { printf "%d", int(1964 / s + 0.5) }'
}

lg_fields() {
  # cm = edid: wide-gamut LG, Asahi never signals sRGB (omarchy wide-gamut.lua; also in monitors.lua).
  printf 'mode = "3840x2160@60.000", position = "%sx-360", scale = %s, cm = "edid"' "$(anchor_offset 3840 "$1")" "$1"
}

dell_fields() {
  local x y
  x="$(anchor_offset 2560 "$1")"
  y="$(awk -v h="$(edp_logical_h)" -v s="$1" 'BEGIN { printf "%d", h - int(1440 / s + 0.5) }')"
  printf 'mode = "2560x1440@59.95100", position = "%sx%s", scale = %s' "$x" "$y" "$1"
}

derived_fields() {
  local desc modes sc
  sc=$(saved_scale "$name")
  desc="$(hypr_json | jq -r --arg n "$name" \
    '.[] | select(.name == $n) | (.description // "")')"
  modes="$(hypr_json | jq -r --arg n "$name" \
    '.[] | select(.name == $n) | (.availableModes // [])[]?')"
  case "$desc" in
  *P2723DE*)
    if has_res 2560x1440 "$modes"; then
      dell_fields "${sc:-1.25}"
      return
    fi
    ;;
  *ULTRAFINE*)
    if has_res 3840x2160 "$modes"; then
      lg_fields "${sc:-1.875}"
      return
    fi
    ;;
  esac
  case "$modes" in
  *3840x2160*) lg_fields "${sc:-1.875}" ;;
  *2560x1440*) dell_fields "${sc:-1.25}" ;;
  *) printf 'mode = "preferred", position = "auto", scale = %s' "${sc:-1.5}" ;;
  esac
}

# A kept position only holds for the scales it was arranged at (the Dell's
# derived y follows eDP-1's height), so the key is "<hdmi scale>@<eDP scale>".
sink_desc() {
  hypr_json | jq -r --arg n "$name" '.[] | select(.name == $n) | (.description // "")'
}

layout_key() {
  awk -v h="$1" -v e="$(edp_scale)" 'BEGIN { printf "%.3f@%.3f", h, e }'
}

# "outputScale pos" for this sink when the entry was kept at the current eDP
# scale. Empty when none. The output scale lives in the key: a reload that
# only knows the monitors.lua default (Dell 1.25) must not apply that
# default's x to a scale-1 panel (2560px at x=-2048 overlaps eDP-1).
saved_entry() {
  [ -s "$layout_file" ] || return 0
  local desc edp
  desc="$(sink_desc)"
  [ -n "$desc" ] || return 0
  edp="$(edp_scale)"
  jq -r --arg d "$desc" --arg e "$edp" '
    .[$d] | select(type == "object" and .key != null and .pos != null)
    | (.key | split("@")) as $p
    | select($p | length == 2)
    | select((($p[1] | tonumber) - ($e | tonumber) | fabs) < 0.02)
    | "\($p[0]) \(.pos)"
  ' "$layout_file" 2>/dev/null || true
}

layout_fields() {
  local fields entry es ep file_scale
  fields="$(derived_fields)"
  file_scale="$(saved_scale "$name")"
  entry="$(saved_entry)"
  if [[ "$entry" =~ ^([0-9.]+)[[:space:]]+(-?[0-9]+x-?[0-9]+)$ ]]; then
    es="${BASH_REMATCH[1]}"
    ep="${BASH_REMATCH[2]}"
    # A session scale file that disagrees was set after Keep: re-derive at
    # that scale. Otherwise the kept scale and position are the layout.
    if [ -z "$file_scale" ] || awk -v a="$file_scale" -v b="$es" 'BEGIN { exit !((a - b) < 0.02 && (b - a) < 0.02) }'; then
      fields="$(printf '%s' "$fields" | sed -e "s/position = \"[^\"]*\"/position = \"$ep\"/" -e "s/scale = [^ ,]*/scale = $es/")"
    fi
  fi
  printf '%s' "$fields"
}

# One jq edit of the layout file. The Monitors pane's Keep saves every external at once: one writer at a
# time, or an entry is lost.
edit_layout() {
  local tmp lock
  mkdir -p "$(dirname "$layout_file")"
  exec {lock}>"$layout_file.lock"
  flock "$lock"
  [ -s "$layout_file" ] || printf '{}\n' >"$layout_file"
  tmp="$(mktemp "$layout_file.XXXXXX")"
  jq "$@" "$layout_file" >"$tmp"
  mv "$tmp" "$layout_file"
}

sink_desc_or_die() {
  local desc
  desc="$(sink_desc)"
  [ -n "$desc" ] || { echo "no description for $name" >&2; exit 1; }
  printf '%s' "$desc"
}

save_layout() {
  local pos="$1" desc scale
  [[ "$pos" =~ ^-?[0-9]+x-?[0-9]+$ ]] || { echo "bad position: $pos" >&2; exit 1; }
  desc="$(sink_desc_or_die)"
  scale="$(hypr_json | jq -r --arg n "$name" '.[] | select(.name == $n) | .scale')"
  edit_layout --arg d "$desc" --arg k "$(layout_key "$scale")" --arg p "$pos" '.[$d] = ((.[$d] // {}) + { key: $k, pos: $p })'
}

# Drops the kept position; the remembered mode (DisplayPrompt) stays.
reset_layout() {
  [ -s "$layout_file" ] || return 0
  edit_layout --arg d "$(sink_desc)" 'if .[$d].mode? then .[$d] = { mode: .[$d].mode } else del(.[$d]) end'
}

# The new-display prompt's choice for this screen, beside its kept position. The key is the EDID
# description Hyprland reports (make + model + serial): one entry per physical screen, any port.
remember_mode() {
  local desc
  [[ "${1:-}" =~ ^(extend|mirror|laptop|external)$ ]] || usage
  desc="$(sink_desc_or_die)"
  edit_layout --arg d "$desc" --arg m "$1" '.[$d] = ((.[$d] // {}) + { mode: $m })'
}

# {"name", "label" (EDID model), "mode" ("" = never chosen)} for DisplayPrompt; nothing when Hyprland lacks the output.
recall_mode() {
  local desc mode=""
  desc="$(sink_desc)"
  if [ -n "$desc" ] && [ -s "$layout_file" ]; then
    mode="$(jq -r --arg d "$desc" '.[$d].mode? // ""' "$layout_file" 2>/dev/null || true)"
  fi
  hypr_json | jq -c --arg n "$name" --arg m "$mode" \
    '.[] | select(.name == $n) | { name, label: ([.model, .description, $n] | map(select(. != null and . != "")) | first), mode: $m }'
}

# True when the live output already matches this sink's committed layout.
# HDMI-A-1 is reused: an enabled port with the UltraFine's x/y must not
# count as "already set up" after the Dell EDID appears (or the reverse).
live_layout_ok() {
  local fields pos scale
  fields="$(layout_fields)"
  case "$fields" in
  *'position = "auto"'*) return 0 ;;
  esac
  pos="$(printf '%s' "$fields" | sed -n 's/.*position = "\([^"]*\)".*/\1/p')"
  scale="$(printf '%s' "$fields" | sed -n 's/.*scale = \([^, ]*\).*/\1/p')"
  [ -n "$pos" ] && [ -n "$scale" ] || return 1
  hypr_json | jq -e --arg n "$name" --arg pos "$pos" --arg scale "$scale" '
    .[] | select(.name == $n and .disabled != true)
    | (((.x // 0) | tostring) + "x" + ((.y // 0) | tostring)) == $pos
      and ((.scale - ($scale | tonumber)) | fabs) < 0.02
  ' >/dev/null
}

eval_monitor() {
  hyprctl eval "hl.monitor({ output = \"$name\", $1 })" >/dev/null 2>&1 || true
}

off_hdmi() {
  eval_monitor "disabled = true"
  # Unplugged (not just switched off with the cable in): the next enable is a new display again.
  if ! drm_connected && [ -e "$seen_file" ]; then
    rm -f "$seen_file"
    timeout 2 qs -c remix ipc --any-display call display unplugged "$name" >/dev/null 2>&1 || true
  fi
}

# Aurora's kernel reports a crashed DCP's connector disconnected (dcp_rtk_crashed): the settle's
# sysfs check keeps it off, no journal parsing (fairydust's dcp_crashed matched nothing there).
on_hdmi() {
  eval_monitor "disabled = false, $(layout_fields)"
}

bump_gen() {
  local n=1
  [ -s "$gen_file" ] && n=$(($(tr -d '[:space:]' <"$gen_file") + 1))
  mkdir -p "$(dirname "$gen_file")"
  printf '%s\n' "$n" >"$gen_file"
  printf '%s\n' "$n"
}

stale() {
  [ "$(tr -d '[:space:]' <"$gen_file" 2>/dev/null || true)" != "$1" ]
}

# Tell Quickshell's DisplayPrompt (asks, or applies the remembered mode) once per plug. At login the shell
# may still be starting: a few tries.
announce_plug() {
  [ -e "$seen_file" ] && return 0
  : >"$seen_file"
  local i
  for i in 1 2 3 4 5; do
    timeout 2 qs -c remix ipc --any-display call display plugged "$name" >/dev/null 2>&1 && return 0
    sleep 1
  done
  return 0
}

# ---- Display modes (DisplayPrompt) ----
# A mirror target is no output of its own (`mirrorOf` = its source).
mirrored() {
  hypr_json | jq -e --arg n "$name" '.[] | select(.name == $n and .disabled != true) | (.mirrorOf // "none") != "none"' >/dev/null
}
extended() { is_enabled && ! mirrored; }
edp_enabled() {
  hypr_json | jq -e '.[] | select(.name == "eDP-1" and .disabled != true)' >/dev/null
}
# DRM scans out (what asahi-clamshell's external_up reads): eDP-1 may go dark only onto this.
lit() { grep -qsx enabled "$drm_path"/card*-"$name"/enabled; }
# Hyprland applies an eval on its next frame, a modeset / reload takes longer: poll up to $wait_s.
wait_for() {
  local i
  for ((i = 0; i < wait_s * 4; i++)); do
    "$@" && return 0
    sleep 0.25
  done
  "$@"
}
refuse() {
  echo "$*" >&2
  exit 1
}

# extend = the plugged-in state asahi-hdmi sets up. The other modes start from it (DisplayPrompt runs
# extend first when switching between two of them), so each is one step and never leaves zero outputs.
set_mode() {
  if [ "$1" = extend ]; then
    # eDP-1 back, unless the lid really is shut (then the clamshell flag is what keeps it from suspending).
    if "$clamshell" status && ! lid_closed; then "$clamshell" open; fi
    if mirrored; then
      hyprctl reload >/dev/null  # the Monitors pane's unmirror: wipes the mirror eval, config.reloaded syncs
    elif ! is_enabled; then
      bump_gen >/dev/null
      on_hdmi
    fi
    wait_for extended || refuse "$name did not come back"
    return 0
  fi
  # A remembered mode runs right after `added`'s enable eval: give Hyprland its frame.
  wait_for extended && ! "$clamshell" status || refuse "extend first"
  case "$1" in
  mirror)
    edp_enabled || refuse "built-in display is off"   # the mirror source
    eval_monitor 'mirror = "eDP-1"'                     # mirror only: no mode / position (see MonitorsPane)
    ;;
  laptop)
    edp_enabled || refuse "built-in display is off"   # never zero outputs
    bump_gen >/dev/null                                # a pending settle must not turn it back on
    off_hdmi
    ;;
  external)
    # asahi-clamshell close onto an unlit external takes the lid-closed path (lock); wait for the modeset.
    wait_for lit || refuse "$name is not lit"
    "$clamshell" close
    ;;
  esac
}

after_settle() {
  local gen="$1"
  sleep "$settle_s"
  stale "$gen" && return 0
  if drm_connected; then
    on_hdmi
  else
    off_hdmi
  fi
}

case "$action" in
off | removed)
  bump_gen >/dev/null
  off_hdmi
  ;;
on)
  on_hdmi
  ;;
added)
  gen="$(bump_gen)"
  after_settle "$gen"
  if ! stale "$gen" && drm_connected; then announce_plug; fi
  ;;
sync)
  if drm_connected; then
    if is_enabled && live_layout_ok; then
      :
    elif is_enabled; then
      on_hdmi
    else
      # Enabled here (an `added` racing this sync went stale): announce it like `added` would (once per plug).
      gen="$(bump_gen)"
      after_settle "$gen"
      if ! stale "$gen" && drm_connected; then announce_plug; fi
    fi
  else
    bump_gen >/dev/null
    off_hdmi
  fi
  ;;
place)
  # Scale and position in one eval. A position-only update keeps the live
  # scale, so the 1.25 anchor (-2048) on a scale-1 Dell overlaps eDP-1.
  fields="$(layout_fields)"
  pos="$(printf '%s' "$fields" | sed -n 's/.*position = "\([^"]*\)".*/\1/p')"
  scale="$(printf '%s' "$fields" | sed -n 's/.*scale = \([^, ]*\).*/\1/p')"
  if [[ "$pos" =~ ^-?[0-9]+x-?[0-9]+$ ]] && [[ "$scale" =~ ^[0-9.]+$ ]] && is_enabled; then
    eval_monitor "position = \"$pos\", scale = $scale"
  fi
  ;;
save)
  save_layout "${3:-}"
  ;;
reset)
  reset_layout
  ;;
mode)
  [[ "${3:-}" =~ ^(extend|mirror|laptop|external)$ ]] || usage
  drm_connected || refuse "$name is not connected"
  set_mode "$3"
  ;;
remember)
  remember_mode "${3:-}"
  ;;
recall)
  recall_mode
  ;;
*)
  usage
  ;;
esac
