#!/usr/bin/env bash
# Drive kbd_backlight from the AOP ambient light sensor: on in the dark,
# off in a bright room. Manual Search/LaunchA (or any other LED write)
# pauses auto until lux moves enough. Lock, lid-close, eDP DPMS-off and
# idle dim pause without treating idle-brightness writes as an override.
# Level follows log(lux) (perceived light), 100 % at DARK_LUX down to 0 % at BRIGHT_LUX.
# Hysteresis: a level is re-derived only after lux moved max(5, 25 %) from the
# last decision, and only when two readings in a row agree (a hand shadow is one).
# Changes fade (fade_brightness). A steady tick forks nothing but sleep: sysfs
# reads only, lock check only before a write.

set -euo pipefail

. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/common.sh"

POLL_SECONDS=5
DARK_LUX=8
BRIGHT_LUX=180
DEADBAND_PERCENT=4
OVERRIDE_LUX_DELTA=20
OVERRIDE_LUX_RATIO=40
HYST_LUX_DELTA=5
HYST_LUX_RATIO=25
LID_CLOSED_ANGLE=30

available_only=0
map_lux=""

usage() {
  echo "usage: $0 [--available|--map-lux N]" >&2
  exit 2
}

while (($#)); do
  case "$1" in
    --available)
      available_only=1
      shift
      ;;
    --map-lux)
      if [[ -z ${2:-} ]]; then
        usage
      fi
      map_lux=$2
      shift 2
      ;;
    -h|--help)
      echo "usage: $0 [--available|--map-lux N]"
      exit 0
      ;;
    *)
      usage
      ;;
  esac
done

# lux_pct[lux] for 0..BRIGHT_LUX, one awk at startup (bash has no log).
lux_table() {
  mapfile -t lux_pct < <(awk -v d="$DARK_LUX" -v b="$BRIGHT_LUX" \
    'BEGIN { for (l = 0; l <= b; l++) printf "%d\n", (l <= d ? 100 : 100 * log(b / l) / log(b / d)) + 0.5 }')
}

# Sets percent (no subshell).
lux_to_percent() {
  if (($1 >= BRIGHT_LUX)); then
    percent=0
  else
    percent=${lux_pct[$1]}
  fi
}

# True when to is at least max(delta, ratio % of from) away from from.
lux_moved() {
  local from=$1 threshold=$3 delta=$(($2 - $1))
  delta=${delta#-}
  if ((from * $4 / 100 > threshold)); then
    threshold=$((from * $4 / 100))
  fi
  ((delta >= threshold))
}

# This and the previous reading both moved past the band, on the same side.
lux_settled() {
  lux_moved "$1" "$lux" "$2" "$3" && lux_moved "$1" "$prev_lux" "$2" "$3" \
    && (((lux > $1) == (prev_lux > $1)))
}

lux_table

if [[ -n $map_lux ]]; then
  if [[ ! $map_lux =~ ^[0-9]+$ ]]; then
    echo "lux must be a non-negative integer" >&2
    exit 1
  fi
  lux_to_percent "$map_lux"
  echo "$percent"
  exit 0
fi

find_als() {
  local d name
  local iio_devices_dir=${ASAHI_IIO_DEVICES_DIR:-/sys/bus/iio/devices}

  # Prefer a device that names itself as ALS. Apple AOP exposes the lid-angle
  # sensor (aop-sensors-las) next to the illuminance sensor (aop-sensors-als).
  for d in "$iio_devices_dir"/iio:device*; do
    [[ -r $d/name ]] || continue
    name=$(<"$d/name")
    [[ $name == *als* ]] || continue
    if [[ -r $d/in_illuminance_input ]]; then
      printf '%s\n' "$d/in_illuminance_input"
      return 0
    fi
    if [[ -r $d/in_illuminance_raw ]]; then
      printf '%s\n' "$d/in_illuminance_raw"
      return 0
    fi
  done

  for d in "$iio_devices_dir"/iio:device*; do
    if [[ -r $d/in_illuminance_input ]]; then
      printf '%s\n' "$d/in_illuminance_input"
      return 0
    fi
    if [[ -r $d/in_illuminance_raw ]]; then
      printf '%s\n' "$d/in_illuminance_raw"
      return 0
    fi
  done
  return 1
}

find_kbd() {
  local candidate
  local leds_dir=${ASAHI_LEDS_DIR:-/sys/class/leds}

  for candidate in "$leds_dir"/*kbd_backlight*; do
    if [[ -e $candidate/brightness && -r $candidate/max_brightness ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

find_las() {
  local d name
  local iio_devices_dir=${ASAHI_IIO_DEVICES_DIR:-/sys/bus/iio/devices}

  for d in "$iio_devices_dir"/iio:device*; do
    [[ -r $d/name ]] || continue
    name=$(<"$d/name")
    [[ $name == *las* ]] || continue
    if [[ -r $d/in_angl_raw ]]; then
      printf '%s\n' "$d/in_angl_raw"
      return 0
    fi
    if [[ -r $d/in_angl_input ]]; then
      printf '%s\n' "$d/in_angl_input"
      return 0
    fi
  done
  return 1
}

als_path=$(find_als || true)
kbd_path=$(find_kbd || true)

if [[ $available_only == 1 ]]; then
  if [[ -n $als_path && -n $kbd_path ]]; then
    exit 0
  else
    exit 1
  fi
fi

if [[ -z $als_path || -z $kbd_path ]]; then
  exit 0
fi

device=$(basename "$kbd_path")
max=$(<"$kbd_path/max_brightness")
if [[ ! $max =~ ^[1-9][0-9]*$ ]]; then
  exit 0
fi

last_set=""
paused=0
pause_lux=0
decided_lux=""
seen_lux=""

session_locked() {
  local hint session
  session=${XDG_SESSION_ID:-}
  if [[ -n $session ]]; then
    hint=$(loginctl show-session "$session" -p LockedHint --value 2>/dev/null || true)
    if [[ $hint == yes ]]; then
      return 0
    fi
  fi
  hyprlock_running
}

# Lid-angle sensor path, cached across ticks (find_las forks). Not common.sh's lid_closed (logind, forks busctl).
las_path=""
lid_angle_closed() {
  local raw
  if [[ ! -r ${las_path:-} ]]; then
    las_path=$(find_las || true)
  fi
  if [[ -z $las_path ]]; then
    return 1
  fi
  read -r raw <"$las_path" || return 1
  raw=${raw%%.*}
  if [[ ! $raw =~ ^-?[0-9]+$ ]]; then
    return 1
  fi
  ((raw < LID_CLOSED_ANGLE))
}

# asahi-idle-brightness holds saved levels while idle-dimmed/off.
idle_dimmed() {
  compgen -G "${XDG_RUNTIME_DIR:-/tmp}/asahi-idle-brightness/*" >/dev/null
}

# Hyprland DPMS off disables the aquamarine output: the eDP connector reads `disabled`.
internal_display_off() {
  local f state
  for f in "${ASAHI_DRM_DIR:-/sys/class/drm}"/card*-eDP-*/enabled; do
    [[ -r $f ]] || continue
    read -r state <"$f" || continue
    if [[ $state == disabled ]]; then
      return 0
    fi
  done
  return 1
}

tick() {
  local raw current target delta now

  read -r raw <"$als_path" || return 0
  lux=${raw%%.*}
  if [[ ! $lux =~ ^[0-9]+$ ]]; then
    return 0
  fi
  prev_lux=${seen_lux:-$lux}
  seen_lux=$lux

  # Pause without rewriting last_set so idle-brightness off/restore and the
  # lid bind do not look like a manual override when the session comes back.
  if lid_angle_closed || idle_dimmed || internal_display_off; then
    return 0
  fi

  read -r current <"$kbd_path/brightness" || return 0

  if [[ -n $last_set && $current != "$last_set" ]]; then
    paused=1
    pause_lux=$lux
    last_set=$current
    return 0
  fi

  if ((paused)); then
    if ! lux_settled "$pause_lux" "$OVERRIDE_LUX_DELTA" "$OVERRIDE_LUX_RATIO"; then
      return 0
    fi
    paused=0
  elif [[ -n $decided_lux ]] && ! lux_settled "$decided_lux" "$HYST_LUX_DELTA" "$HYST_LUX_RATIO"; then
    return 0
  fi

  lux_to_percent "$lux"
  target=$((max * percent / 100))
  delta=$((current - target))
  delta=${delta#-}
  # A bright room is always off: 2 % keys must not hide inside the deadband.
  if ((target > 0 && delta * 100 < max * DEADBAND_PERCENT)); then
    last_set=$current
    decided_lux=$lux
    return 0
  fi

  # Forks: only on an actual change. Retried next tick while locked.
  if session_locked; then
    return 0
  fi
  # asahi-idle-brightness's lock: an idle off/restore or a key press must not interleave with our
  # fade. Whatever wrote the LED while we waited wins; the next tick sorts it out.
  {
    flock -w 2 9 || true
    read -r now <"$kbd_path/brightness" || return 0
    if idle_dimmed || [[ $now != "$current" ]]; then
      return 0
    fi
    fade_brightness "$device" "$current" "$target"
  } 9>"$(brightness_lock)"
  read -r last_set <"$kbd_path/brightness" || last_set=$target
  decided_lux=$lux
}

tick

# Paths are cached; rediscover only when one disappears (driver reload, resume).
while true; do
  sleep "$POLL_SECONDS"
  if [[ ! -r $als_path || ! -r $kbd_path/max_brightness ]]; then
    als_path=$(find_als || true)
    kbd_path=$(find_kbd || true)
    if [[ -z $als_path || -z $kbd_path ]]; then
      continue
    fi
    device=$(basename "$kbd_path")
    max=$(<"$kbd_path/max_brightness")
  fi
  if [[ ! $max =~ ^[1-9][0-9]*$ ]]; then
    continue
  fi
  tick
done
