#!/usr/bin/env bash
# Session-scoped idle inhibit flag (cleared by reboot, lives in XDG_RUNTIME_DIR).
#
#   asahi-stay-awake toggle
#   asahi-stay-awake status            exit 0 when awake mode is on
set -u
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/common.sh"

flag="$(runtime_dir)/asahi-stay-awake"

case "${1:-status}" in
  toggle) if [ -e "$flag" ]; then rm -f "$flag"; else : >"$flag"; fi ;;
  status) [ -e "$flag" ] ;;
  *)
    echo "usage: asahi-stay-awake {toggle|status}" >&2
    exit 2
    ;;
esac
