#!/usr/bin/env bash
# Secret Service for Hyprland. SSH stays with keychain (asahi-ssh-keychain).
# The login keyring password is the login password. pam_gnome_keyring in
# /etc/pam.d/login unlocks it at the tty1 prompt (auth + session auto_start).
# Do not create an empty-password keyring: that skips the prompt and leaves
# the secrets readable by anyone who can read the files.
set -euo pipefail

dir="${XDG_DATA_HOME:-$HOME/.local/share}/keyrings"
mkdir -p "$dir"
chmod 700 "$dir"

# Drop leftover ksecretd so gnome-keyring can own org.freedesktop.secrets.
if pgrep -x ksecretd >/dev/null 2>&1 || pgrep -x kwalletd6 >/dev/null 2>&1; then
  killall ksecretd kwalletd6 2>/dev/null || true
fi

# Fedora's user unit is pkcs11,secrets (no ssh). Start it for this session only;
# do not enable WantedBy=default.target. PAM auto_start is what unlocks the
# login keyring; this only covers a session that was already logged in.
if command -v gnome-keyring-daemon >/dev/null 2>&1; then
  if systemctl --user start gnome-keyring-daemon.service 2>/dev/null; then
    :
  else
    gnome-keyring-daemon --start --components=secrets,pkcs11 >/dev/null
  fi
fi
