#!/usr/bin/env python3
"""Generate and apply an Asahi desktop theme from a wallpaper image.

Inspired by prettyletto/omagen: image → representatives → semantic palette →
Quickshell / Ghostty / Firefox / Hyprland.
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import sys
from pathlib import Path

DOTFILES = Path(os.environ.get("DOTFILES", Path.home() / ".dotfiles")).resolve()
THEME_ROOT = DOTFILES / "asahi"
if str(THEME_ROOT) not in sys.path:
    sys.path.insert(0, str(THEME_ROOT))

from theme.extract import extract_representatives  # noqa: E402
from theme.palette import FLAVORS, build_palette  # noqa: E402
from theme.apply import apply_live, preview_ghostty, state_dir, write_all  # noqa: E402


def resolve_wallpaper(explicit: str | None) -> Path:
    if explicit:
        path = Path(explicit).expanduser().resolve()
        if not path.is_file():
            raise SystemExit(f"wallpaper not found: {path}")
        return path

    # The image on screen (Quickshell's choice) first, then the last one themed.
    for saved_file in (state_dir().parent / "quickshell" / "wallpaper.conf", state_dir() / "wallpaper"):
        saved = saved_file.read_text(encoding="utf-8").strip() if saved_file.is_file() else ""
        if saved and Path(saved).is_file():
            return Path(saved)

    raise SystemExit("no wallpaper path given and none saved in state")


def saved_variant() -> str:
    # colors.json records the flavour, so a bare run (login autostart) keeps it.
    colors = state_dir() / "colors.json"
    variant = json.loads(colors.read_text(encoding="utf-8")).get("variant") if colors.is_file() else None
    return variant if variant in FLAVORS else "source"


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("wallpaper", nargs="?", help="image path (default: current wallpaper)")
    parser.add_argument(
        "--variant",
        choices=tuple(FLAVORS),
        help="flavour: how strong and how colorful (matugen scheme-* analogue; default: the saved one, else source)",
    )
    parser.add_argument(
        "--mode",
        default="auto",
        choices=("auto", "dark", "light"),
        help="force dark/light instead of deriving it from wallpaper lightness",
    )
    parser.add_argument("--dry-run", action="store_true", help="print palette JSON only")
    parser.add_argument(
        "--preview",
        action="store_true",
        help="print palette JSON and retheme Ghostty only (asahi-adaptive + CSS + reload-config; no GTK/Firefox/colors.json)",
    )
    parser.add_argument("--no-apply", action="store_true", help="write files but skip live apply")
    parser.add_argument("--json", action="store_true", help="print colors.json to stdout")
    args = parser.parse_args()

    if not args.dry_run:
        # One theme write at a time (login autostart, picker, flavour chip): the fd stays open,
        # so the lock is held until this process exits.
        fcntl.flock(os.open(state_dir() / ".lock", os.O_CREAT | os.O_RDWR, 0o644), fcntl.LOCK_EX)

    wallpaper = resolve_wallpaper(args.wallpaper)
    reps = extract_representatives(str(wallpaper))
    palette = build_palette(reps, str(wallpaper), variant=args.variant or saved_variant(), mode=args.mode)

    if args.dry_run or args.preview:
        if args.preview:
            preview_ghostty(palette)
        print(json.dumps(palette.to_dict(), indent=2, sort_keys=True))
        return 0

    paths = write_all(palette)
    if not args.no_apply:
        apply_live(palette)

    if args.json:
        print(paths["colors_json"].read_text(encoding="utf-8"), end="")
    else:
        print(f"theme: {palette.mode}/{palette.variant} from {wallpaper.name}")
        print(f"  accent={palette.accent} bg={palette.background} fg={palette.foreground}")
        print(f"  state={state_dir()}")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
