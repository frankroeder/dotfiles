#!/usr/bin/env bash
# Fedora Asahi / Aurora Remix health report. Apple Silicon only.
# Usage: asahi-debug [--json]
#
# Path prefixes (tests): ASAHI_DIAG_ROOT, ASAHI_PROC_ROOT, ASAHI_SYS_ROOT;
# ASAHI_UNAME_R pins the kernel release.
# Empty diag root means the real filesystem. Does not require pacman, iwd,
# SDDM, or a running Hyprland — those are Arch/omarchy product checks.

set -uo pipefail

json=false
for arg in "$@"; do
  case "$arg" in
    --json) json=true ;;
    -h | --help)
      echo "usage: $0 [--json]" >&2
      exit 2
      ;;
    *)
      echo "usage: $0 [--json]" >&2
      exit 2
      ;;
  esac
done

diag_root="${ASAHI_DIAG_ROOT:-}"
proc_root="${ASAHI_PROC_ROOT:-/proc}"
sys_root="${ASAHI_SYS_ROOT:-/sys}"

# Aurora Fedora Remix renames the kernel, audio and Mesa packages.
aurora=false
grep -qs '^VARIANT_ID=aurora' "$diag_root/etc/os-release" && aurora=true

pass_count=0
fail_count=0
warn_count=0
skip_count=0
results=()

record() {
  local status=$1 id=$2 detail=$3
  results+=("$status"$'\t'"$id"$'\t'"$detail")
  case $status in
    PASS) pass_count=$((pass_count + 1)) ;;
    FAIL) fail_count=$((fail_count + 1)) ;;
    WARN) warn_count=$((warn_count + 1)) ;;
    SKIP) skip_count=$((skip_count + 1)) ;;
  esac
}

diag_path() {
  printf '%s%s\n' "$diag_root" "$1"
}

require_apple_silicon() {
  local compat model
  if [[ $(/usr/bin/uname -m) != "aarch64" ]] && [[ -z ${ASAHI_PROC_ROOT:-} ]]; then
    echo "asahi-debug: this is not aarch64" >&2
    exit 2
  fi
  compat="$proc_root/device-tree/compatible"
  if [[ ! -r $compat ]] || ! grep -aq 'apple,' "$compat" 2>/dev/null; then
    echo "asahi-debug: this is not an Apple Silicon Mac" >&2
    exit 2
  fi
  model=$(tr -d '\0' <"$proc_root/device-tree/model" 2>/dev/null)
  record PASS platform "${model:-Apple Silicon Mac}"
}

rpm_query() {
  rpm -q "$1" 2>/dev/null || true
}

check_fedora() {
  local osrel
  osrel=$(diag_path /etc/os-release)
  if [[ ! -r $osrel ]]; then
    record FAIL fedora-release "/etc/os-release is missing"
    return
  fi
  if grep -qi -E 'asahi|aurora' "$osrel"; then
    record PASS fedora-asahi "$(grep -E '^(PRETTY_NAME|VARIANT)=' "$osrel" | head -1 | tr -d '"')"
  else
    record FAIL fedora-asahi "/etc/os-release does not identify Fedora Asahi or Aurora Remix"
  fi
}

check_kernel() {
  local release q pkg=kernel-16k
  $aurora && pkg=kernel-aurora-core
  release=${ASAHI_UNAME_R:-$(/usr/bin/uname -r)}
  if [[ $release == *asahi* || $release == *aurora* ]]; then
    record PASS kernel "$release"
  else
    record FAIL kernel "uname -r is '$release' (expected an asahi or aurora kernel)"
  fi
  q=$(rpm_query "$pkg")
  if [[ $q == "$pkg"-* ]]; then
    record PASS pkg-kernel "$q"
  elif [[ -n ${ASAHI_DIAG_ROOT:-} ]]; then
    record SKIP pkg-kernel "rpm not mocked"
  else
    record WARN pkg-kernel "$pkg is not installed"
  fi
  # Aurora: m1n1 Stage 2 DTBs older than the kernel's (old fairydust pin) lack the sep alias: no Touch ID.
  if $aurora; then
    if [[ -e $proc_root/device-tree/aliases/sep ]]; then
      record PASS stage2-dtb "m1n1 Stage 2 carries Aurora DTBs (sep alias present)"
    else
      record WARN stage2-dtb "m1n1 Stage 2 DTBs predate Aurora (no sep alias, Touch ID off): remove pre-Aurora kernels, sudo update-m1n1, reboot"
    fi
  fi
}

# Aurora's own services this setup relies on, and an enrolled Touch ID finger.
check_aurora() {
  $aurora || return 0
  if [[ -n $diag_root ]]; then
    record SKIP aurora-services "systemctl not consulted"
    return
  fi
  local u bad=()
  for u in aurora-peripherals.service aurora-sep.service aurora-touchid-rearm.socket aurora-stage2-commit.service \
    aurora-kbd-light.service; do
    systemctl is-active --quiet "$u" || bad+=("$u")
  done
  systemctl --user is-active --quiet aurora-camera-denoise.service || bad+=("aurora-camera-denoise (user)")
  if ((${#bad[@]})); then
    record WARN aurora-services "not active: ${bad[*]}"
  else
    record PASS aurora-services "peripherals, SEP, Touch ID re-arm, Stage 2 commit, kbd light, camera denoise"
  fi
  compgen -G "$proc_root/device-tree/soc/*/fingerprint@*" >/dev/null || return 0
  local prints
  prints=$(fprintd-list "$USER" 2>/dev/null)
  if grep -q ' - #' <<<"$prints"; then
    record PASS touchid "finger enrolled ($(systemctl is-active aurora-fido.service 2>/dev/null) security key)"
  elif grep -q 'No devices available' <<<"$prints"; then   # libfprint hides the reader under a closed lid
    record SKIP touchid "reader under the closed lid: fingers not checked"
  else
    record WARN touchid "no finger enrolled (./install.sh asahi-touchid)"
  fi
}

# Watch list (asahi/CLAUDE.md "Aurora watch list"): upstream pieces this setup waits for. SKIP while absent, WARN once
# one arrives and something here should change.
check_watch() {
  $aurora || return 0
  if [ ! -e "$diag_root/dev/sep-key" ]; then
    record SKIP watch-sep-key "no /dev/sep-key yet (aurora-fido keeps the sealed store)"
  elif aurora-fido status 2>/dev/null | grep -q 'key store: *sealed'; then
    record WARN watch-sep-key "/dev/sep-key arrived: move passkeys off the sealed store (aurora-fido status / re-enrol)"
  else
    record PASS watch-sep-key "/dev/sep-key present, aurora-fido reports no sealed store"
  fi
  if command -v aurora-sep-cryptenroll >/dev/null; then
    record WARN watch-touchid-luks "aurora-sep-cryptenroll is installed: Touch ID disk unlock may cover the root now"
  else
    record SKIP watch-touchid-luks "no aurora-sep-cryptenroll yet (Touch ID cannot unlock the root)"
  fi
  if hyprctl monitors -j 2>/dev/null | jq -e 'any(.[]; .name == "eDP-1" and .vrr)' >/dev/null 2>&1; then
    record PASS watch-vrr "eDP-1 runs VRR (ProMotion)"
  else
    record SKIP watch-vrr "no VRR on eDP-1 yet (the kernel marks it incapable; monitors.lua already asks)"
  fi
}

# Thunderbolt: DP and USB3 tunnels need no approval, a TB3 dock's USB / Ethernet (PCIe) does (bolt).
check_thunderbolt() {
  command -v boltctl >/dev/null || return 0
  local waiting
  waiting=$(boltctl list 2>/dev/null | grep -cE 'status: +(connected|auth-error)')
  if ((waiting)); then
    record WARN thunderbolt "$waiting device(s) await approval: boltctl list, then boltctl enroll --policy auto <uuid>"
  else
    record PASS thunderbolt "nothing awaits approval"
  fi
}

# Root on LUKS (README "Disk encryption", fresh Aurora image or AsahiLocker), and no disk secret left on the
# unencrypted /boot: Aurora's temporary first-boot key, or a LUKS header copy (old passphrases still open it).
check_encryption() {
  local src chain f
  if [[ -n $diag_root ]] && [[ -z ${ASAHI_DIAG_LSBLK:-} ]]; then
    record SKIP root-encrypted "lsblk not consulted"
  else
    src=$(findmnt -no SOURCE / 2>/dev/null) src=${src%%\[*}
    chain=$(lsblk -rno FSTYPE -s "$src" 2>/dev/null)
    if grep -qx crypto_LUKS <<<"$chain"; then
      record PASS root-encrypted "root on LUKS"
    else
      record WARN root-encrypted "root is not encrypted (README: Disk encryption)"
    fi
  fi
  for f in /boot/omarchy/luks-key /boot/luks-header-backup.img; do
    [ -e "$diag_root$f" ] && record WARN boot-secrets "$f on the unencrypted /boot: keep a copy offline, then delete it"
  done
  return 0
}

# Touch ID shares the Secure Enclave's anti-replay state with macOS: a wrong write can leave FileVault macOS unable to
# unlock (DFU restore). Aurora's xART guard (default 1 on M2 / M3) refuses to rewrite records Linux did not create.
check_xart() {
  local d guard refusals matching
  for d in "$sys_root"/devices/platform/soc/*.sep/diag; do [ -r "$d/xart_guard" ] && break; done
  [ -r "$d/xart_guard" ] || return 0
  guard=$(cat "$d/xart_guard") refusals=$(cat "$d/xart_guard_refusals" 2>/dev/null || echo 0)
  matching=$(cat "$d/matching" 2>/dev/null)   # usable / unverified (steady state under the guard) / blocked
  if [ "$guard" = 0 ] && ! grep -qs 'apple,t8103\|apple,t600[01]' "$proc_root/device-tree/compatible"; then
    record WARN xart-guard "off: a bad shared SEP write could cost FileVault macOS a DFU restore (README, Touch ID and macOS)"
  elif [ "${refusals:-0}" != 0 ]; then
    record WARN xart-guard "refused $refusals write(s): Touch ID may fail (after a rollback / reinstall: sudo aurora-xart reset-touchid)"
  elif [ "$matching" = blocked ]; then
    record WARN xart-guard "matching blocked: a Touch ID match cannot save its state (journalctl -u aurora-sep-ready; XART-SAFETY.md)"
  else
    record PASS xart-guard "level $guard, ${refusals:-0} refused${matching:+, matching $matching}"
  fi
}

check_packages() {
  local pkg q
  local pkgs=(speakersafetyd asahi-audio pipewire wireplumber NetworkManager mesa-vulkan-drivers)
  $aurora && pkgs=(speakersafetyd aurora-audio pipewire wireplumber NetworkManager mesa-aurora-vulkan-drivers)
  for pkg in "${pkgs[@]}"; do
    q=$(rpm_query "$pkg")
    if [[ $q == "$pkg"-* ]]; then
      record PASS "pkg-$pkg" "$q"
    elif [[ -n ${ASAHI_DIAG_ROOT:-} ]] && ! command -v rpm >/dev/null 2>&1; then
      record SKIP "pkg-$pkg" "rpm is not available"
    else
      record FAIL "pkg-$pkg" "package $pkg is not installed"
    fi
  done
}

check_wifi_backend() {
  local printed
  printed=$(NetworkManager --print-config 2>/dev/null || true)
  if grep -q 'wifi.backend=wpa_supplicant' <<<"$printed"; then
    record PASS wifi-backend "NetworkManager uses wpa_supplicant (Fedora Asahi default)"
  elif grep -q 'wifi.backend=iwd' <<<"$printed"; then
    record WARN wifi-backend "NetworkManager uses iwd — that is the Arch/omarchy path, not Fedora Asahi"
  elif [[ -n $printed ]]; then
    record WARN wifi-backend "NetworkManager did not report a wifi.backend (wpa_supplicant is the Fedora default)"
  else
    record SKIP wifi-backend "NetworkManager --print-config returned nothing"
  fi
}

check_wifi_powersave() {
  local conf
  conf=$(diag_path /etc/NetworkManager/conf.d/asahi-wifi-powersave.conf)
  if [[ -r $conf ]] && grep -qE 'wifi\.powersave[[:space:]]*=[[:space:]]*2' "$conf"; then
    record PASS wifi-powersave "asahi-wifi-powersave.conf disables idle naps"
  else
    record WARN wifi-powersave "no asahi-wifi-powersave.conf with wifi.powersave=2 (./install.sh asahi-system)"
  fi
}

check_wifi_link() {
  local status wifi_line device state
  status=$(nmcli -t -f DEVICE,TYPE,STATE device status 2>/dev/null || true)
  if [[ -z $status ]]; then
    record SKIP wifi-link "nmcli gave no answer"
    return
  fi
  wifi_line=$(awk -F: '$2 == "wifi" { print; exit }' <<<"$status")
  if [[ -z $wifi_line ]]; then
    record FAIL wifi-link "no Wi-Fi device is visible to NetworkManager"
    return
  fi
  device=${wifi_line%%:*}
  state=${wifi_line##*:}
  # The device being there is what matters (driver + firmware up); off or idle on purpose is fine.
  if [[ $state == "connected" ]]; then
    record PASS wifi-link "Wi-Fi device $device is connected"
  elif [[ $state == "disconnected" ]]; then
    record PASS wifi-link "Wi-Fi device $device is up, not connected"
  elif [[ $state == "unavailable" && $(nmcli radio wifi 2>/dev/null) == disabled ]]; then
    record PASS wifi-link "Wi-Fi device $device is present, radio switched off"
  else
    record WARN wifi-link "Wi-Fi device $device is $state"
  fi
}

check_audio() {
  local status effect_sink
  status=$(wpctl status 2>/dev/null || true)
  if [[ -z $status ]]; then
    record FAIL audio-dsp "wpctl returned nothing — PipeWire is not running"
  else
    effect_sink=$(sed -n '/Filters:/,/Streams:/p' <<<"$status" |
      grep -E 'audio_effect\..*\[Audio/Sink\]' | head -1 |
      sed 's/^[ │*.]*//; s/ *\[Audio\/Sink\].*$//; s/[0-9]*\. *//')
    if [[ -n $effect_sink ]]; then
      record PASS audio-dsp "Asahi DSP chain loaded: $effect_sink"
    else
      record FAIL audio-dsp "no audio_effect sink — the speaker DSP (aurora-audio / asahi-audio) did not load"
    fi
  fi

  if systemctl is-active --quiet speakersafetyd 2>/dev/null; then
    record PASS speakersafetyd "speaker protection service is active"
  else
    record FAIL speakersafetyd \
      "not active — speakers locked; sudo systemctl reset-failed speakersafetyd && sudo systemctl start speakersafetyd"
  fi

  # A non-MONO DSP mic (old asahi-audio: 1ch AUX0) reaches stereo recorders on the left only.
  if wpctl inspect @DEFAULT_AUDIO_SOURCE@ 2>/dev/null | grep -q 'audio.position = .*MONO'; then
    record PASS mic-mono "default source is MONO"
  else
    record WARN mic-mono "default source is not MONO — stereo recorders may get the mic on the left only"
  fi

  # Amps can lock (e.g. 96 kHz playback) while the service looks active; the kernel log says.
  local amps
  if [[ -n $diag_root ]]; then
    record SKIP speaker-volumes "kernel log not mocked"
  else
    amps=$(journalctl -k -b -q --no-pager -o cat -g 'Speaker volumes (un)?locked' 2>/dev/null | tail -n 1)
    if [[ $amps == *unlocked* ]]; then
      record PASS speaker-volumes "speaker amps unlocked"
    elif [[ -n $amps ]]; then
      record FAIL speaker-volumes "${amps#*: } — sudo systemctl reset-failed speakersafetyd && sudo systemctl start speakersafetyd"
    else
      record WARN speaker-volumes "no 'Speaker volumes' kernel message this boot"
    fi
  fi
}

check_rtc() {
  local local_rtc
  if [[ -n $diag_root ]]; then
    record SKIP rtc "timedatectl not mocked"
    return
  fi
  local_rtc=$(timedatectl show -p LocalRTC --value 2>/dev/null || true)
  case "$local_rtc" in
    no) record PASS rtc "RTC in UTC" ;;
    yes) record WARN rtc "RTC in local time (macOS keeps UTC; boots start hours off) — ./install.sh asahi-system" ;;
    *) record WARN rtc "timedatectl gave no LocalRTC answer" ;;
  esac
}

check_zram() {
  local algo
  algo=$(cat "$sys_root/block/zram0/comp_algorithm" 2>/dev/null || true)
  if [[ $algo == *"[zstd]"* ]]; then
    record PASS zram "zram0 uses zstd"
  else
    record WARN zram "zram0 is not zstd (${algo:-missing}) — ./install.sh asahi-system"
  fi
}

check_pipewire_rt() {
  local line
  line=$(ps -eLo comm,rtprio,cls 2>/dev/null | awk '$1 == "data-loop.0" && $2 == "20" && $3 == "RR" { print; exit }')
  if [[ -n $line ]]; then
    record PASS pipewire-rt "PipeWire data-loop thread is 20 RR"
  else
    record WARN pipewire-rt "no data-loop.0 thread at 20 RR (check the thread, not the process)"
  fi
}

check_bluetooth() {
  if systemctl is-active --quiet bluetooth 2>/dev/null; then
    record PASS bluetooth-service "bluetooth.service is active"
  else
    record WARN bluetooth-service "bluetooth.service is not active"
  fi
}

check_gpu() {
  local dri cards renders icd_dir icds
  dri=$(diag_path /dev/dri)
  cards=$(find "$dri" -maxdepth 1 -name 'card*' 2>/dev/null | grep -c '.' || true)
  renders=$(find "$dri" -maxdepth 1 -name 'renderD*' 2>/dev/null | grep -c '.' || true)
  if ((cards > 0 && renders > 0)); then
    record PASS gpu-drm "DRM nodes present ($cards card, $renders render)"
  else
    record FAIL gpu-drm "missing DRM nodes under /dev/dri ($cards card, $renders render)"
  fi

  icd_dir=$(diag_path /usr/share/vulkan/icd.d)
  icds=$(find "$icd_dir" -maxdepth 1 -name '*asahi*.json' 2>/dev/null | grep -c '.' || true)
  if ((icds > 0)); then
    record PASS gpu-vulkan "Asahi Vulkan ICD present ($icds)"
  else
    record FAIL gpu-vulkan "no asahi ICD under /usr/share/vulkan/icd.d"
  fi
}

check_backlight() {
  local bl brightness max
  bl=$(diag_path /sys/class/backlight/apple-panel-bl)
  if [[ -d $bl ]]; then
    brightness=$(cat "$bl/brightness" 2>/dev/null || true)
    max=$(cat "$bl/max_brightness" 2>/dev/null || true)
    record PASS backlight "apple-panel-bl present (brightness ${brightness:-?}/${max:-?})"
  else
    record FAIL backlight "no apple-panel-bl — display brightness control is missing"
  fi
}

check_battery() {
  local ps capacity battery_status
  ps=$(diag_path /sys/class/power_supply)
  if [[ -r $ps/macsmc-battery/capacity ]]; then
    capacity=$(cat "$ps/macsmc-battery/capacity" 2>/dev/null || true)
    battery_status=$(cat "$ps/macsmc-battery/status" 2>/dev/null || true)
    record PASS battery "macsmc-battery at ${capacity:-?}% (${battery_status:-unknown})"
  else
    record FAIL battery "the macsmc-battery power supply is missing"
  fi
}

check_hid() {
  local drivers fnmode magic
  drivers=$(diag_path /sys/bus/hid/drivers)
  if [[ -d $drivers/apple ]]; then
    record PASS hid-apple "hid_apple is bound"
  else
    record FAIL hid-apple "hid_apple is not bound under /sys/bus/hid/drivers"
  fi
  magic=$(modinfo -n hid_magicmouse 2>/dev/null || true)
  if [[ $magic == "(builtin)" ]]; then
    record PASS hid-magicmouse "hid_magicmouse is built in (Fedora Asahi)"
  elif [[ -d $drivers/magicmouse ]]; then
    record PASS hid-magicmouse "hid_magicmouse is bound"
  else
    record WARN hid-magicmouse "hid_magicmouse is neither builtin nor bound"
  fi
  fnmode=$(cat "$sys_root/module/hid_apple/parameters/fnmode" 2>/dev/null || true)
  if [[ $fnmode == "1" ]]; then
    record PASS hid-fnmode "fnmode=1 (media keys on the top row)"
  elif [[ -n $fnmode ]]; then
    record WARN hid-fnmode "fnmode=$fnmode (expected 1)"
  else
    record SKIP hid-fnmode "hid_apple fnmode sysfs is missing"
  fi
}

check_notch() {
  local notch
  notch=$(cat "$sys_root/module/appledrm/parameters/show_notch" 2>/dev/null || true)
  if [[ $notch == "Y" || $notch == "1" ]]; then
    record PASS notch "appledrm show_notch is on"
  elif [[ -n $notch ]]; then
    record WARN notch "appledrm show_notch=$notch (full panel needs 1 / reboot after asahi-notch.conf)"
  else
    record SKIP notch "appledrm is not loaded"
  fi
}

check_getty() {
  local dropin
  dropin=$(diag_path /etc/systemd/system/getty@tty1.service.d/10-asahi-autologin.conf)
  if [[ -f $dropin ]]; then
    record FAIL getty-autologin "leftover 10-asahi-autologin.conf (tty1 getty is the auth gate)"
  else
    record PASS getty-autologin "tty1 has no agetty --autologin drop-in"
  fi
  # Fedora 45 presets kmscon on the VTs: it holds the display's DRM master, so Hyprland cannot start.
  if [[ $(systemctl is-enabled kmsconvt@tty1.service 2>/dev/null) == enabled ]]; then
    record FAIL getty-kmscon "kmscon runs tty1 (Hyprland gets EBUSY on the display): ./install.sh asahi-getty, reboot"
  fi
}

check_keyring() {
  local pam plain
  pam=$(diag_path /etc/pam.d/login)
  if grep -q '^auth.*pam_gnome_keyring' "$pam" 2>/dev/null && grep -q '^session.*pam_gnome_keyring.*auto_start' "$pam"; then
    record PASS keyring-pam "pam_gnome_keyring unlocks the login keyring at tty1"
  else
    record FAIL keyring-pam "pam_gnome_keyring missing in /etc/pam.d/login (./install.sh asahi-system)"
  fi
  # Text keyrings ([keyring] header) store secrets unencrypted; the old startup script seeded one.
  plain=$(grep -lx '\[keyring\]' "$(diag_path "$HOME/.local/share/keyrings")"/*.keyring 2>/dev/null || true)
  if [[ -n $plain ]]; then
    record WARN keyring-plaintext "${plain//$'\n'/ } is unencrypted (move its items to login, then delete)"
  fi
}

check_sshd() {
  local enabled
  enabled=$(systemctl is-enabled sshd.service 2>/dev/null || true)
  if [[ $enabled == "masked" ]]; then
    record PASS sshd "sshd.service is masked"
  elif [[ -z $enabled ]]; then
    record SKIP sshd "systemctl did not report sshd.service"
  else
    record FAIL sshd "sshd.service is $enabled (Fedora enables it; ./install.sh asahi-sshd masks it)"
  fi
}

check_hibernate() {
  local conf
  conf=$(diag_path /etc/systemd/sleep.conf.d/10-asahi-no-hibernate.conf)
  if [[ -r $conf ]] && grep -q '^AllowHibernation=no' "$conf"; then
    record PASS hibernate "sleep drop-in forbids hibernate"
  else
    record WARN hibernate "no 10-asahi-no-hibernate.conf with AllowHibernation=no"
  fi
}

check_logind() {
  local conf udev unit
  conf=$(diag_path /etc/systemd/logind.conf.d/90-asahi-sleep.conf)
  udev=$(diag_path /etc/udev/rules.d/99-asahi-hdmi-lid-inhibit.rules)
  unit=$(diag_path /etc/systemd/system/asahi-hdmi-lid-inhibit.service)
  if [[ -r $conf ]] && grep -q '^LidSwitchIgnoreInhibited=no' "$conf" && [[ -f $udev && -f $unit ]]; then
    record PASS logind-lid "HDMI lid-inhibit installed"
  else
    record WARN logind-lid "HDMI lid-inhibit missing (./install.sh asahi-logind)"
  fi
}

check_charge_limit() {
  local udev unit
  udev=$(diag_path /etc/udev/rules.d/99-asahi-charge-limit.rules)
  unit=$(diag_path /etc/systemd/system/asahi-charge-limit.service)
  if [[ -f $udev && -f $unit ]]; then
    record PASS charge-limit "udev rule and oneshot are installed"
  else
    record WARN charge-limit "charge-limit udev/oneshot missing (./install.sh asahi-system)"
  fi
}

check_camera() {
  # Not any /dev/video*: on Aurora the AVD decoder is a video node too.
  if grep -qsx apple-isp "$sys_root"/class/video4linux/*/name; then
    record PASS camera "apple-isp camera present"
  else
    record WARN camera "no apple-isp video device — the camera stack is not active"
  fi
}

check_coredumps() {
  local dumps count summary
  if [[ -n $diag_root ]] || ! command -v coredumpctl >/dev/null 2>&1; then
    record SKIP coredumps "coredumpctl not consulted"
    return
  fi
  dumps=$(coredumpctl list --no-pager --no-legend --since=-7days 2>/dev/null \
    | awk '{ print $(NF-1) }' | grep -E '/(quickshell|qs|Hyprland|hyprlock|hypridle|hyprpaper|xdg-desktop-portal[^ ]*)$' \
    | sort | uniq -c | sort -rn)
  if [[ -z $dumps ]]; then
    record PASS coredumps "no desktop-stack coredumps in the last 7 days"
    return
  fi
  count=$(awk '{ s += $1 } END { print s + 0 }' <<<"$dumps")
  summary=$(awk '{ printf "%s x%s ", $2, $1 }' <<<"$dumps")
  record WARN coredumps "$count coredump(s) this week: ${summary% } (coredumpctl info <pid>)"
}

json_escape() {
  local value=$1
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  printf '%s' "$value"
}

print_report() {
  local line status id detail first
  if [[ $json == "true" ]]; then
    first=true
    printf '{\n  "checks": [\n'
    for line in "${results[@]}"; do
      IFS=$'\t' read -r status id detail <<<"$line"
      if [[ $first == "true" ]]; then
        first=false
      else
        printf ',\n'
      fi
      printf '    {"id": "%s", "status": "%s", "detail": "%s"}' \
        "$(json_escape "$id")" "$status" "$(json_escape "$detail")"
    done
    printf '\n  ],\n  "passed": %s,\n  "failed": %s,\n  "warnings": %s,\n  "skipped": %s\n}\n' \
      "$pass_count" "$fail_count" "$warn_count" "$skip_count"
    return
  fi
  for line in "${results[@]}"; do
    IFS=$'\t' read -r status id detail <<<"$line"
    printf '%-4s  %-21s %s\n' "$status" "$id" "$detail"
  done
  echo
  echo "$pass_count passed, $fail_count failed, $warn_count warnings, $skip_count skipped"
}

