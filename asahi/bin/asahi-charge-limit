#!/usr/bin/env bash
# Read or set the macsmc charge end threshold (Asahi equivalent of
# macOS `battery maintain 80`). Hibernate is not available; this is the
# health control that actually exists on this hardware.
#
# Usage: asahi-charge-limit [status|apply|80|100|<60-100>]

set -euo pipefail

supply_root="${ASAHI_POWER_SUPPLY_PATH:-/sys/class/power_supply}"
bat="${supply_root}/${ASAHI_BATTERY_DEVICE:-macsmc-battery}"
end_path="$bat/charge_control_end_threshold"
start_path="$bat/charge_control_start_threshold"
# The saved limit: boot applies it, the Battery pane shows it as "Saved". /var/lib/asahi is
# root:wheel 2775 (installer), so wheel users write it too.
system_state="${ASAHI_CHARGE_LIMIT_SYSTEM:-/var/lib/asahi/charge-limit}"

usage() {
  echo "usage: asahi-charge-limit [status|apply|80|100|<60-100>]" >&2
  exit 2
}

read_file() {
  if [ -r "$1" ]; then
    tr -d '\n' < "$1"
  else
    printf ""
  fi
}

clamp_end() {
  local n="$1"
  [ "$n" -lt 60 ] && n=60
  [ "$n" -gt 100 ] && n=100
  printf '%s' "$n"
}

chmod_sysfs() {
  local f p
  for f in charge_control_end_threshold charge_control_start_threshold charge_behaviour; do
    p="$bat/$f"
    [ -e "$p" ] || continue
    chgrp wheel "$p" 2>/dev/null || true
    chmod 664 "$p" 2>/dev/null || true
  done
}

write_state() {
  # temp + rename: needs only the (setgid wheel) dir writable, also over a root-owned 644 file.
  local tmp="$system_state.$$"
  mkdir -p "$(dirname "$system_state")"
  printf '%s\n' "$1" >"$tmp"
  mv -f "$tmp" "$system_state"
}

current_end() {
  local v
  v="$(read_file "$end_path")"
  case "$v" in
    '' | *[!0-9]*) printf '100' ;;
    *) printf '%s' "$v" ;;
  esac
}

desired_end() {
  local v
  v="$(read_file "$system_state")"
  case "$v" in
    '' | *[!0-9]*) printf "" ;;
    *) printf '%s' "$v" ;;
  esac
}

print_status() {
  local end start desired
  end="$(current_end)"
  start="$(read_file "$start_path")"
  desired="$(desired_end)"
  [ -z "$start" ] && start="$end"
  [ -z "$desired" ] && desired="$end"
  if [ "${1:-}" = "--json" ]; then
    jq -cn \
      --argjson end "$end" \
      --argjson start "${start:-0}" \
      --argjson desired "$desired" \
      '{end:$end, start:$start, desired:$desired}'
    return
  fi
  if [ "$end" -lt 100 ]; then
    printf 'hold %s%% (resume %s%%)\n' "$end" "$start"
  else
    printf 'full 100%%\n'
  fi
}

apply_end() {
  local end
  end="$(clamp_end "$1")"
  if [ ! -w "$end_path" ]; then
    if [ "$(id -u)" -eq 0 ]; then
      echo "asahi-charge-limit: cannot write $end_path" >&2
    else
      echo "asahi-charge-limit: sysfs not writable; run ./install.sh asahi-system (udev + oneshot)" >&2
    fi
    return 1
  fi
  if ! printf '%s\n' "$end" 2>/dev/null >"$end_path"; then
    echo "asahi-charge-limit: SMC refused $end%" >&2
    return 1
  fi
  if [ "$(current_end)" != "$end" ]; then
    echo "asahi-charge-limit: SMC reports $(current_end)%, wanted $end%" >&2
    return 1
  fi
  # Save only what the SMC took.
  write_state "$end"
  print_status
}

cmd="${1:-status}"
case "$cmd" in
  status|--json)
    if [ "$cmd" = "--json" ] || [ "${2:-}" = "--json" ]; then
      print_status --json
    else
      print_status
    fi
    ;;
  udev)
    chmod_sysfs
    ;;
  apply)
    [ "$(id -u)" -eq 0 ] && chmod_sysfs
    if [ -n "${2:-}" ]; then
      apply_end "$2"
    else
      want="$(desired_end)"
      [ -n "$want" ] || exit 0
      apply_end "$want"
    fi
    ;;
  '' | *[!0-9]*)
    usage
    ;;
  *)
    apply_end "$cmd"
    ;;
esac
