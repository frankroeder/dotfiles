#!/usr/bin/env bash
# shellcheck disable=SC2154  # read_value / read_number assign through printf -v

set -euo pipefail

supply_root="${ASAHI_POWER_SUPPLY_PATH:-/sys/class/power_supply}"
bat_path="${supply_root}/${ASAHI_BATTERY_DEVICE:-macsmc-battery}"
ac_path="${supply_root}/${ASAHI_AC_DEVICE:-macsmc-ac}"

# Builtin reads into a named variable (no fork per sysfs file).
# read_value <var> <path>: first line, or n/a when unreadable.
read_value() {
  local _v="n/a"
  if [ -r "$2" ]; then
    _v=""
    IFS= read -r _v < "$2" || true
  fi
  printf -v "$1" '%s' "$_v"
}

# read_number <var> <path>: like read_value, but 0 for missing/empty values.
read_number() {
  read_value "$1" "$2"
  case "${!1}" in '' | n/a) printf -v "$1" '0' ;; esac
}

format_wh() {
  awk -v value="$1" 'BEGIN { printf "%.1f Wh", value / 1000000 }'
}

format_w() {
  awk -v value="$1" 'BEGIN { if (value < 0) value = -value; printf "%.1f W", value / 1000000 }'
}

format_v() {
  awk -v value="$1" 'BEGIN { printf "%.2f V", value / 1000000 }'
}

format_a() {
  awk -v value="$1" 'BEGIN { if (value < 0) value = -value; printf "%.2f A", value / 1000000 }'
}

format_c() {
  awk -v value="$1" 'BEGIN { printf "%.1f °C", value / 10 }'
}

format_date_part() {
  case "$1" in
    '' | *[!0-9]*) printf "%s" "$1" ;;
    *) printf "%02d" "$((10#$1))" ;;
  esac
}

format_time() {
  local seconds="$1"
  local hours minutes

  if [ "$seconds" -le 0 ]; then
    printf "n/a"
    return
  fi

  hours=$((seconds / 3600))
  minutes=$(((seconds % 3600) / 60))
  printf "%dh %02dm" "$hours" "$minutes"
}

if [ ! -d "$bat_path" ]; then
  jq -cn '{text: "", tooltip: "", class: ["missing"], percentage: 0}'
  exit 0
fi

read_number capacity "$bat_path/capacity"
read_value status "$bat_path/status"
read_value capacity_level "$bat_path/capacity_level"
read_value cycle_count "$bat_path/cycle_count"
read_value health "$bat_path/health"
read_value model "$bat_path/model_name"
read_value charge_behaviour "$bat_path/charge_behaviour"
read_value start_threshold "$bat_path/charge_control_start_threshold"
read_value end_threshold "$bat_path/charge_control_end_threshold"
read_number energy_now "$bat_path/energy_now"
read_number energy_full "$bat_path/energy_full"
read_number energy_design "$bat_path/energy_full_design"
read_number power_now "$bat_path/power_now"
read_number voltage_now "$bat_path/voltage_now"
read_number current_now "$bat_path/current_now"
read_number temp "$bat_path/temp"
read_number time_empty "$bat_path/time_to_empty_now"
read_number time_full "$bat_path/time_to_full_now"
read_value manufacture_year "$bat_path/manufacture_year"
read_value manufacture_month "$bat_path/manufacture_month"
read_value manufacture_day "$bat_path/manufacture_day"
read_value ac_online "$ac_path/online"
read_number input_power_limit "$ac_path/input_power_limit"

default_icons=("󰁺" "󰁻" "󰁼" "󰁽" "󰁾" "󰁿" "󰂀" "󰂁" "󰂂" "󰁹")
charging_icons=("󰢜" "󰂆" "󰂇" "󰂈" "󰢝" "󰂉" "󰢞" "󰂊" "󰂋" "󰂅")
index=$((capacity / 10))
[ "$index" -gt 9 ] && index=9

case "$status" in
  Charging) text="${charging_icons[$index]}" ;;
  Full) text="󰂅" ;;
  Not\ charging) text="" ;;
  *) text="${default_icons[$index]}" ;;
esac
battery_text="$text ${capacity}%"

# Charge-hold: AC present, a cap below 100, and the pack is no longer
# taking meaningful current (Not charging / Full-below-100 / trickle at cap).
holding=false
end_num="$end_threshold"
start_num="$start_threshold"
case "$end_num" in '' | n/a | *[!0-9]*) end_num="" ;; esac
case "$start_num" in '' | n/a | *[!0-9]*) start_num="" ;; esac
power_w="$(awk -v value="$power_now" 'BEGIN { print value / 1000000 }')"
if [ "$ac_online" = "1" ] && [ -n "$end_num" ] && [ "$end_num" -lt 99 ]; then
  charge_idle=false
  awk -v rate="$power_w" 'BEGIN { exit !(rate <= 0.2 && rate >= -0.2) }' && charge_idle=true
  case "$status" in
    "Not charging") holding=true ;;
    Full) [ "$capacity" -lt 99 ] && holding=true ;;
    Charging)
      if [ "$charge_idle" = true ] && [ "$capacity" -ge "$end_num" ]; then
        holding=true
      fi
      ;;
  esac
fi
display_status="$status"
[ "$holding" = true ] && display_status="Holding"

# Lock screen line: percent plus the charge state in words.
if [ "${1:-}" = "lock" ]; then
  printf '%s%% · %s\n' "$capacity" "$display_status"
  exit 0
fi

status_class="$(printf "%s" "$display_status" | tr '[:upper:] ' '[:lower:]-')"
classes_json="[\"$status_class\"]"
[ "$holding" = true ] && classes_json="[\"$status_class\",\"holding\"]"
[ "$capacity" -le 20 ] && classes_json="[\"$status_class\",\"warning\"]"
[ "$capacity" -le 10 ] && classes_json="[\"$status_class\",\"critical\"]"

if [ "$energy_design" -gt 0 ]; then
  health_percent="$(awk -v full="$energy_full" -v design="$energy_design" 'BEGIN { printf "%.0f%%", 100 * full / design }')"
else
  health_percent="n/a"
fi

if [ "$holding" = true ]; then
  if [ -n "$start_num" ] && [ -n "$end_num" ] && [ "$start_num" != "$end_num" ]; then
    time_line="Holding at ${start_num}-${end_num}%"
  else
    time_line="Holding at ${end_num}%"
  fi
  power_line="Power: $(format_w "$power_now")"
elif [ "$status" = "Charging" ]; then
  time_line="Time to full: $(format_time "$time_full")"
  power_line="Power: $(format_w "$power_now") ↑"
elif [ "$status" = "Discharging" ]; then
  time_line="Time to empty: $(format_time "$time_empty")"
  power_line="Power: $(format_w "$power_now") ↓"
else
  time_line="Time: n/a"
  power_line="Power: $(format_w "$power_now")"
fi

tooltip_format="Battery %s%% (%s)\n%s\n%s\nEnergy: %s / %s\n"
tooltip_format="${tooltip_format}Design: %s | Health: %s (%s)\nCycles: %s | Temp: %s\n"
tooltip_format="${tooltip_format}Voltage: %s | Current: %s\nCharge limits: %s-%s%% | Mode: %s\n"
tooltip_format="${tooltip_format}AC online: %s | Input limit: %s\nModel: %s | Mfg: %s-%s-%s"

tooltip="$(printf "$tooltip_format" \
  "$capacity" "$display_status" \
  "$power_line" "$time_line" \
  "$(format_wh "$energy_now")" "$(format_wh "$energy_full")" \
  "$(format_wh "$energy_design")" "$health_percent" "$health" \
  "$cycle_count" "$(format_c "$temp")" \
  "$(format_v "$voltage_now")" "$(format_a "$current_now")" \
  "$start_threshold" "$end_threshold" "$charge_behaviour" \
  "$([ "$ac_online" = "1" ] && echo Yes || echo No)" "$(format_w "$input_power_limit")" \
  "$model" "$manufacture_year" "$(format_date_part "$manufacture_month")" "$(format_date_part "$manufacture_day")")"

watts="$(awk -v value="$power_now" 'BEGIN { if (value < 0) value = -value; printf "%.1f", value / 1000000 }')"
threshold_end_json=null
threshold_start_json=null
[ -n "$end_num" ] && threshold_end_json="$end_num"
[ -n "$start_num" ] && threshold_start_json="$start_num"
holding_json=false
[ "$holding" = true ] && holding_json=true

jq -cn \
  --arg text "$battery_text" \
  --arg tooltip "$tooltip" \
  --argjson class "$classes_json" \
  --argjson percentage "$capacity" \
  --argjson holding "$holding_json" \
  --argjson threshold_end "$threshold_end_json" \
  --argjson threshold_start "$threshold_start_json" \
  --argjson watts "$watts" \
  --arg cycles "$cycle_count" \
  '{text: $text, tooltip: $tooltip, class: $class, percentage: $percentage, holding: $holding, threshold_end: $threshold_end, threshold_start: $threshold_start, watts: $watts, cycles: $cycles}'
