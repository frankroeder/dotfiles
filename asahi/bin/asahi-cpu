#!/usr/bin/env bash

set -euo pipefail

state_dir="${ASAHI_CPU_STATE_DIR:-${XDG_RUNTIME_DIR:-/tmp}/asahi-waybar}"
if ! mkdir -p "$state_dir" || [ ! -w "$state_dir" ]; then
  state_dir="/tmp/asahi-waybar-${UID:-$(id -u)}"
  mkdir -p "$state_dir"
fi

state_file="$state_dir/cpu.stat"
hwmon_root="${ASAHI_HWMON_ROOT:-/sys/class/hwmon}"
proc_stat="${ASAHI_PROC_STAT:-/proc/stat}"
proc_loadavg="${ASAHI_PROC_LOADAVG:-/proc/loadavg}"
cpufreq_root="${ASAHI_CPUFREQ_ROOT:-/sys/devices/system/cpu}"

read_temp_raw() {
  local path="$1"
  local value

  [ -r "$path" ] || return 1
  value="$(tr -d '\n' < "$path")"

  [[ "$value" =~ ^-?[0-9]+$ ]] || return 1

  printf "%s\n" "$value"
}

sensor_label() {
  local input="$1"
  local sensor="${input##*/}"
  local label

  sensor="${sensor%_input}"
  label="$(tr -d '\n' < "${input%_input}_label" 2>/dev/null || true)"
  printf "%s\n" "${label:-$sensor}"
}

best_temp_sensor() {
  local only_name="${1:-}"
  local best_raw=""
  local best_label=""
  local best_path=""
  local d name inp val label

  for d in "$hwmon_root"/hwmon{0..99}; do
    [ -d "$d" ] || continue
    name="$(cat "$d/name" 2>/dev/null || true)"
    [ -z "$only_name" ] || [ "$name" = "$only_name" ] || continue

    for inp in "$d"/temp*_input; do
      [ -r "$inp" ] || continue
      val="$(read_temp_raw "$inp" || true)"
      [ -n "$val" ] || continue

      if [ -z "$best_raw" ] || [ "$val" -gt "$best_raw" ]; then
        label="$(sensor_label "$inp")"
        best_raw="$val"
        best_label="${name:-unknown} / $label"
        best_path="$inp"
      fi
    done
  done

  [ -n "$best_raw" ] && printf "%s\t%s\t%s\n" "$best_raw" "$best_label" "$best_path"
}

thermal_sensor() {
  if [ -n "${ASAHI_CPU_TEMP_PATH:-}" ]; then
    local raw label

    raw="$(read_temp_raw "$ASAHI_CPU_TEMP_PATH")"
    label="${ASAHI_CPU_TEMP_LABEL:-$(sensor_label "$ASAHI_CPU_TEMP_PATH")}"
    printf "%s\t%s\t%s\n" "$raw" "$label" "$ASAHI_CPU_TEMP_PATH"
    return
  fi

  best_temp_sensor macsmc_hwmon && return
  best_temp_sensor
}

format_temp() {
  awk -v value="$1" -v decimals="$2" 'BEGIN { printf "%.*f", decimals, value / 1000 }'
}

class_for_temp() {
  local current="$1"
  local value="$2"

  if [ "$value" -ge 80000 ]; then
    printf "critical\n"
  elif [ "$value" -ge 65000 ] && [ "$current" = "normal" ]; then
    printf "warning\n"
  else
    printf "%s\n" "$current"
  fi
}

# Heatpipe watts (micro-W in sysfs): 15 W warning, 25 W critical — same
# thresholds as the dashboard, because this is the SoC dissipation proxy.
class_for_heatpipe() {
  local current="$1"
  local microwatts="$2"

  if [ "$microwatts" -ge 25000000 ]; then
    printf "critical\n"
  elif [ "$microwatts" -ge 15000000 ] && [ "$current" = "normal" ]; then
    printf "warning\n"
  else
    printf "%s\n" "$current"
  fi
}

heatpipe_sensor() {
  local d name inp label raw

  for d in "$hwmon_root"/hwmon{0..99}; do
    [ -d "$d" ] || continue
    name="$(cat "$d/name" 2>/dev/null || true)"
    [ "$name" = "macsmc_hwmon" ] || continue
    for inp in "$d"/power*_input; do
      [ -r "$inp" ] || continue
      label="$(sensor_label "$inp")"
      case "$label" in
        [Hh]eatpipe*)
          raw="$(read_temp_raw "$inp" || true)"
          [ -n "$raw" ] || return 1
          printf "%s\t%s\t%s\n" "$raw" "${name} / $label" "$inp"
          return 0
          ;;
      esac
    done
  done
  return 1
}

# Per-cpu jiffies: first line is the aggregate (`cpu`), then `cpuN`.
# Previous sample lives next to this file so the bar and a one-shot
# CLI invocation can share a delta.
cpu_usage="$(
  awk -v state="$state_file" '
    BEGIN {
      while ((getline line < state) > 0) {
        n = split(line, f, /[[:space:]]+/)
        if (n >= 3) { prev_total[f[1]] = f[2] + 0; prev_idle[f[1]] = f[3] + 0 }
        else if (n == 2) { prev_total["cpu"] = f[1] + 0; prev_idle["cpu"] = f[2] + 0 }
      }
      close(state)
    }
    $1 ~ /^cpu[0-9]*$/ {
      idle = $5 + $6
      total = $2 + $3 + $4 + $5 + $6 + $7 + $8 + $9
      label = $1
      labels[++count] = label
      cur_total[label] = total
      cur_idle[label] = idle
      dt = total - (label in prev_total ? prev_total[label] : 0)
      di = idle - (label in prev_idle ? prev_idle[label] : 0)
      if (dt > 0 && di >= 0) pct[label] = int(100 * (dt - di) / dt)
      else pct[label] = -1
    }
    END {
      for (i = 1; i <= count; i++) {
        label = labels[i]
        printf "%s %d %d\n", label, cur_total[label], cur_idle[label] > state
      }
      overall = (pct["cpu"] >= 0 ? pct["cpu"] : 0)
      printf "%d\n", overall
      ncores = 0
      for (i = 1; i <= count; i++) {
        label = labels[i]
        if (label == "cpu") continue
        ncores++
        printf "%s %d\n", toupper(label), (pct[label] >= 0 ? pct[label] : 0)
      }
      printf "CORES %d\n", ncores
    }
  ' "$proc_stat"
)"

percentage="$(printf '%s\n' "$cpu_usage" | awk 'NR==1 { print $1; exit }')"
core_count="$(printf '%s\n' "$cpu_usage" | awk '/^CORES / { print $2; exit }')"
cores_json="$(
  printf '%s\n' "$cpu_usage" | awk '
    /^CPU[0-9]+ / { printf "%s{\"name\":\"%s\",\"percent\":%s}", (n++ ? "," : ""), $1, $2 }
    END { print "" }
  '
)"
cores_json="[${cores_json}]"
[ -n "$percentage" ] || percentage=0
[ -n "$core_count" ] || core_count=0

class="normal"
[ "$percentage" -ge 60 ] && class="warning"
[ "$percentage" -ge 80 ] && class="critical"

read -r load1 load5 load15 _ < "$proc_loadavg"
cores="${core_count}"
if [ "$cores" -eq 0 ]; then
  cores="$(getconf _NPROCESSORS_ONLN 2>/dev/null || awk '/^processor/ { count++ } END { print count + 0 }' /proc/cpuinfo)"
fi

freq_paths=()
for path in "$cpufreq_root"/cpu*/cpufreq/scaling_cur_freq; do
  [ -r "$path" ] || continue
  freq_paths+=("$path")
done

if [ "${#freq_paths[@]}" -gt 0 ]; then
  freq_line="$(
    awk '
      BEGIN { min = -1 }
      {
        value = $1
        sum += value
        if (value > max) max = value
        if (min < 0 || value < min) min = value
        count++
      }
      END {
        printf "Freq avg %.2f GHz, min %.2f, max %.2f", sum / count / 1000000, min / 1000000, max / 1000000
      }
    ' "${freq_paths[@]}"
  )"
else
  freq_line="Freq n/a"
fi

thermal="$(thermal_sensor || true)"
temp_raw=""
temp_label=""
temp_path=""

if [ -n "$thermal" ]; then
  IFS=$'\t' read -r temp_raw temp_label temp_path <<< "$thermal"
fi

heatpipe="$(heatpipe_sensor || true)"
heatpipe_raw=""
heatpipe_label=""
heatpipe_path=""
heatpipe_w=""

if [ -n "$heatpipe" ]; then
  IFS=$'\t' read -r heatpipe_raw heatpipe_label heatpipe_path <<< "$heatpipe"
  heatpipe_w="$(awk -v value="$heatpipe_raw" 'BEGIN { printf "%.1f", value / 1000000 }')"
fi

# Bar text stays CPU % only. The hottest exposed °C is a peripheral (Wi-Fi,
# charge regulator) — not a die sensor — so it must not look like "CPU temp".
if [ -n "$temp_raw" ]; then
  temp_line="Thermal $(format_temp "$temp_raw" 1) C (${temp_label})"
  temp_path_line="Sensor: $temp_path"
  class="$(class_for_temp "$class" "$temp_raw")"
else
  temp_line="Thermal n/a"
  temp_path_line="Sensor: n/a"
fi

if [ -n "$heatpipe_w" ]; then
  heatpipe_line="Heatpipe ${heatpipe_w} W (SoC dissipation; no die sensor)"
  class="$(class_for_heatpipe "$class" "$heatpipe_raw")"
else
  heatpipe_line="Heatpipe n/a"
fi

tooltip="$(printf "CPU %d%%\nLoad 1/5/15: %s %s %s\nCores: %s\n%s\n%s\n%s\n%s" \
  "$percentage" "$load1" "$load5" "$load15" "$cores" "$freq_line" "$temp_line" "$heatpipe_line" "$temp_path_line")"

temp_c="null"
if [ -n "$temp_raw" ]; then
  temp_c="$(format_temp "$temp_raw" 1)"
fi
heatpipe_json="null"
if [ -n "$heatpipe_w" ]; then
  heatpipe_json="$heatpipe_w"
fi

jq -cn \
  --arg text "CPU $percentage%" \
  --arg tooltip "$tooltip" \
  --arg class "$class" \
  --argjson percentage "$percentage" \
  --argjson cores "$cores_json" \
  --argjson temp_c "$temp_c" \
  --argjson heatpipe_w "$heatpipe_json" \
  '{text: $text, tooltip: $tooltip, class: $class, percentage: $percentage, cores: $cores, temp_c: $temp_c, heatpipe_w: $heatpipe_w}'
