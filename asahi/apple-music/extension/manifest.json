{
  "manifest_version": 3,
  "name": "Asahi Apple Music",
  "version": "2",
  "description": "Hands Chromium MusicKit's per-track clock (MPRIS length / position / seek per track) and the shell synced lyrics.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://music.apple.com/*"], "js": ["clock.js", "lyrics.js"], "world": "MAIN", "run_at": "document_idle" },
    { "matches": ["https://music.apple.com/*"], "js": ["relay.js"], "run_at": "document_idle" }
  ]
}
