font-size = 12
font-family = "Cascadia Mono NF"

# Window Configuration
window-decoration = false
window-padding-x = 12
window-padding-y = 12
background-opacity = 0.9

# Cursor Configuration
# cursor-style = block

# Scrollback in bytes
scrollback-limit = 104857600

# Terminal features
mouse-hide-while-typing = true
clipboard-trim-trailing-spaces = true
confirm-close-surface = false

working-directory = inherit
window-inherit-working-directory = true

window-save-state = always

# Disable annoying copied to clipboard
# app-notifications = no-clipboard-copy,no-config-reload

# Rando stuff
# gtk-titlebar = false
# gtk-single-instance = true

# Shell integration
shell-integration = zsh
shell-integration-features = cursor,sudo,title,no-cursor
keybind = shift+enter=text:\n
keybind = super+alt+enter=toggle_quick_terminal
# Hyprland Super+Shift+F owns fullscreen.
keybind = ctrl+enter=unbind

theme = asahi-adaptive
# adaptive.conf (asahi-autotheme) sets window-theme=ghostty, titlebar colors,
# and gtk-custom-css so tabs + command palette recolor on reload-config.
# Do not kill Ghostty — Adw StyleManager does not follow light/dark on reload
# (ghostty#13127); custom CSS is the live path on Hyprland.
window-theme = ghostty
config-file = ?adaptive.conf

# Fallback if asahi-adaptive theme file is missing (first boot before wallpaper theming):
# theme = Catppuccin Mocha

# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll
