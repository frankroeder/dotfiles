#!/usr/bin/env bash

NUM_SPACES=$(yabai -m query --spaces 2>/dev/null | jq '. | length')

# general exceptions
yabai -m rule --add app='^System Information$' manage=off sub-layer=above
yabai -m rule --add app='^System (Preferences|Settings)$' manage=off sub-layer=above
yabai -m rule --add title='Preferences$' manage=off sub-layer=above
yabai -m rule --add title='Settings$' manage=off sub-layer=above
yabai -m rule --add title='^Updating' manage=off sub-layer=above
yabai -m rule --add title='^Copy' manage=off sub-layer=above
yabai -m rule --add app='Zotero' title='Find Full Text' manage=off sub-layer=above

yabai -m rule --add title='(Picture in Picture|Picture-in-Picture)' manage=off
yabai -m rule --add app="^Orion( RC)?$" title="^(General|Appearance|Browsing|Sync|(Password|Website|Extension)s|Privacy|Advanced|Completions)$" manage=off
yabai -m rule --add app="^LibreWolf$" title="^(Settings|Preferences|General|Privacy|Advanced|Sync|Appearance|About).*" manage=off

FLOAT_APPS="^(Dictionary|Podcasts|App Store|Calendar|Photos|Stickies|Vicinae|LuLu|Python|Archive Utility|Calculator)"
yabai -m rule --add app="${FLOAT_APPS}" manage=off sub-layer=auto

CENTER_APPS="^(Anki|Bitwarden)$"
yabai -m rule --add app="${CENTER_APPS}" manage=off grid=16:9:2:2:5:12

if [[ -n "$NUM_SPACES" ]] && [[ "$NUM_SPACES" =~ ^[0-9]+$ ]]; then
  for ((i=NUM_SPACES; i<3; i++)); do
    yabai -m space --create
  done
  NUM_SPACES=$(yabai -m query --spaces 2>/dev/null | jq '. | length')
fi

if [[ "$NUM_SPACES" =~ ^[0-9]+$ ]] && [[ $NUM_SPACES -gt 2 ]]; then
  # "social" apps should always be inside the last space
  yabai -m rule --add app="^(Messages|Discord|Signal|Telegram|Mattermost|Zoom)$" space=$NUM_SPACES
fi

# yabai -m rule --add app="^Notes$" scratchpad=notes grid=11:11:1:1:9:9
yabai -m rule --add app="^Music$" scratchpad=music grid=1:1:0:0:1:1
yabai -m rule --add app="^Proton Pass$" scratchpad=pw grid=11:11:1:1:9:9


yabai -m rule --add app="^(Mail|Proton Mail)$" space=1
yabai -m rule --add app="^Ghostty$" space=2
yabai -m rule --add app="^(Claude|Grok)$" space=3
yabai -m rule --add app=".*" sub-layer=normal

# Make all non-resizeable windows float (#1317). label= is required: --add is
# append-only, so unlabelled signals stack a duplicate on every yabairc re-source.
yabai -m signal --add label=float_non_resizable event=window_created \
  action='yabai -m query --windows --window $YABAI_WINDOW_ID | jq -er ".\"can-resize\" or .\"is-floating\"" || yabai -m window $YABAI_WINDOW_ID --toggle float'

# Native tabs (Ghostty/Finder) create then destroy a real window. Re-tile + keep
# focus without space next/prev thrash (see check_config.sh + yabai/native_tab.sh).
# nohup+bg: in-signal yabai self-calls can deadlock; bare & dies on action-shell exit.
NATIVE_TAB="${DOTFILES:-$HOME/.dotfiles}/yabai/native_tab.sh"
yabai -m signal --add label=native_tab_created app='^(Ghostty|Finder)$' event=window_created \
  action="nohup /bin/bash '$NATIVE_TAB' created >/dev/null 2>&1 &"
yabai -m signal --add label=native_tab_destroyed app='^(Ghostty|Finder)$' event=window_destroyed \
  action="nohup /bin/bash '$NATIVE_TAB' destroyed >/dev/null 2>&1 &"

# This focuses the previous window if a window is not currently focused, such as when a floating window is minimized
# https://github.com/koekeishiya/yabai/issues/1212#issuecomment-1107854658
# yabai -m signal --add label=focus_after_minimize event=window_minimized active=yes action="if \$(yabai -m query --windows --window \$YABAI_WINDOW_ID | jq -r '.\"is-floating\"'); then yabai -m query --windows --window &> /dev/null || yabai -m window --focus mouse &> /dev/null || yabai -m window --focus \$(yabai -m query --windows --space | jq .[0].id) &> /dev/null; fi"
