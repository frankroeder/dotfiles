#!/usr/bin/env zsh
# login shell definitions

if [ "$OSTYPE" = "Darwin" ]; then

  if [[ $ARCHITECTURE == 'arm64' ]]; then
    alias abrew='/opt/homebrew/bin/brew'
    eval $(/opt/homebrew/bin/brew shellenv)
  else
    eval $(/usr/local/bin/brew shellenv)
  fi
  # llvm
  path=("$HOMEBREW_PREFIX/opt/llvm/bin" $path)
  export LDFLAGS="-L$HOMEBREW_PREFIX/opt/llvm/lib $LDFLAGS"
  export CPPFLAGS="-I$HOMEBREW_PREFIX/opt/llvm/include $CPPFLAGS"

  # for compilers to find openssl
  path=("$HOMEBREW_PREFIX/opt/openssl/bin" $path)
  export LDFLAGS="-L$HOMEBREW_PREFIX/opt/openssl/lib $LDFLAGS"
  export CPPFLAGS="-I$HOMEBREW_PREFIX/opt/openssl/include $CPPFLAGS"

  # ruby + gem
  if [ -d "$HOME/.gem/ruby" ]; then
    path=("$HOME/.gem/ruby/"*/bin(N[-1]) $path)
  fi

  # go
  export GOPATH="$HOME/Documents/golang"
  export GOROOT="$HOMEBREW_PREFIX/opt/go/libexec"
  path=(
    $GOPATH/bin
    $GOROOT/bin
    $path
  )
fi

if [ "$(tty)" = "/dev/tty1" ]; then
  # Start a live empty agent so the first git/ssh can AddKeysToAgent.
  # Do not prompt for the key passphrase here — getty is only the login gate.
  if [ -x "${DOTFILES:-$HOME/.dotfiles}/asahi/bin/asahi-ssh-keychain" ]; then
    "${DOTFILES:-$HOME/.dotfiles}/asahi/bin/asahi-ssh-keychain" || true
    _kc="$HOME/.keychain/${HOST:-$HOSTNAME}-sh"
    [[ -r $_kc ]] && source "$_kc"
    unset _kc
  fi
  if (( ${+commands[start-hyprland]} )); then
    # Asahi: with an external display attached, apple-drm can bind after a fast login
    # (~30 s seen on an M2 Pro) and Hyprland would open simpledrm (omarchy-mac #679).
    if grep -qa 'apple,' /proc/device-tree/compatible 2>/dev/null; then
      udevadm wait --timeout=30 /dev/dri/by-path/platform-soc:display-subsystem-card 2>/dev/null
    fi
    # Lmod (openmpi) exports BASH_ENV: every bash the session forks sources it (13 ms vs 1.2 ms).
    # Terminals re-source /etc/profile, so `module` still works there.
    unset BASH_ENV
    exec start-hyprland
  fi
fi
