(
  set -euo pipefail
  sid=$(uuidgen | tr '[:upper:]' '[:lower:]')
  cleanup() { grok sessions delete "$sid" >/dev/null 2>&1 || true }
  trap cleanup EXIT
  msg_file="${HOME}/.dotfiles/git/gitmessage"
  template=
  [[ -f $msg_file && -r $msg_file ]] && template=$(<$msg_file)
  GROK_MEMORY=0 grok --session-id "$sid" \
    --disable-web-search --no-subagents --verbatim \
    --no-plan --effort low \
    --single "Output a commit msg for the current changes, following the conventional commit format
---
${template}
Be very concise and to the point."
)
