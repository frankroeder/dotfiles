#!/usr/bin/env zsh

# zsh defaults whatever the interactive shell set (KSH_ARRAYS or SH_WORD_SPLIT broke the summary).
emulate -L zsh

# Bright ANSI colours: the terminal theme (Ghostty palette, Asahi autotheme) picks the actual hues.
# None when stdout is no terminal (`update | tee log`).
typeset RED= GREEN= YELLOW= BLUE= MAGENTA= CYAN= GRAY= BOLD= DIM= REV= RESET=
if [[ -t 1 ]]; then
  RED=$'\e[91m' GREEN=$'\e[92m' YELLOW=$'\e[93m' BLUE=$'\e[94m' MAGENTA=$'\e[95m' CYAN=$'\e[96m'
  GRAY=$'\e[90m' BOLD=$'\e[1m' DIM=$'\e[2m' REV=$'\e[7m' RESET=$'\e[0m'
fi
typeset ICON_OK=$'\uf00c' ICON_FAIL=$'\uf00d' ICON_WARN=$'\uf071' ICON_UPDATE=$'\U000f06b0'

# Routine -> "icon name". Nerd Font glyphs (Cascadia Mono NF; Ghostty also bundles them).
typeset -A ROUTINE_LABEL=(
  neovim_plug_update $'\uf36f Neovim plugins'
  zsh_update         $'\uf489 Zim'
  npm_update         $'\ue71e npm globals'
  mas_update         $'\uf179 App Store'
  brew_update        $'\uf0fc Homebrew'
  gem_update         $'\ue739 RubyGems'
  misc               $'\uf0ad Misc tools'
  macos_update       $'\uf179 macOS'
  apt_update         $'\uf306 apt'
  dnf_update         $'\uf30a dnf'
  flatpak_update     $'\uf487 Flatpak'
  grok_bot_update    $'\U000f06a9 Grok Bot'
)

error() {
  print -r -- "${RED}${BOLD}${ICON_FAIL}${RESET} $*"
}

upd_secs() {
  if (( $1 >= 60 )); then print -r -- "$(( $1 / 60 ))m $(( $1 % 60 ))s"; else print -r -- "${1}s"; fi
}

# --- what changed: "name<TAB>version" per package, taken before and after a routine -------------

snap_neovim_plug_update() {
  awk -F'"' '/^ +"[^"]+": \{/ && $2 != "plugins" { name = $2 } /"rev":/ { print name "\t" substr($4, 1, 7) }' \
    "${XDG_CONFIG_HOME:-$HOME/.config}/nvim/nvim-pack-lock.json"
  [ -x "$HOME/.fzf/bin/fzf" ] && print -r -- "fzf"$'\t'"${$("$HOME/.fzf/bin/fzf" --version)[(w)1]}"
}
snap_npm_update() {
  npm ls -g --depth=0 --parseable --long |
    awk -F: 'NR > 1 && match($2, /@[^@]+$/) { print substr($2, 1, RSTART - 1) "\t" substr($2, RSTART + 1) }'
}
snap_gem_update() { gem list --local | awk '{ name = $1; $1 = ""; gsub(/^ \(|\)$/, ""); print name "\t" $0 }' }
snap_brew_update() { brew list --versions | awk '{ name = $1; $1 = ""; print name "\t" substr($0, 2) }' }
snap_mas_update() { mas list | awk '{ v = $NF; gsub(/[()]/, "", v); $1 = ""; $NF = ""; gsub(/^ +| +$/, ""); print $0 "\t" v }' }
snap_misc() {
  [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/uv/uv-receipt.json" ] && print -r -- "uv"$'\t'"${$(uv --version)[(w)2]}"
}
snap_apt_update() { dpkg-query -W -f='${Package}\t${Version}\n' }
snap_dnf_update() { rpm -qa --qf '%{NAME}\t%{VERSION}-%{RELEASE}\n' }
snap_flatpak_update() {
  flatpak list --columns=application,branch,version,active |
    awk -F'\t' '{ print ($2 == "stable" ? $1 : $1 "/" $2) "\t" ($3 != "" ? $3 : substr($4, 1, 7)) }'
}
snap_grok_bot_update() { print -r -- "grok-bot"$'\t'"$(<"${XDG_DATA_HOME:-$HOME/.local/share}/grok-bot/version")" }

# "~ name old new" / "+ name version" / "- name version" (TAB-separated) between two snapshots.
# Snapshots are `sort -V`ed: for a name installed in several versions (kernels) the newest wins.
upd_diff() {
  awk -F'\t' 'NF == 0 { next } FILENAME == ARGV[1] { old[$1] = $2; next } { new[$1] = $2 }
    END {
      for (k in new) if (!(k in old)) print "+\t" k "\t" new[k]; else if (old[k] != new[k]) print "~\t" k "\t" old[k] "\t" new[k]
      for (k in old) if (!(k in new)) print "-\t" k "\t" old[k]
    }' <(print -r -- "$1") <(print -r -- "$2") | sort -t$'\t' -k2,2
}

# --- layout -------------------------------------------------------------------------------------

upd_rule() {  # $1 = columns of the line already used
  local n=$(( width - $1 ))
  (( n < 0 )) && n=0
  print -rn -- "${GRAY}${(l:n::─:)}${RESET}"
}

# One routine: header, its own output, footer. Records time, status and what changed for the summary.
exec_routine() {
  local routine=$1 start=$SECONDS failed=0 routine_note="" before after line secs what
  local -a f up added gone counts
  local accent=${accents[$(( step % ${#accents} + 1 ))]}
  (( ++step ))
  local title="${step}/${#routines}  ${ROUTINE_LABEL[$routine]:-$routine}"
  print -r -- ""
  print -r -- "${accent}╭─ ${BOLD}${title}${RESET} $(upd_rule $(( ${#title} + 5 )))"

  if (( $+functions[snap_$routine] )); then before=$(snap_$routine 2>/dev/null | sort -V); fi

  # A routine's status is only its last command's (gem_update showed ✓ after two gem errors):
  # the ZERR trap counts every failed step; `|| true` opts a step out. (Trap stays local: emulate -L.)
  trap 'failed=1' ZERR
  $routine
  trap - ZERR

  if (( $+functions[snap_$routine] )); then after=$(snap_$routine 2>/dev/null | sort -V); fi
  # Listing failed afterwards (e.g. a broken npm): no change list, rather than everything "removed".
  if [[ -n $before && -z $after ]]; then after=$before routine_note="package list unavailable after the run"; fi
  for line in ${(f)"$(upd_diff "$before" "$after")"}; do
    f=("${(@ps:\t:)line}")
    case $f[1] in
      '~') up+=("${(pj:\t:)f[2,4]}") ;;
      '+') added+=("${(pj:\t:)f[2,3]}") ;;
      '-') gone+=("${(pj:\t:)f[2,3]}") ;;
    esac
  done
  (( ${#up} )) && counts+=("${CYAN}${#up} updated${RESET}")
  (( ${#added} )) && counts+=("${GREEN}${#added} new${RESET}")
  (( ${#gone} )) && counts+=("${RED}${#gone} removed${RESET}")
  what=${(j: · :)counts}
  [[ -z $what ]] && what="${DIM}${routine_note:-no changes}${RESET}"

  secs=$(upd_secs $(( SECONDS - start )))
  if (( failed )); then
    failed_routines+=("$routine")
    print -r -- "${accent}╰─${RESET} ${RED}${BOLD}${ICON_FAIL} failed${RESET} ${DIM}after ${secs}${RESET} · ${what}"
  else
    print -r -- "${accent}╰─${RESET} ${GREEN}${BOLD}${ICON_OK}${RESET} ${DIM}${secs}${RESET} · ${what}"
  fi
  r_secs[$routine]=$secs r_what[$routine]=$what r_up[$routine]=${(F)up} r_added[$routine]=${(F)added} r_gone[$routine]=${(F)gone}
}

# Changed items under a summary row: up to 6 one per line with versions, else one line of names.
upd_items() {  # color, sign, newline-joined "name<TAB>version[<TAB>new version]" items
  local color=$1 sign=$2 line name text n=1 pad="${GRAY}│${RESET}     "
  local -a items=(${(f)3}) f names
  (( ${#items} )) || return 0
  if (( ${#items} <= 6 )); then
    for line in $items; do
      f=("${(@ps:\t:)line}")
      printf -v name '%-26s' "$f[1]"
      if (( ${#f} == 3 )); then
        print -r -- "${pad}${color}${sign}${RESET} ${name} ${DIM}${f[2]} →${RESET} ${f[3]}"
      else
        print -r -- "${pad}${color}${sign}${RESET} ${name} ${DIM}${f[2]}${RESET}"
      fi
    done
    return 0
  fi
  names=(${items%%$'\t'*})
  text=$names[1]
  while (( n < ${#names} && ${#text} + ${#names[n+1]} + 2 <= width - 20 )); do text+=", ${names[++n]}"; done
  (( n < ${#names} )) && text+=" … +$(( ${#names} - n )) more"
  print -r -- "${pad}${color}${sign}${RESET} ${DIM}${text}${RESET}"
}

upd_summary() {
  local total=$(upd_secs $(( SECONDS - run_start ))) r icon label secs title line
  local -a failed_labels
  title="${ICON_UPDATE} Summary · ${total}"
  print -r -- ""
  print -r -- "${BOLD}${BLUE}╭─ ${title}${RESET} $(upd_rule $(( ${#title} + 5 )))"
  for r in $routines; do
    (( ${+r_secs[$r]} )) || continue
    if (( ${failed_routines[(Ie)$r]} )); then icon="${RED}${ICON_FAIL}"; else icon="${GREEN}${ICON_OK}"; fi
    printf -v label '%-18s' "${ROUTINE_LABEL[$r]:-$r}"
    printf -v secs '%7s' "${r_secs[$r]}"
    print -r -- "${GRAY}│${RESET} ${BOLD}${icon}${RESET} ${BOLD}${label}${RESET}${DIM}${secs}${RESET}   ${r_what[$r]}"
    upd_items "$CYAN" "↑" "${r_up[$r]}"
    upd_items "$GREEN" "+" "${r_added[$r]}"
    upd_items "$RED" "−" "${r_gone[$r]}"
  done
  for line in $notes; do
    print -r -- "${GRAY}│${RESET} ${YELLOW}${BOLD}${ICON_WARN} ${line}${RESET}"
  done
  if (( ${#failed_routines} )); then
    for r in $failed_routines; do failed_labels+=("${ROUTINE_LABEL[$r]#* }"); done
    print -r -- "${GRAY}╰─${RESET} ${RED}${BOLD}${ICON_FAIL} ${#failed_routines} failed: ${(j:, :)failed_labels}${RESET}"
  elif (( ${#r_secs} < ${#routines} )); then
    print -r -- "${GRAY}╰─${RESET} ${YELLOW}${BOLD}${ICON_WARN} Stopped after ${#r_secs} of ${#routines}${RESET} ${DIM}in ${total}${RESET}"
  else
    print -r -- "${GRAY}╰─${RESET} ${GREEN}${BOLD}${ICON_OK} All ${#routines} done${RESET} ${DIM}in ${total}${RESET}"
  fi
}

brew_update() {
  brew update;
  brew upgrade --display-times;
  brew outdated --cask;
  brew upgrade --cask;
  brew autoremove;
  brew cleanup -s --prune 7;
}

zsh_update() {
  zimfw update;
  zimfw upgrade;
  zimfw clean;
}

npm_update() {
  if [[ "$OSTYPE" = "Linux" ]]; then
    # Force user-writable prefix on Linux. System npm (or unconfigured local node)
    # defaults to /usr/local which is not writable → EACCES on mkdir node_modules.
    local pfx="$HOME/.local"
    mkdir -p "$pfx/bin" "$pfx/lib/node_modules"
    npm config set prefix "$pfx" --location=user 2>/dev/null || true
  fi
  # Global = the prefix above. A bare `--prefix ~/.local` made ~/.local an npm project
  # (package.json, node_modules/npm) and never updated the global packages.
  npm install npm@latest --location=global --no-fund --no-audit
  npm update --location=global --no-fund --no-audit
}

gem_update() {
  local prefix
  prefix="$(ruby -e 'print RbConfig::CONFIG["prefix"]')"

  # Homebrew ships RubyGems. `gem update --system` writes gem/bundle into the
  # versioned Cellar keg and regenerates rdoc_plugin.rb with absolute keg paths.
  # `brew upgrade ruby` then LoadErrors the plugin (missing rdoc under the old
  # keg) and leftover root-owned files block `brew cleanup`.
  if [[ "$prefix" == */Cellar/ruby* ]]; then
    gem update --no-document
    gem cleanup
    return
  fi

  # Distro ruby (Fedora, Debian): dnf / apt own its gems. `sudo gem update` only put newer copies of the default
  # gems into /usr/local; Fedora's rdoc 7 and that rdoc 8 then both loaded (14 warnings per gem call, ri crash).
  if [[ "$prefix" = /usr ]]; then
    routine_note="skipped: distro ruby, the package manager updates it"
    return
  fi

  # --no-document: no ri / rdoc build per gem (4 "documentation" lines each).
  if [[ -w "$prefix" ]]; then
    gem update --system --no-document
    gem update --no-document
    gem cleanup
  else
    sudo gem update --system --no-document
    sudo gem update --no-document
    sudo gem cleanup
  fi
}

macos_update() {
  sudo softwareupdate -i -a --restart;
}

neovim_plug_update() {
  # Check if the directory exists
  if [[ -d "$HOME/.fzf/" ]]; then
    (cd $HOME/.fzf && git pull --quiet && ./install --bin)
  fi
  nvim --headless "+lua vim.pack.update(nil, { force = true })" "+qa"
  nvim --headless foo "+MasonUpdate" "+qa";
  print  # headless nvim ends without a newline: keeps the routine footer off its last line
}

mas_update() {
  mas outdated;
  mas upgrade;
}

apt_update() {
  sudo apt update --yes;
  sudo apt upgrade --yes;
}

# -q: drops repo loading + per-package download / progress lines (~700 per big update); tables and errors stay.
dnf_update() {
  sudo dnf upgrade --refresh -y -q;
  sudo dnf autoremove -y -q;
  sudo dnf clean all -q;
  # Aurora: newest kernel has image + initramfs and Stage 2 is built from its DTBs (exit 1 = boot chain problem);
  # also says if a restart is due (repeated in the summary). Same check as asahi-pkg tui-upgrade.
  if [ $commands[asahi-boot-check] ]; then
    local boot
    boot=$(asahi-boot-check)
    print -r -- "$boot"
    if [[ $boot == "Restart needed"* ]]; then notes+=("$boot"); fi
  fi
}

flatpak_update() {
  flatpak update -y;
  flatpak uninstall --unused -y;
}

# Grok Bot cannot update itself on Linux (extracted AppImage); grokbot.sh fetches the latest.
grok_bot_update() {
  bash "$DOTFILES/asahi/grokbot.sh";
}

misc() {
  if [ $commands[battery] ]; then
    battery update;
  fi
  # Standalone installer only (comp_python on non-dnf Linux); dnf / brew uv update with their package manager.
  if [ $commands[uv] ] && [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/uv/uv-receipt.json" ]; then
    uv self update;
  fi
  # if [ $commands[sketchybar] ]; then
  #   bash $DOTFILES/scripts/sketchybar_app_font.sh;
  # fi
}

run(){
  if ping -c 1 google.com &> /dev/null; then
    local -a routines failed_routines notes accents=("$BLUE" "$MAGENTA" "$CYAN")
    local -A r_secs r_what r_up r_added r_gone
    local step=0 run_start=$SECONDS r os width=$(( ${COLUMNS:-80} > 101 ? 100 : ${COLUMNS:-80} - 1 ))
    (( width < 40 )) && width=40

    [ $commands[nvim] ] && routines+=(neovim_plug_update)
    [ $commands[zimfw] ] && routines+=(zsh_update)
    [ $commands[npm] ] && routines+=(npm_update)
    [ $commands[mas] ] && routines+=(mas_update)
    [ $commands[brew] ] && routines+=(brew_update)
    # After brew: native gems compile against the new keg, not a just-replaced one.
    [ $commands[gem] ] && routines+=(gem_update)
    routines+=(misc)
    [ "$OSTYPE" = "Darwin" ] && routines+=(macos_update)
    [ $commands[apt] ] && routines+=(apt_update)
    [ $commands[dnf] ] && routines+=(dnf_update)
    [ $commands[flatpak] ] && routines+=(flatpak_update)
    [ "$OSTYPE" = "Linux" ] && [ $commands[grok-bot] ] && routines+=(grok_bot_update)

    if [[ "$OSTYPE" = "Darwin" ]]; then os="macOS $(sw_vers -productVersion)"; else os=$(. /etc/os-release && print -r -- "$NAME $VERSION_ID"); fi
    print -r -- ""
    # Pill = reverse video: text in the terminal background colour, readable in light and dark themes.
    print -r -- "${BOLD}${BLUE}${REV} ${ICON_UPDATE} update ${RESET}  ${BOLD}$(date '+%a %d %b, %H:%M')${RESET} ${DIM}· ${HOST%%.*} · ${os} · $(uname -m)${RESET}"
    local -a labels
    for r in $routines; do labels+=("${ROUTINE_LABEL[$r]#* }"); done
    print -r -- "${DIM}${#routines} routines: ${(j: · :)labels}${RESET}"

    sudo -v
    # Keep-alive: refresh the sudo timestamp until the run ends. `update` runs in the interactive shell, so the
    # old `kill -0 $$` never ended the loop (it outlived the run). Killed by the `always` block (also on Ctrl-C,
    # which skips a function EXIT trap); 2 h cap if the shell dies first (disowned: no SIGHUP, no "[4] 104564" line).
    for i in {1..120}; do sudo -n true; sleep 60; done 2>/dev/null &!
    local keepalive=$!

    {
      for r in $routines; do exec_routine $r; done
    } always {
      kill $keepalive 2>/dev/null
      upd_summary  # also after Ctrl-C: what finished until then
      # Asahi bar: re-check now, not at the next 30 min tick (no-op without the shell).
      (( $+commands[qs] )) && qs -c remix ipc --any-display call updates refresh >/dev/null 2>&1
    }
  else
    error "No internet access"
  fi
}
run;
