#!/usr/bin/env bash

# @vicinae.title Copy Last Screenshot
# @vicinae.author Frank Röder
# @vicinae.authorURL https://github.com/frankroeder
# @vicinae.mode silent
# @vicinae.packageName System
# @vicinae.icon 📸
# @vicinae.description Copies the last screenshot to the clipboard.
# @vicinae.schemaVersion 1

DIR=$(defaults read com.apple.screencapture location)
FILE=$(ls -t "$DIR" | head -n 1)
FILELOC="$DIR/$FILE"

osascript -e "set the clipboard to (read (POSIX file \"$FILELOC\") as JPEG picture)"
