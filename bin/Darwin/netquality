#!/bin/bash

# Required parameters:
# @vicinae.schemaVersion 1
# @vicinae.title Network Quality
# @vicinae.mode inline
# @vicinae.refreshTime 20m

# Optional parameters:
# @vicinae.icon 🌐

# Documentation:
# @vicinae.packageName System
# @vicinae.author Archie Lacoin
# @vicinae.authorURL https://github.com/pomdtr
# @vicinae.author LanikSJ
# @vicinae.authorURL https://github.com/LanikSJ

result=$(networkQuality -v)

rtt=$(echo "$result" | grep "Idle Latency" | awk '{print $3}')
mbps_down=$(echo "$result" | grep "Downlink capacity" | awk '{print $3 tolower($4)}')
mbps_up=$(echo "$result" | grep "Uplink capacity" | awk '{print $3 tolower($4)}')

echo "↓ ${mbps_down}  ↑ ${mbps_up}  ↔ ${rtt} ms"
